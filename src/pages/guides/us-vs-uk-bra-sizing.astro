---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Why do US and UK bra sizes match up to D cup but differ afterwards?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Both US and UK sizing systems start at A cup (1-inch difference) and proceed sequentially through B, C, and D. However, above a 4-inch bust-to-underbust difference (D cup), UK manufacturers standardize on double-letter steps (DD, E, F, FF, G, GG, H, HH, J, JJ, K), whereas US brands use variable naming conventions like DDD/E, G, H, I, J or multi-D notation (DD, DDD, DDDD)."
      }
    },
    {
      "@type": "Question",
      "name": "Is a UK E cup the same as a US DDD cup?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, a UK E cup represents a 6-inch difference between bust and underbust, which corresponds directly to a US DDD (or US F) cup. Both sizes accommodate the exact same bust volume."
      }
    },
    {
      "@type": "Question",
      "name": "Do US and UK band sizes use the same numbers?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Both American (US) and British (UK) sizing systems measure band size in inches (30, 32, 34, 36, 38, 40, etc.). The numbers mean the exact same underbust measurement in both regions."
      }
    }
  ]
};
---

<Layout 
  title="US vs UK Bra Sizes: Complete Conversion & Brand Differences | BraSizeChecker"
  description="Master US vs UK bra size conversions with our expert guide. Comprehensive cup progression charts, brand-by-brand comparison matrix (Panache, Freya, Natori, Wacoal), and E-E-A-T fitting rules."
  canonical="https://brasizechecker.com/guides/us-vs-uk-bra-sizing"
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <Header />
  <main class="flex-1 w-full max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 md:py-16">
    <Breadcrumbs items={[
      { label: 'Guides', url: '/#guides' },
      { label: 'US vs UK Bra Sizing' }
    ]} />

    <header class="mb-10 text-center sm:text-left">
      <span class="inline-block py-1 px-3 rounded-full bg-canvas-soft-2 border border-hairline text-xs font-semibold uppercase tracking-widest text-primary mb-3">
        Definitive Sizing Guide
      </span>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-ink tracking-tight mb-4">
        US vs UK Bra Sizes: Differences, Conversion Charts & Brand Guide
      </h1>
      <div class="flex items-center gap-3 text-xs text-mute mb-4">
        <span>By BraSizeChecker Certified Fitting Team</span>
        <span>&bull;</span>
        <time datetime="2026-09-04">Updated September 2026</time>
      </div>
      <p class="text-base sm:text-lg text-body leading-relaxed max-w-3xl">
        Navigating international lingerie sizing can be remarkably frustrating. While US and UK band sizes use identical inch increments, cup lettering diverges sharply past a D cup. This guide breaks down exact mathematical conversions, brand-specific sizing quirks, and practical steps to ensure a flawless fit.
      </p>
    </header>

    <div class="space-y-10 text-body leading-relaxed text-sm sm:text-base">
      <!-- Section 1: Core Divergence Explanation -->
      <section class="bg-surface border border-hairline rounded-2xl p-6 sm:p-8">
        <h2 class="text-xl sm:text-2xl font-bold text-ink mb-4">1. Why US and UK Cup Progressions Diverge</h2>
        <p class="mb-4">
          Both American (US) and British (UK) sizing systems calculate cup size using the difference between your overbust (fullest part of bust) and underbust (snug ribcage) measurements in inches. Each additional inch of difference represents one additional cup volume step:
        </p>
        <ul class="list-disc pl-5 space-y-2 mb-6">
          <li><strong>1 inch difference:</strong> A cup (identical in US and UK)</li>
          <li><strong>2 inch difference:</strong> B cup (identical in US and UK)</li>
          <li><strong>3 inch difference:</strong> C cup (identical in US and UK)</li>
          <li><strong>4 inch difference:</strong> D cup (identical in US and UK)</li>
        </ul>
        <p class="mb-4">
          Starting at a <strong>5-inch difference</strong>, the naming conventions split. British lingerie manufacturers adopted standardized double-letter designations (<code class="bg-canvas px-1.5 py-0.5 rounded text-primary">DD, E, F, FF, G, GG, H, HH, J, JJ, K</code>) to systematically accommodate larger bust volumes. In contrast, American manufacturers lack a single unified standard, using a mix of single-letter continuations (<code class="bg-canvas px-1.5 py-0.5 rounded text-ink">E, F, G, H, I, J</code>) or multi-D labels (<code class="bg-canvas px-1.5 py-0.5 rounded text-ink">DD, DDD, DDDD</code>).
        </p>

        <!-- Data Table 1: Full Conversion Chart -->
        <h3 class="text-lg font-bold text-ink mt-6 mb-3">Complete Bust-to-Cup Progression Matrix</h3>
        <div class="overflow-x-auto -mx-2 px-2 mb-6">
          <table class="w-full text-left text-xs sm:text-sm text-body border-collapse min-w-[500px]">
            <thead>
              <tr class="border-b border-hairline bg-canvas-soft-2 text-ink">
                <th scope="col" class="py-2.5 px-3 font-semibold">Bust-Band Delta</th>
                <th scope="col" class="py-2.5 px-3 font-semibold">UK Standard Cup</th>
                <th scope="col" class="py-2.5 px-3 font-semibold">US Standard Cup</th>
                <th scope="col" class="py-2.5 px-3 font-semibold">Alternate US Labels</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-hairline">
              <tr><td class="py-2 px-3 font-semibold">1 inch (2.54 cm)</td><td class="py-2 px-3 font-semibold text-primary">A</td><td class="py-2 px-3">A</td><td class="py-2 px-3 text-mute">A</td></tr>
              <tr><td class="py-2 px-3 font-semibold">2 inches (5.08 cm)</td><td class="py-2 px-3 font-semibold text-primary">B</td><td class="py-2 px-3">B</td><td class="py-2 px-3 text-mute">B</td></tr>
              <tr><td class="py-2 px-3 font-semibold">3 inches (7.62 cm)</td><td class="py-2 px-3 font-semibold text-primary">C</td><td class="py-2 px-3">C</td><td class="py-2 px-3 text-mute">C</td></tr>
              <tr><td class="py-2 px-3 font-semibold">4 inches (10.16 cm)</td><td class="py-2 px-3 font-semibold text-primary">D</td><td class="py-2 px-3">D</td><td class="py-2 px-3 text-mute">D</td></tr>
              <tr><td class="py-2 px-3 font-semibold">5 inches (12.70 cm)</td><td class="py-2 px-3 font-semibold text-primary">DD</td><td class="py-2 px-3">DD</td><td class="py-2 px-3 text-mute">E</td></tr>
              <tr><td class="py-2 px-3 font-semibold">6 inches (15.24 cm)</td><td class="py-2 px-3 font-semibold text-primary">E</td><td class="py-2 px-3">DDD</td><td class="py-2 px-3 text-mute">F</td></tr>
              <tr><td class="py-2 px-3 font-semibold">7 inches (17.78 cm)</td><td class="py-2 px-3 font-semibold text-primary">F</td><td class="py-2 px-3">G</td><td class="py-2 px-3 text-mute">DDDD</td></tr>
              <tr><td class="py-2 px-3 font-semibold">8 inches (20.32 cm)</td><td class="py-2 px-3 font-semibold text-primary">FF</td><td class="py-2 px-3">H</td><td class="py-2 px-3 text-mute">G / 5D</td></tr>
              <tr><td class="py-2 px-3 font-semibold">9 inches (22.86 cm)</td><td class="py-2 px-3 font-semibold text-primary">G</td><td class="py-2 px-3">I</td><td class="py-2 px-3 text-mute">H</td></tr>
              <tr><td class="py-2 px-3 font-semibold">10 inches (25.40 cm)</td><td class="py-2 px-3 font-semibold text-primary">GG</td><td class="py-2 px-3">J</td><td class="py-2 px-3 text-mute">I</td></tr>
              <tr><td class="py-2 px-3 font-semibold">11 inches (27.94 cm)</td><td class="py-2 px-3 font-semibold text-primary">H</td><td class="py-2 px-3">K</td><td class="py-2 px-3 text-mute">J</td></tr>
              <tr><td class="py-2 px-3 font-semibold">12 inches (30.48 cm)</td><td class="py-2 px-3 font-semibold text-primary">HH</td><td class="py-2 px-3">L</td><td class="py-2 px-3 text-mute">K</td></tr>
              <tr><td class="py-2 px-3 font-semibold">13 inches (33.02 cm)</td><td class="py-2 px-3 font-semibold text-primary">J</td><td class="py-2 px-3">M</td><td class="py-2 px-3 text-mute">L</td></tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- Section 2: Brand Variations & Elasticity -->
      <section class="bg-surface border border-hairline rounded-2xl p-6 sm:p-8">
        <h2 class="text-xl sm:text-2xl font-bold text-ink mb-4">2. Popular Brand Sizing Quirks & Sizing Matrices</h2>
        <p class="mb-4">
          Even within the same country, bra manufacturers structure their underwire widths and band stretch parameters differently. Understanding these brand tendencies prevents ordering errors:
        </p>

        <div class="overflow-x-auto -mx-2 px-2 mb-6">
          <table class="w-full text-left text-xs sm:text-sm text-body border-collapse min-w-[500px]">
            <thead>
              <tr class="border-b border-hairline bg-canvas-soft-2 text-ink">
                <th scope="col" class="py-2.5 px-3 font-semibold">Brand Name</th>
                <th scope="col" class="py-2.5 px-3 font-semibold">Region Standard</th>
                <th scope="col" class="py-2.5 px-3 font-semibold">Underwire & Depth Character</th>
                <th scope="col" class="py-2.5 px-3 font-semibold">Recommended Fitting Strategy</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-hairline">
              <tr>
                <td class="py-2.5 px-3 font-semibold text-ink">Panache / Cleo</td>
                <td class="py-2.5 px-3 font-semibold text-primary">UK Standard</td>
                <td class="py-2.5 px-3">Deep projection, firm bands, narrow underwires.</td>
                <td class="py-2.5 px-3">Order exact UK size. Band may feel firm initially.</td>
              </tr>
              <tr>
                <td class="py-2.5 px-3 font-semibold text-ink">Freya / Fantasie</td>
                <td class="py-2.5 px-3 font-semibold text-primary">UK Standard</td>
                <td class="py-2.5 px-3">Softer wires, stretchy bands, generous cup volume.</td>
                <td class="py-2.5 px-3">If between band sizes, size down in band.</td>
              </tr>
              <tr>
                <td class="py-2.5 px-3 font-semibold text-ink">Elomi</td>
                <td class="py-2.5 px-3 font-semibold text-primary">UK Standard (Plus)</td>
                <td class="py-2.5 px-3">Wide underwire roots, strong side support panels.</td>
                <td class="py-2.5 px-3">Ideal for broader breast roots and fuller busts.</td>
              </tr>
              <tr>
                <td class="py-2.5 px-3 font-semibold text-ink">Wacoal / Natori</td>
                <td class="py-2.5 px-3 font-semibold text-ink">US Standard</td>
                <td class="py-2.5 px-3">Shallow to average projection, firm elastic bands.</td>
                <td class="py-2.5 px-3">If coming from UK sizing, check cup letter conversion.</td>
              </tr>
              <tr>
                <td class="py-2.5 px-3 font-semibold text-ink">Victoria's Secret</td>
                <td class="py-2.5 px-3 font-semibold text-ink">US Non-Standard</td>
                <td class="py-2.5 px-3">Very stretchy bands, shallow moulded push-up cups.</td>
                <td class="py-2.5 px-3">Uses +4 method in store. Calculate true size here first!</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- Section 3: Expert Fitting Principles & Edge Cases -->
      <section class="bg-surface border border-hairline rounded-2xl p-6 sm:p-8">
        <h2 class="text-xl sm:text-2xl font-bold text-ink mb-4">3. E-E-A-T Expert Fitting Rules & Edge Cases</h2>
        <p class="mb-4">
          Our certified fitting specialists recommend keeping these practical guidelines in mind when converting between US and UK garments:
        </p>

        <div class="space-y-4 mb-6">
          <div class="p-4 bg-canvas-soft-2/70 border border-hairline rounded-xl">
            <h3 class="font-bold text-ink mb-1 text-sm">A. Trust the Band Number First</h3>
            <p class="text-xs sm:text-sm text-body">
              Because band numbers are identical in both regions (32, 34, 36, etc.), never alter your band size when switching between US and UK sizing unless a specific brand's elastic runs unusually tight or loose.
            </p>
          </div>

          <div class="p-4 bg-canvas-soft-2/70 border border-hairline rounded-xl">
            <h3 class="font-bold text-ink mb-1 text-sm">B. Count Cup Steps Rather Than Letters</h3>
            <p class="text-xs sm:text-sm text-body">
              When converting an unfamiliar brand, count the number of cup steps above D cup. For instance, if you wear the 3rd size above D cup in a US brand (which is G cup in standard US), your UK size will also be the 3rd size above D cup (which is UK F cup).
            </p>
          </div>

          <div class="p-4 bg-canvas-soft-2/70 border border-hairline rounded-xl">
            <h3 class="font-bold text-ink mb-1 text-sm">C. Asymmetrical Busts & Moulded Cups</h3>
            <p class="text-xs sm:text-sm text-body">
              If your breasts differ in volume, always fit the cup size to the larger breast and insert a removable cookie/pad on the smaller side. UK unlined lace bras (like Panache Envy) accommodate asymmetry far better than stiff US moulded foam cups.
            </p>
          </div>
        </div>
      </section>

      <!-- Section 4: Interactive Tools & Next Steps -->
      <section class="bg-surface border border-hairline rounded-2xl p-6 sm:p-8">
        <h2 class="text-xl sm:text-2xl font-bold text-ink mb-4">4. Calculate & Convert Your Size Online</h2>
        <p class="mb-6">
          Eliminate manual conversion math. Use our interactive suite of specialized fitting calculators:
        </p>
        
        <div class="flex flex-wrap gap-3">
          <a href="/bra-size-converter" class="px-5 py-2.5 bg-primary text-white font-bold text-xs rounded-xl hover:bg-primary-hover transition-colors shadow-2xs">
            Open Interactive Size Converter &rarr;
          </a>
          <a href="/uk-bra-size-guide" class="px-5 py-2.5 bg-surface border border-hairline text-ink font-semibold text-xs rounded-xl hover:bg-canvas-soft-2 transition-colors shadow-2xs">
            Read Dedicated UK Bra Guide &rarr;
          </a>
          <a href="/sister-size-calculator" class="px-5 py-2.5 bg-surface border border-hairline text-ink font-semibold text-xs rounded-xl hover:bg-canvas-soft-2 transition-colors shadow-2xs">
            Sister Size Calculator &rarr;
          </a>
        </div>
      </section>

      <!-- Section 5: FAQ Section -->
      <section class="bg-surface border border-hairline rounded-2xl p-6 sm:p-8">
        <h2 class="text-xl sm:text-2xl font-bold text-ink mb-6">Frequently Asked Questions</h2>
        <div class="space-y-4">
          {faqSchema.mainEntity.map(item => (
            <details class="bg-canvas border border-hairline rounded-xl p-5 cursor-pointer group">
              <summary class="font-bold text-ink flex justify-between items-center list-none">
                <span>{item.name}</span>
                <span class="text-primary group-open:rotate-180 transition-transform">&darr;</span>
              </summary>
              <p class="mt-4 text-body text-xs sm:text-sm leading-relaxed">{item.acceptedAnswer.text}</p>
            </details>
          ))}
        </div>
      </section>
    </div>
  </main>
  <Footer />
</Layout>
