---
interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="mb-6">
  <ol class="flex items-center gap-2 flex-wrap text-xs text-mute leading-normal">
    <li>
      <a href="/" class="hover:text-primary transition-colors py-1 inline-block">Home</a>
    </li>
    {items.map((item, index) => (
      <li class="flex items-center gap-2">
        <span class="text-hairline-strong select-none" aria-hidden="true">/</span>
        {item.href ? (
          <a href={item.href} class="hover:text-primary transition-colors py-1 inline-block">{item.label}</a>
        ) : (
          <span class="text-ink font-semibold" aria-current="page">{item.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
