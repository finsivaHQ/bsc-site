---
import { validateAndCalculateBraSize, BAND_CONVERSION_MATRIX, CUP_CONVERSION_MATRIX } from '../utils/braSizing';

  document.addEventListener('astro:page-load', () => {
---

<section id="calculator" class="py-8 sm:py-12 md:py-20 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto w-full">
  <!-- Hero / Header inside calculator area -->
  <div class="text-center mb-8 md:mb-12">
    <span class="inline-block py-1.5 px-4 rounded-full bg-canvas-soft-2 border border-hairline text-xs font-semibold uppercase tracking-widest text-primary mb-4 shadow-2xs">
      BRA SIZE CALCULATOR
    </span>
    <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold text-ink tracking-tight mb-4">
      Bra Size Calculator — Find Your Perfect Fit.
    </h1>
    <p class="text-sm sm:text-base md:text-lg text-body max-w-2xl mx-auto leading-relaxed mb-6">
      Enter your bust and underbust measurements to get your recommended starting size, sister sizes, and international equivalents.
    </p>

    <!-- Trust Row -->
    <div class="flex flex-wrap items-center justify-center gap-3 text-xs sm:text-sm font-medium text-mute">
      <span class="flex items-center gap-1.5">
        <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
        Free
      </span>
      <span class="text-hairline-strong">•</span>
      <span class="flex items-center gap-1.5">
        <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
        No signup
      </span>
      <span class="text-hairline-strong">•</span>
      <span class="flex items-center gap-1.5">
        <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
        Easy to use
      </span>
    </div>
  </div>

  <!-- Calculator Focal Card -->
  <div class="bg-surface border border-hairline rounded-2xl shadow-sm p-4 sm:p-6 md:p-10 mb-8 md:mb-12 transition-colors duration-300">
    <form id="calculator-form" action="#" onsubmit="event.preventDefault();">
      <!-- Step 1: Unit Toggle -->
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6 pb-4 border-b border-hairline">
        <div>
          <span class="text-xs font-bold text-primary uppercase tracking-wider block mb-0.5">Step 1</span>
          <h2 class="text-xl sm:text-2xl font-bold text-ink">Enter Your Measurements</h2>
        </div>
        <div class="flex bg-canvas-soft-2 rounded-xl p-1 border border-hairline w-full sm:w-auto">
          <button type="button" id="unit-in" class="unit-btn active flex-1 sm:flex-none h-11 px-4 py-2.5 text-sm font-semibold rounded-lg bg-primary text-on-primary shadow-xs transition-all duration-200 cursor-pointer">
            Inches (in)
          </button>
          <button type="button" id="unit-cm" class="unit-btn flex-1 sm:flex-none h-11 px-4 py-2.5 text-sm font-semibold rounded-lg text-body hover:text-ink transition-all duration-200 cursor-pointer">
            Centimeters (cm)
          </button>
        </div>
      </div>

      <!-- Privacy Trust Badge -->
      <div class="flex items-center gap-2 mb-6 bg-canvas-soft-2/80 border border-hairline py-2 px-3.5 rounded-xl w-full sm:w-fit text-xs text-body leading-snug">
        <span class="text-sm flex-shrink-0">🔒</span>
        <span><strong class="text-ink font-semibold">Your measurements stay private.</strong> Calculated locally in your browser and never stored.</span>
      </div>

      <!-- Accessible Inline Error Box -->
      <div id="calculator-error" class="hidden mb-6 p-4 rounded-xl bg-accent/15 border border-accent/40 text-ink text-sm font-medium flex items-center gap-3" role="alert" aria-live="polite">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-primary flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="8" x2="12" y2="12"></line>
          <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
        <span id="calculator-error-text">Please enter valid measurements.</span>
      </div>

      <!-- Inputs: Step 2 & Step 3 -->
      <div class="grid md:grid-cols-2 gap-6 sm:gap-8 mb-8">
        <!-- Step 2: Underbust -->
        <div>
          <div class="flex items-center justify-between mb-1.5">
            <label for="underbust" class="block text-sm font-semibold text-ink">Step 2: Underbust (Band Size)</label>
            <a href="/#how-to-measure" class="text-xs text-primary font-medium hover:underline">How to measure &rarr;</a>
          </div>
          <p class="text-xs text-mute mb-3">Measure snugly around your ribcage, directly under your bust.</p>
          <div class="relative">
            <input 
              type="number" 
              id="underbust" 
              inputmode="decimal" 
              step="any"
              min="0"
              placeholder="e.g. 32" 
              class="w-full bg-surface border border-hairline rounded-xl h-13 px-4 pr-12 text-base text-ink placeholder:text-mute/60 focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/20 transition-all duration-200"
            />
            <span class="absolute right-4 top-1/2 -translate-y-1/2 text-mute text-sm font-medium unit-label pointer-events-none">in</span>
          </div>
        </div>

        <!-- Step 3: Bust -->
        <div>
          <div class="flex items-center justify-between mb-1.5">
            <label for="overbust" class="block text-sm font-semibold text-ink">Step 3: Bust Size</label>
            <a href="/#how-to-measure" class="text-xs text-primary font-medium hover:underline">How to measure &rarr;</a>
          </div>
          <p class="text-xs text-mute mb-3">Measure loosely around the fullest part of your bust.</p>
          <div class="relative">
            <input 
              type="number" 
              id="overbust" 
              inputmode="decimal" 
              step="any"
              min="0"
              placeholder="e.g. 35" 
              class="w-full bg-surface border border-hairline rounded-xl h-13 px-4 pr-12 text-base text-ink placeholder:text-mute/60 focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/20 transition-all duration-200"
            />
            <span class="absolute right-4 top-1/2 -translate-y-1/2 text-mute text-sm font-medium unit-label pointer-events-none">in</span>
          </div>
        </div>
      </div>

      <!-- Calculate Primary CTA Button -->
      <div class="mb-2">
        <button 
          type="submit" 
          id="calculate-btn" 
          class="w-full h-12 sm:h-13 bg-primary hover:bg-primary-hover active:translate-y-[1px] text-white font-bold text-base rounded-xl shadow-xs transition-all duration-200 cursor-pointer flex items-center justify-center gap-2"
        >
          Calculate My Bra Size
        </button>
      </div>
    </form>

    <!-- Dynamic Result Area -->
    <div id="result-area" class="hidden bg-canvas-soft-2 border border-hairline rounded-2xl p-5 sm:p-8 md:p-10 mt-8 transition-all duration-300" role="region" aria-live="polite" aria-label="Calculated bra size recommendation">
      <!-- Main Size Display Hero Card -->
      <div class="text-center mb-8 pb-8 border-b border-hairline relative">
        <span class="inline-block text-xs font-bold text-primary uppercase tracking-widest mb-2">YOUR RECOMMENDED SIZE</span>
        
        <!-- Dominant Result Size -->
        <div id="main-size" class="text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-bold text-ink tracking-tight my-2">
          34C
        </div>
        <p id="size-system-label" class="text-xs sm:text-sm font-semibold text-body mb-4">
          US / CA Sizing System
        </p>
        
        <!-- Band & Cup Breakdown Chips -->
        <div class="flex items-center justify-center gap-3 mb-6">
          <span class="px-3.5 py-1.5 bg-surface border border-hairline rounded-full text-xs font-semibold text-ink shadow-2xs">
            Band: <strong id="chip-band" class="text-primary font-bold">34</strong>
          </span>
          <span class="px-3.5 py-1.5 bg-surface border border-hairline rounded-full text-xs font-semibold text-ink shadow-2xs">
            Cup: <strong id="chip-cup" class="text-primary font-bold">C</strong>
          </span>
        </div>

        <!-- Result Action Bar (Copy & Recalculate) -->
        <div class="flex flex-wrap items-center justify-center gap-3">
          <button 
            type="button" 
            id="copy-size-btn" 
            class="h-10 px-4 bg-surface hover:bg-canvas-soft-2 border border-hairline rounded-xl text-xs font-semibold text-ink transition-all duration-200 flex items-center gap-2 shadow-2xs cursor-pointer"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
            <span id="copy-size-text">Copy Result</span>
          </button>
          
          <button 
            type="button" 
            id="recalculate-btn" 
            class="h-10 px-4 bg-surface hover:bg-canvas-soft-2 border border-hairline rounded-xl text-xs font-semibold text-body hover:text-ink transition-all duration-200 flex items-center gap-1.5 shadow-2xs cursor-pointer"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-mute" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21.5 2v6h-6"></path>
              <path d="M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></path>
            </svg>
            <span>Recalculate</span>
          </button>
        </div>
      </div>

      <!-- Sister Sizes Section (3-Card Comparison) -->
      <div class="mb-8">
        <div class="mb-4">
          <h3 class="text-base font-bold text-ink mb-1">Your Sister Sizes</h3>
          <p class="text-xs text-body">Sister sizes have similar cup volume but different band measurements.</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 sm:gap-4 text-left">
          <!-- Card 1: Smaller Band -->
          <div class="bg-surface border border-hairline rounded-xl p-4 text-center shadow-2xs flex flex-col justify-between">
            <div>
              <span class="inline-block px-2.5 py-0.5 rounded-full bg-canvas-soft-2 border border-hairline text-[11px] font-semibold text-body mb-2">
                Smaller Band &larr;
              </span>
              <div id="sister-tight" class="text-2xl sm:text-3xl font-bold text-ink my-1">32D</div>
            </div>
            <p class="text-[11px] text-mute leading-snug mt-2 pt-2 border-t border-hairline/60">
              If the band feels loose, try a smaller band size.
            </p>
          </div>

          <!-- Card 2: Current Size (Highlighted Focal Card) -->
          <div class="bg-canvas-soft-2 border-2 border-primary/40 rounded-xl p-4 text-center shadow-xs flex flex-col justify-between relative overflow-hidden">
            <div class="absolute top-0 right-0 bg-primary text-white text-[10px] font-bold px-2 py-0.5 rounded-bl-lg uppercase tracking-wider">
              Recommended
            </div>
            <div>
              <span class="inline-block px-2.5 py-0.5 rounded-full bg-surface border border-hairline text-[11px] font-bold text-primary mb-2">
                Your Baseline
              </span>
              <div id="sister-current" class="text-3xl sm:text-4xl font-bold text-ink my-1">34C</div>
            </div>
            <p class="text-[11px] text-body font-medium leading-snug mt-2 pt-2 border-t border-hairline">
              Starting point based on your measurements.
            </p>
          </div>

          <!-- Card 3: Larger Band -->
          <div class="bg-surface border border-hairline rounded-xl p-4 text-center shadow-2xs flex flex-col justify-between">
            <div>
              <span class="inline-block px-2.5 py-0.5 rounded-full bg-canvas-soft-2 border border-hairline text-[11px] font-semibold text-body mb-2">
                &rarr; Larger Band
              </span>
              <div id="sister-loose" class="text-2xl sm:text-3xl font-bold text-ink my-1">36B</div>
            </div>
            <p class="text-[11px] text-mute leading-snug mt-2 pt-2 border-t border-hairline/60">
              If the band feels tight, try a larger band size.
            </p>
          </div>
        </div>

        <!-- Educational Callout Box -->
        <div class="mt-4 p-4 bg-surface/70 border border-hairline rounded-xl text-xs text-body leading-relaxed">
          <strong class="text-ink font-semibold block mb-1">What are sister sizes?</strong>
          Sister sizes share the exact same cup volume capacity. If a <strong>34C</strong> feels too tight around your ribcage, moving to a <strong>36B</strong> gives you a looser band while keeping the same cup volume. Conversely, if <strong>34C</strong> feels too loose, moving to a <strong>32D</strong> tightens the band while maintaining cup volume.
        </div>
      </div>

      <!-- International Sizes Table -->
      <div class="mb-6">
        <h3 class="text-xs font-bold text-primary uppercase tracking-wider mb-3">International Size Equivalents</h3>
        <div class="overflow-x-auto -mx-2 px-2">
          <table class="w-full text-left border-collapse text-xs sm:text-sm text-body min-w-[280px]">
            <thead>
              <tr class="border-b border-hairline text-ink bg-surface/50">
                <th scope="col" class="py-2.5 px-3 font-semibold rounded-l-lg">Location</th>
                <th scope="col" class="py-2.5 px-3 font-semibold">Band</th>
                <th scope="col" class="py-2.5 px-3 font-semibold rounded-r-lg">Cup</th>
              </tr>
            </thead>
            <tbody id="intl-table-body" class="divide-y divide-hairline">
              <!-- Populated dynamically via JS -->
            </tbody>
          </table>
        </div>
      </div>

      <!-- Transparency Caveat Note -->
      <p class="text-xs text-mute leading-relaxed pt-4 border-t border-hairline">
        * Your recommended size is based on the measurements you entered and is intended as a starting point. Fit can vary between brands, fabrics, and cup styles.
      </p>
    </div>
  </div>

  <!-- Bra Size Converter Chart Card -->
  <div id="chart-section" class="bg-surface border border-hairline rounded-2xl shadow-sm p-4 sm:p-6 md:p-10 transition-colors duration-300">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6 pb-4 border-b border-hairline">
      <div>
        <h2 class="text-xl sm:text-2xl font-bold text-ink">Bra Size Converter Chart — US, UK, EU & International Sizes</h2>
        <p class="text-xs sm:text-sm text-body mt-1">Bra sizing systems vary by country. Use this chart to compare common size labels across verified regions.</p>
      </div>

      <!-- Realtime Search Box -->
      <div class="w-full md:w-64 flex-shrink-0">
        <label for="matrix-search" class="sr-only">Search size</label>
        <div class="relative">
          <input 
            type="text" 
            id="matrix-search" 
            placeholder="Search size (e.g. 34, DD, 75)..." 
            class="w-full h-10 px-3.5 pl-9 bg-canvas border border-hairline rounded-xl text-xs text-ink placeholder:text-mute/60 focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/20 transition-all duration-200"
          />
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-mute absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </div>
      </div>
    </div>

    <!-- Band Conversion Matrix Table -->
    <h3 class="text-xs sm:text-sm font-bold text-primary uppercase tracking-wider mb-3 flex items-center justify-between">
      <span>Band Conversion Matrix</span>
      <span class="text-[11px] text-mute font-normal">US / UK / EU / FR / AU / JP / IN / HK / KR / SG</span>
    </h3>
    <div class="overflow-x-auto mb-8 -mx-2 px-2 max-h-[360px]">
      <table class="w-full text-left text-xs sm:text-sm text-body min-w-[720px] border-collapse relative">
        <thead class="sticky top-0 bg-canvas-soft-2 text-ink shadow-2xs z-10">
          <tr class="border-b border-hairline">
            <th scope="col" class="py-3 px-3 font-semibold rounded-tl-lg">US / CA</th>
            <th scope="col" class="py-3 px-3 font-semibold">UK</th>
            <th scope="col" class="py-3 px-3 font-semibold">EU</th>
            <th scope="col" class="py-3 px-3 font-semibold">FR / BE / ES</th>
            <th scope="col" class="py-3 px-3 font-semibold">AU / NZ</th>
            <th scope="col" class="py-3 px-3 font-semibold">JP</th>
            <th scope="col" class="py-3 px-3 font-semibold">India (IN)</th>
            <th scope="col" class="py-3 px-3 font-semibold">Hong Kong (HK)</th>
            <th scope="col" class="py-3 px-3 font-semibold">South Korea (KR)</th>
            <th scope="col" class="py-3 px-3 font-semibold rounded-tr-lg">Singapore (SG)</th>
          </tr>
        </thead>
        <tbody id="band-matrix-body" class="divide-y divide-hairline bg-surface">
          <!-- Rendered dynamically from BAND_CONVERSION_MATRIX -->
        </tbody>
      </table>
    </div>

    <!-- Cup Size Matrix Table -->
    <h3 class="text-xs sm:text-sm font-bold text-primary uppercase tracking-wider mb-3 flex items-center justify-between">
      <span>Cup Size Matrix</span>
      <span class="text-[11px] text-mute font-normal">US / UK / EU / AU / JP / IN / HK / KR / SG</span>
    </h3>
    <div class="overflow-x-auto -mx-2 px-2 max-h-[420px]">
      <table class="w-full text-left text-xs sm:text-sm text-body min-w-[720px] border-collapse relative">
        <thead class="sticky top-0 bg-canvas-soft-2 text-ink shadow-2xs z-10">
          <tr class="border-b border-hairline">
            <th scope="col" class="py-3 px-3 font-semibold rounded-tl-lg">US / CA</th>
            <th scope="col" class="py-3 px-3 font-semibold">UK</th>
            <th scope="col" class="py-3 px-3 font-semibold">EU</th>
            <th scope="col" class="py-3 px-3 font-semibold">AU / NZ</th>
            <th scope="col" class="py-3 px-3 font-semibold">JP</th>
            <th scope="col" class="py-3 px-3 font-semibold">India (IN)</th>
            <th scope="col" class="py-3 px-3 font-semibold">Hong Kong (HK)</th>
            <th scope="col" class="py-3 px-3 font-semibold">South Korea (KR)</th>
            <th scope="col" class="py-3 px-3 font-semibold rounded-tr-lg">Singapore (SG)</th>
          </tr>
        </thead>
        <tbody id="cup-matrix-body" class="divide-y divide-hairline bg-surface">
          <!-- Rendered dynamically from CUP_CONVERSION_MATRIX -->
        </tbody>
      </table>
    </div>

    <p class="text-xs text-mute mt-4 leading-relaxed border-t border-hairline pt-3">
      * Bra sizing conventions vary between brands and regions. These conversions are intended as a general sizing reference.
    </p>
  </div>
</section>

<script>
    });
</script>undefined