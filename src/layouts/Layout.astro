---
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
	canonical?: string;
	noindex?: boolean;
}

const { 
	title, 
	description = "Calculate your recommended bra size in seconds with our free, private calculator. Includes sister sizes, US/UK/EU international size conversion charts, and fit guidance.",
	canonical,
	noindex = false 
} = Astro.props;

// Generate canonical URL dynamically based on the current path if not explicitly overridden
const defaultCanonical = new URL(Astro.url.pathname, 'https://brasizechecker.com').toString().replace(/\/$/, '');
const canonicalURL = canonical || defaultCanonical || 'https://brasizechecker.com';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="msvalidate.01" content="1F7EB46675900FDE533DDDA7125754E4" />
		<link rel="canonical" href={canonicalURL} />
		<title>{title}</title>
		<script is:inline>
			const theme = (() => {
				if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
					return localStorage.getItem('theme');
				}
				if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
					return 'dark';
				}
				return 'light';
			})();
			
			if (theme === 'dark') {
				document.documentElement.classList.add('dark');
			} else {
				document.documentElement.classList.remove('dark');
			}
		</script>
	</head>
	<body class="antialiased min-h-screen flex flex-col selection:bg-primary selection:text-on-primary">
		<slot />
	</body>
</html>
