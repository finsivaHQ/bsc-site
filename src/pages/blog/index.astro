---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout 
  title="Bra Size & Fit Guide Blog | BraSizeChecker"
  description="Read comprehensive guides, international sizing charts, and expert tips on how to find your perfect bra size."
>
  <Header />

  <main class="flex-1 w-full max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">
    <div class="mb-12 text-center md:text-left">
      <span class="inline-block py-1 px-3 rounded-full bg-canvas-soft-2 border border-hairline text-xs font-semibold uppercase tracking-widest text-primary mb-3">
        Expert Guides
      </span>
      <h1 class="text-3xl md:text-5xl font-bold text-ink mb-4 tracking-tight">Fit Guides & Articles</h1>
      <p class="text-base md:text-lg text-body max-w-2xl">
        Everything you need to know about bra sizing, sister sizes, brand conversions, and measuring at home.
      </p>
    </div>

    {posts.length > 0 ? (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {posts.map((post) => (
          <a href={`/blog/${post.id}/`} class="group flex flex-col bg-surface border border-hairline rounded-3xl overflow-hidden hover:shadow-md hover:border-primary/50 transition-all duration-300">
            {post.data.heroImage && (
              <div class="w-full aspect-[4/3] bg-canvas-soft-2 overflow-hidden border-b border-hairline relative">
                <img 
                  src={post.data.heroImage} 
                  alt="" 
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy" 
                />
                {post.data.doctorVerified && (
                  <div class="absolute top-3 left-3 bg-white/90 backdrop-blur-sm px-2 py-1 rounded-full border border-white flex items-center gap-1 shadow-sm">
                    <svg xmlns="http://www.w3.org/2000/svg" class="text-green-600" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                    <span class="text-[10px] font-bold text-green-700 uppercase tracking-wider">Verified</span>
                  </div>
                )}
              </div>
            )}
            <div class="p-6 flex flex-col flex-1">
              <div class="text-xs text-mute font-medium mb-3">
                <time datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                </time>
              </div>
              <h2 class="text-xl font-bold text-ink mb-3 group-hover:text-primary transition-colors leading-tight">
                {post.data.title}
              </h2>
              <p class="text-body text-sm line-clamp-3 mb-6 flex-1">
                {post.data.description}
              </p>
              <div class="mt-auto text-primary text-sm font-bold flex items-center gap-1">
                Read Article
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
              </div>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <div class="text-center py-20 bg-surface border border-hairline rounded-3xl">
        <h2 class="text-2xl font-bold text-ink mb-2">Coming Soon</h2>
        <p class="text-body">Our expert team is busy writing comprehensive guides. Check back shortly!</p>
      </div>
    )}
  </main>
  
  <Footer />
</Layout>
