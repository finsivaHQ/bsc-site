---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What causes 'quad-boob' or double-bust lines under t-shirts?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Quad-boobing is caused when bra cup volume is 1 to 2 sizes too small. The upper edge of the elastic cup cuts directly across soft breast tissue, pinching it into two distinct upper and lower bulges that show clearly under thin clothing."
      }
    },
    {
      "@type": "Question",
      "name": "What is the difference between top spillage and side armpit spillage?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Top spillage indicates insufficient cup depth, forcing breast tissue over the neckline. Side spillage (underarm bulging) indicates underwires that are too narrow or underbust bands that are too loose, allowing breast tissue to migrate toward your back armpits."
      }
    }
  ]
};
---

<Layout 
  title="Why Are My Breasts Spilling Out of My Bra? ('Quad-Boob') Fixes | BraSizeChecker"
  description="Fix breast spillage over top or side bra cups. Master quad-boob diagnostics, side spillage migration, cup volume expansion tables, and t-shirt fit checks."
  canonical="https://brasizechecker.com/fit-guide/bra-spillage"
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <Header />
  <main class="flex-1 w-full max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 md:py-16">
    <Breadcrumbs items={[
      { label: 'Fit Guide', url: '/fit-guide' },
      { label: 'Breast Spillage' }
    ]} />

    <header class="mb-10 text-center sm:text-left">
      <span class="inline-block py-1 px-3 rounded-full bg-canvas-soft-2 border border-hairline text-xs font-semibold uppercase tracking-widest text-primary mb-3">
        Fit Diagnostic Guide
      </span>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-ink tracking-tight mb-4">
        Why Are My Breasts Spilling Out of My Bra? Quad-Boob & Side Fixes
      </h1>
      <p class="text-base sm:text-lg text-body leading-relaxed max-w-3xl">
        Breast tissue bulging over the top, sides, or center gore of your bra cups—commonly creating a double-bust ridge known as "quad-boobing"—is an undeniable signal that your bra cups are overloaded beyond their volumetric capacity.
      </p>
    </header>

    <div class="space-y-10 text-body leading-relaxed text-sm sm:text-base">
      <!-- Section 1: Vector Diagram & Spillage Anatomy -->
      <section class="bg-surface border border-hairline rounded-2xl p-6 sm:p-8">
        <h2 class="text-xl sm:text-2xl font-bold text-ink mb-4">1. Anatomy of Cup Overflow & Quad-Boobing</h2>
        <p class="mb-4">
          Breast tissue is soft, displacement-prone tissue. When you compress 700 cc of breast volume inside a 500 cc bra cup, the displaced tissue has no option but to overflow past the rigid boundaries of the cup.
        </p>

        <!-- Diagram -->
        <div class="max-w-md mx-auto my-6">
          <img 
            src="/img/fit-cup-spillage.svg" 
            alt="Vector diagram demonstrating breast spillage and quad-boob overflow over top bra cup boundary" 
            width="400" 
            height="240" 
            class="w-full h-auto rounded-xl border border-hairline shadow-2xs" 
            loading="lazy"
          />
          <span class="text-center text-xs text-mute mt-2 block font-medium">Figure 1: Quad-boob tissue overflow caused by undersized cup volume</span>
        </div>
      </section>

      <!-- Section 2: Top vs Side Spillage Diagnostic Matrix -->
      <section class="bg-surface border border-hairline rounded-2xl p-6 sm:p-8">
        <h2 class="text-xl sm:text-2xl font-bold text-ink mb-4">2. Top Spillage vs. Side Spillage Matrix</h2>
        <p class="mb-4">
          Different types of spillage stem from different mechanical flaws in cup cut and underwire width:
        </p>

        <!-- Data Table 1: Spillage Matrix -->
        <div class="overflow-x-auto -mx-2 px-2 mb-6">
          <table class="w-full text-left text-xs sm:text-sm text-body border-collapse min-w-[520px]">
            <thead>
              <tr class="border-b border-hairline bg-canvas-soft-2 text-ink">
                <th scope="col" class="py-2.5 px-3 font-semibold">Spillage Type</th>
                <th scope="col" class="py-2.5 px-3 font-semibold">Visual Symptom</th>
                <th scope="col" class="py-2.5 px-3 font-semibold">Underlying Root Cause</th>
                <th scope="col" class="py-2.5 px-3 font-semibold">Recommended Fix</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-hairline">
              <tr>
                <td class="py-2.5 px-3 font-semibold text-primary">Top Neckline Spillage ("Quad-Boob")</td>
                <td class="py-2.5 px-3">Bulging horizontal ridge above top cup edge under t-shirts.</td>
                <td class="py-2.5 px-3">Cup volume is 1 to 2 sizes too small.</td>
                <td class="py-2.5 px-3">Increase cup letter by 1-2 steps (e.g. 34C &rarr; 34DD).</td>
              </tr>
              <tr>
                <td class="py-2.5 px-3 font-semibold text-ink">Side Underarm Spillage</td>
                <td class="py-2.5 px-3">Tissue rolls bulging out under armpits behind underwires.</td>
                <td class="py-2.5 px-3">Underwire arch is too narrow; wire rests on tissue.</td>
                <td class="py-2.5 px-3">Choose wide-root cups (e.g. Elomi or Wacoal) in larger cup size.</td>
              </tr>
              <tr>
                <td class="py-2.5 px-3 font-semibold text-ink">Center Gore Spillage</td>
                <td class="py-2.5 px-3">Tissue pushing together and popping over low center bridge.</td>
                <td class="py-2.5 px-3">Low-cut plunge bra worn on full-on-top breasts.</td>
                <td class="py-2.5 px-3">Switch to high-gore balconette or full-coverage cups.</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- Section 3: Tissue Migration & Recovery -->
      <section class="bg-surface border border-hairline rounded-2xl p-6 sm:p-8">
        <h2 class="text-xl sm:text-2xl font-bold text-ink mb-4">3. Tissue Migration & Proper Cup Containment</h2>
        <p class="mb-4">
          Wearing undersized cups for years forces migratory breast tissue outward into the underarm and upper back regions. When you move into a properly sized cup and perform the daily <em>Scoop and Swoop</em>, this tissue gradually migrates back into the main breast mound over 4 to 8 weeks.
        </p>
      </section>

      <!-- Section 4: Interactive Sizing Tools -->
      <section class="bg-surface border border-hairline rounded-2xl p-6 sm:p-8">
        <h2 class="text-xl sm:text-2xl font-bold text-ink mb-4">4. Re-Calculate Your Correct Cup Size</h2>
        <div class="flex flex-wrap gap-3">
          <a href="/#calculator" class="px-5 py-2.5 bg-primary text-white font-bold text-xs rounded-xl hover:bg-primary-hover transition-colors shadow-2xs">
            Calculate Size Baseline &rarr;
          </a>
          <a href="/sister-size-calculator" class="px-5 py-2.5 bg-surface border border-hairline text-ink font-semibold text-xs rounded-xl hover:bg-canvas-soft-2 transition-colors shadow-2xs">
            Sister Size Matrix &rarr;
          </a>
          <a href="/fit-guide" class="px-5 py-2.5 bg-surface border border-hairline text-ink font-semibold text-xs rounded-xl hover:bg-canvas-soft-2 transition-colors shadow-2xs">
            Return to Fit Diagnostic Hub &rarr;
          </a>
        </div>
      </section>

      <!-- Section 5: FAQ Section -->
      <section class="bg-surface border border-hairline rounded-2xl p-6 sm:p-8">
        <h2 class="text-xl sm:text-2xl font-bold text-ink mb-6">Frequently Asked Questions</h2>
        <div class="space-y-4">
          {faqSchema.mainEntity.map(item => (
            <details class="bg-canvas border border-hairline rounded-xl p-5 cursor-pointer group">
              <summary class="font-bold text-ink flex justify-between items-center list-none">
                <span>{item.name}</span>
                <span class="text-primary group-open:rotate-180 transition-transform">&darr;</span>
              </summary>
              <p class="mt-4 text-body text-xs sm:text-sm leading-relaxed">{item.acceptedAnswer.text}</p>
            </details>
          ))}
        </div>
      </section>
    </div>
  </main>
  <Footer />
</Layout>
