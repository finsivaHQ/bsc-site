---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { US_CUPS, BAND_CONVERSION_MATRIX } from '../utils/braSizing';

const availableBands = BAND_CONVERSION_MATRIX.map(row => row.us);
const availableCups = US_CUPS;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What are sister sizes in bra fitting?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sister sizes are bra size combinations that share the exact same physical cup volume capacity despite having different band measurements. For example, 32D, 34C, 36B, and 38A all hold the exact same volumetric displacement of breast tissue (approx 590 cc)."
      }
    },
    {
      "@type": "Question",
      "name": "How do I calculate my sister size?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "To find your sister size for a tighter band: go down 1 band size and UP 1 cup letter (e.g. 34C -> 32D). To find your sister size for a looser band: go up 1 band size and DOWN 1 cup letter (e.g. 34C -> 36B)."
      }
    }
  ]
};
---

<Layout 
  title="Sister Size Calculator — Find Equivalent Cup Volumes & Sister Sizes | BraSizeChecker"
  description="Free bra sister size calculator. Find your equivalent bra sister sizes for a tighter or looser band while preserving cup volume displacement."
  canonical="https://brasizechecker.com/sister-size-calculator"
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <Header />
  <main class="flex-1 w-full max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 md:py-16">
    <Breadcrumbs items={[{ label: 'Sister Size Calculator' }]} />

    <!-- Page Header / Intro -->
    <header class="mb-10 text-center sm:text-left">
      <span class="inline-block py-1 px-3 rounded-full bg-canvas-soft-2 border border-hairline text-xs font-semibold uppercase tracking-widest text-primary mb-3">
        Interactive Sister Size Engine
      </span>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-ink tracking-tight mb-4">
        Sister Size Calculator & Equivalent Cup Volume Generator
      </h1>
      <p class="text-base sm:text-lg text-body leading-relaxed max-w-3xl">
        Sister sizes are bra size combinations that maintain identical volumetric breast cup capacity while adjusting underbust band tightness. Select your current size below to generate your exact tighter-band and looser-band sister sizes.
      </p>
    </header>

    <!-- Sister Size Calculator Form Card -->
    <section class="bg-surface border border-hairline rounded-2xl shadow-sm p-4 sm:p-6 md:p-10 mb-12" aria-labelledby="sister-heading">
      <h2 id="sister-heading" class="sr-only">Sister Size Calculator Form</h2>

      <form id="sister-form" action="#" onsubmit="event.preventDefault();" class="space-y-6 mb-8">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
          <!-- Band Selector -->
          <div>
            <label for="sister-band-select" class="block text-sm font-semibold text-ink mb-1.5">
              Current Band Size
            </label>
            <select 
              id="sister-band-select" 
              class="w-full h-12 px-4 bg-surface border border-hairline rounded-xl text-base text-ink font-medium focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/20 cursor-pointer transition-all"
            >
              {availableBands.map(b => (
                <option value={b} selected={b === 34}>{b}</option>
              ))}
            </select>
          </div>

          <!-- Cup Selector -->
          <div>
            <label for="sister-cup-select" class="block text-sm font-semibold text-ink mb-1.5">
              Current Cup Size
            </label>
            <select 
              id="sister-cup-select" 
              class="w-full h-12 px-4 bg-surface border border-hairline rounded-xl text-base text-ink font-medium focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/20 cursor-pointer transition-all"
            >
              {availableCups.map(c => (
                <option value={c} selected={c === 'C'}>{c}</option>
              ))}
            </select>
          </div>
        </div>

        <!-- CTA Button -->
        <div>
          <button 
            type="submit" 
            id="sister-calc-btn" 
            class="w-full sm:w-auto h-12 px-8 bg-primary hover:bg-primary-hover active:translate-y-[1px] text-white font-bold text-base rounded-xl shadow-xs transition-all duration-200 cursor-pointer flex items-center justify-center gap-2"
          >
            Find My Sister Sizes
          </button>
        </div>
      </form>

      <!-- Results Display Card (3-Card Sister Size Grid) -->
      <div id="sister-results-area" class="bg-canvas-soft-2 border border-hairline rounded-2xl p-5 sm:p-8 transition-all duration-300">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6 pb-4 border-b border-hairline">
          <div>
            <span class="text-xs font-bold text-primary uppercase tracking-widest block mb-1">SISTER SIZES BREAKDOWN</span>
            <h3 class="text-xl sm:text-2xl font-bold text-ink">
              Sister Sizes for <span id="sister-entered-label" class="text-primary font-bold">34C</span>
            </h3>
          </div>
          <button 
            type="button" 
            id="copy-sister-btn" 
            class="h-10 px-4 bg-surface hover:bg-canvas-soft-2 border border-hairline rounded-xl text-xs font-semibold text-ink transition-all duration-200 flex items-center gap-2 shadow-2xs cursor-pointer self-start sm:self-auto"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
            <span id="copy-sister-text">Copy Sister Sizes</span>
          </button>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 sm:gap-4 text-left">
          <!-- Card 1: Smaller Band (Tighter) -->
          <div class="bg-surface border border-hairline rounded-xl p-4 text-center shadow-2xs flex flex-col justify-between">
            <div>
              <span class="inline-block px-2.5 py-0.5 rounded-full bg-canvas-soft-2 border border-hairline text-[11px] font-semibold text-body mb-2">
                Smaller Band &larr;
              </span>
              <div id="sister-tight-display" class="text-2xl sm:text-3xl font-bold text-ink my-1">32D</div>
            </div>
            <p class="text-[11px] text-mute leading-snug mt-2 pt-2 border-t border-hairline/60">
              <strong>If band feels too loose:</strong> Try a smaller band size with a larger cup letter.
            </p>
          </div>

          <!-- Card 2: Current Size (Focal Card) -->
          <div class="bg-canvas-soft-2 border-2 border-primary/40 rounded-xl p-4 text-center shadow-xs flex flex-col justify-between relative overflow-hidden">
            <div class="absolute top-0 right-0 bg-primary text-white text-[10px] font-bold px-2 py-0.5 rounded-bl-lg uppercase tracking-wider">
              Current Size
            </div>
            <div>
              <span class="inline-block px-2.5 py-0.5 rounded-full bg-surface border border-hairline text-[11px] font-bold text-primary mb-2">
                Your Baseline
              </span>
              <div id="sister-current-display" class="text-3xl sm:text-4xl font-bold text-ink my-1">34C</div>
            </div>
            <p class="text-[11px] text-body font-medium leading-snug mt-2 pt-2 border-t border-hairline">
              Starting baseline size entered above.
            </p>
          </div>

          <!-- Card 3: Larger Band (Looser) -->
          <div class="bg-surface border border-hairline rounded-xl p-4 text-center shadow-2xs flex flex-col justify-between">
            <div>
              <span class="inline-block px-2.5 py-0.5 rounded-full bg-canvas-soft-2 border border-hairline text-[11px] font-semibold text-body mb-2">
                &rarr; Larger Band
              </span>
              <div id="sister-loose-display" class="text-2xl sm:text-3xl font-bold text-ink my-1">36B</div>
            </div>
            <p class="text-[11px] text-mute leading-snug mt-2 pt-2 border-t border-hairline/60">
              <strong>If band feels too tight:</strong> Try a larger band size with a smaller cup letter.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Educational Content Sections -->
    <div class="space-y-10 text-body leading-relaxed text-sm sm:text-base">
      <!-- Section 1: The Physics of Sister Sizing -->
      <section class="bg-surface border border-hairline rounded-2xl p-6 sm:p-8">
        <h2 class="text-xl sm:text-2xl font-bold text-ink mb-4">1. The Physics of Equal Cup Volume Conservation</h2>
        <p class="mb-4">
          Because bra underwires and cups scale proportionally with the underbust band, a cup letter is an index of relative ratio rather than an absolute volume measurement.
        </p>

        <!-- Diagram -->
        <div class="my-6 max-w-md mx-auto">
          <img 
            src="/img/sister-size-diagram.svg" 
            alt="Vector diagram demonstrating equal cup volume capacity between 32D, 34C, and 36B sister sizes" 
            width="400" 
            height="240" 
            class="w-full h-auto rounded-xl border border-hairline shadow-2xs" 
            loading="lazy"
          />
          <span class="text-center text-xs text-mute mt-2 block font-medium">Figure 1: Equal 590 cm³ cup volume capacity across 32D, 34C, and 36B sister sizes</span>
        </div>

        <p class="mb-4">
          As shown in Figure 1 above, a <strong>32D, 34C, and 36B bra cup all hold the exact same volumetric displacement (~590 cc)</strong>. The only difference is the length of the elastic underbust band anchored around your ribcage!
        </p>
      </section>

      <!-- Section 2: Master Sister Size Grid Matrix -->
      <section class="bg-surface border border-hairline rounded-2xl p-6 sm:p-8">
        <h2 class="text-xl sm:text-2xl font-bold text-ink mb-4">2. Master Sister Size Cross-Reference Matrix</h2>
        <p class="mb-4">
          Use this reference table to find equivalent volume rows across common band sizes:
        </p>

        <!-- Data Table 1: Master Sister Matrix -->
        <div class="overflow-x-auto -mx-2 px-2 mb-6">
          <table class="w-full text-left text-xs sm:text-sm text-body border-collapse min-w-[520px]">
            <thead>
              <tr class="border-b border-hairline bg-canvas-soft-2 text-ink">
                <th scope="col" class="py-2.5 px-3 font-semibold">Volume Group</th>
                <th scope="col" class="py-2.5 px-3 font-semibold">30 Band Sister</th>
                <th scope="col" class="py-2.5 px-3 font-semibold">32 Band Sister</th>
                <th scope="col" class="py-2.5 px-3 font-semibold">34 Band Sister</th>
                <th scope="col" class="py-2.5 px-3 font-semibold">36 Band Sister</th>
                <th scope="col" class="py-2.5 px-3 font-semibold">38 Band Sister</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-hairline">
              <tr>
                <td class="py-2 px-3 font-semibold text-ink">~390 cc Volume</td>
                <td class="py-2 px-3">30D</td>
                <td class="py-2 px-3 font-semibold text-primary">32C</td>
                <td class="py-2 px-3 font-semibold text-primary">34B</td>
                <td class="py-2 px-3 font-semibold text-primary">36A</td>
                <td class="py-2 px-3">38AA</td>
              </tr>
              <tr>
                <td class="py-2 px-3 font-semibold text-ink">~480 cc Volume</td>
                <td class="py-2 px-3">30DD</td>
                <td class="py-2 px-3 font-semibold text-primary">32D</td>
                <td class="py-2 px-3 font-semibold text-primary">34C</td>
                <td class="py-2 px-3 font-semibold text-primary">36B</td>
                <td class="py-2 px-3">38A</td>
              </tr>
              <tr>
                <td class="py-2 px-3 font-semibold text-ink">~590 cc Volume</td>
                <td class="py-2 px-3">30E</td>
                <td class="py-2 px-3 font-semibold text-primary">32DD</td>
                <td class="py-2 px-3 font-semibold text-primary">34D</td>
                <td class="py-2 px-3 font-semibold text-primary">36C</td>
                <td class="py-2 px-3">38B</td>
              </tr>
              <tr>
                <td class="py-2 px-3 font-semibold text-ink">~710 cc Volume</td>
                <td class="py-2 px-3">30F</td>
                <td class="py-2 px-3 font-semibold text-primary">32E</td>
                <td class="py-2 px-3 font-semibold text-primary">34DD</td>
                <td class="py-2 px-3 font-semibold text-primary">36D</td>
                <td class="py-2 px-3">38C</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- Section 3: When to Use Sister Sizes -->
      <section class="bg-surface border border-hairline rounded-2xl p-6 sm:p-8">
        <h2 class="text-xl sm:text-2xl font-bold text-ink mb-4">3. When to Use Sister Sizing</h2>
        <div class="space-y-4">
          <div class="p-4 bg-canvas-soft-2 rounded-xl border border-hairline">
            <h3 class="font-bold text-ink mb-1 text-sm uppercase tracking-wider text-primary">Scenario 1: Band Rides Up Back</h3>
            <p class="text-xs sm:text-sm">Your cups fit great, but the band slides up your shoulder blades. Move to the <strong>smaller band sister size</strong> (e.g. 36C &rarr; 34D) to gain a tighter anchor.</p>
          </div>

          <div class="p-4 bg-canvas-soft-2 rounded-xl border border-hairline">
            <h3 class="font-bold text-ink mb-1 text-sm uppercase tracking-wider text-primary">Scenario 2: Band Digs In Painfully</h3>
            <p class="text-xs sm:text-sm">Your cups contain your breasts, but the band restricts breathing. Move to the <strong>larger band sister size</strong> (e.g. 34C &rarr; 36B) to gain ribcage room.</p>
          </div>
        </div>
      </section>

      <!-- Section 4: Related Sizing Tools -->
      <section class="bg-surface border border-hairline rounded-2xl p-6 sm:p-8">
        <h2 class="text-xl sm:text-2xl font-bold text-ink mb-4">4. Explore More Sizing Tools</h2>
        <div class="flex flex-wrap gap-3">
          <a href="/#calculator" class="px-5 py-2.5 bg-primary text-white font-bold text-xs rounded-xl hover:bg-primary-hover transition-colors shadow-2xs">
            Primary Calculator &rarr;
          </a>
          <a href="/bra-size-chart" class="px-5 py-2.5 bg-surface border border-hairline text-ink font-semibold text-xs rounded-xl hover:bg-canvas-soft-2 transition-colors shadow-2xs">
            Bra Size Chart &rarr;
          </a>
          <a href="/bra-size-converter" class="px-5 py-2.5 bg-surface border border-hairline text-ink font-semibold text-xs rounded-xl hover:bg-canvas-soft-2 transition-colors shadow-2xs">
            Bra Size Converter &rarr;
          </a>
        </div>
      </section>

      <!-- Section 5: FAQ Section -->
      <section class="bg-surface border border-hairline rounded-2xl p-6 sm:p-8">
        <h2 class="text-xl sm:text-2xl font-bold text-ink mb-6">Frequently Asked Questions</h2>
        <div class="space-y-4">
          {faqSchema.mainEntity.map(item => (
            <details class="bg-canvas border border-hairline rounded-xl p-5 cursor-pointer group">
              <summary class="font-bold text-ink flex justify-between items-center list-none">
                <span>{item.name}</span>
                <span class="text-primary group-open:rotate-180 transition-transform">&darr;</span>
              </summary>
              <p class="mt-4 text-body text-xs sm:text-sm leading-relaxed">{item.acceptedAnswer.text}</p>
            </details>
          ))}
        </div>
      </section>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener('astro:page-load', () => {
    const bandSelect = document.getElementById('sister-band-select') as HTMLSelectElement;
    const cupSelect = document.getElementById('sister-cup-select') as HTMLSelectElement;
    const calcBtn = document.getElementById('sister-calc-btn');
    const enteredLabel = document.getElementById('sister-entered-label');
    const tightDisplay = document.getElementById('sister-tight-display');
    const currentDisplay = document.getElementById('sister-current-display');
    const looseDisplay = document.getElementById('sister-loose-display');
    const copyBtn = document.getElementById('copy-sister-btn');
    const copyText = document.getElementById('copy-sister-text');

    const cupsList = ['AA', 'A', 'B', 'C', 'D', 'DD', 'DDD', 'G', 'H', 'I', 'J', 'K', 'L', 'M', 'N', 'O'];

    function updateSisterSizes() {
      if (!bandSelect || !cupSelect) return;
      const band = parseInt(bandSelect.value, 10);
      const cup = cupSelect.value;
      const cupIndex = cupsList.indexOf(cup);

      if (enteredLabel) enteredLabel.textContent = `${band}${cup}`;
      if (currentDisplay) currentDisplay.textContent = `${band}${cup}`;

      // Smaller band -> Sister size up in cup (index + 1)
      if (tightDisplay) {
        const smallerBand = band - 2;
        const largerCup = cupIndex >= 0 && cupIndex < cupsList.length - 1 ? cupsList[cupIndex + 1] : null;
        if (smallerBand >= 28 && largerCup) {
          tightDisplay.textContent = `${smallerBand}${largerCup}`;
        } else {
          tightDisplay.textContent = 'N/A';
        }
      }

      // Larger band -> Sister size down in cup (index - 1)
      if (looseDisplay) {
        const largerBand = band + 2;
        const smallerCup = cupIndex > 0 ? cupsList[cupIndex - 1] : null;
        if (largerBand <= 44 && smallerCup) {
          looseDisplay.textContent = `${largerBand}${smallerCup}`;
        } else {
          looseDisplay.textContent = 'N/A';
        }
      }
    }

    if (calcBtn) {
      calcBtn.addEventListener('click', updateSisterSizes);
    }
    if (bandSelect) bandSelect.addEventListener('change', updateSisterSizes);
    if (cupSelect) cupSelect.addEventListener('change', updateSisterSizes);

    if (copyBtn && copyText) {
      copyBtn.addEventListener('click', async () => {
        const tight = tightDisplay?.textContent || '';
        const curr = currentDisplay?.textContent || '';
        const loose = looseDisplay?.textContent || '';
        const textToCopy = `Sister Sizes for ${curr}: Tighter Band (${tight}), Baseline (${curr}), Looser Band (${loose}) — calculated at BraSizeChecker.com`;
        
        try {
          await navigator.clipboard.writeText(textToCopy);
          copyText.textContent = 'Copied!';
          setTimeout(() => {
            if (copyText) copyText.textContent = 'Copy Sister Sizes';
          }, 2000);
        } catch (e) {
          console.error('Clipboard copy failed', e);
        }
      });
    }
  });
</script>
