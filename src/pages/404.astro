---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="404 Page Not Found | BraSizeChecker"
  description="The page you requested could not be found. Return to the BraSizeChecker homepage to calculate your bra size."
  noindex={true}
>
  <Header />
  <main class="flex-1 w-full max-w-3xl mx-auto px-4 sm:px-6 py-12 sm:py-24 text-center">
    <span class="inline-block py-1.5 px-4 rounded-full bg-canvas-soft-2 border border-hairline text-xs font-semibold uppercase tracking-widest text-primary mb-4">
      Error 404
    </span>
    <h1 class="text-3xl sm:text-5xl md:text-6xl font-bold text-ink mb-4">Page Not Found</h1>
    <p class="text-body text-sm sm:text-base max-w-md mx-auto mb-8 leading-relaxed">
      Sorry, we couldn't find the page you were looking for. Please check the address or return to the calculator.
    </p>
    <a href="/" class="inline-flex items-center justify-center h-12 px-8 bg-primary text-white font-semibold rounded-xl hover:bg-primary-hover transition-colors shadow-xs">
      Return Home
    </a>
  </main>
  <Footer />
</Layout>
