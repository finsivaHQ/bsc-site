---
---
<section id="calculator" class="py-12 md:py-20 px-6 lg:px-8 max-w-4xl mx-auto w-full">
  <!-- Hero / Header inside calculator area -->
  <div class="text-center mb-12">
    <span class="inline-block py-1.5 px-4 rounded-full bg-canvas-soft-2 border border-hairline text-xs font-semibold uppercase tracking-widest text-primary mb-4">
      Precision Fit
    </span>
    <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-ink tracking-tight mb-4">
      Find Your Perfect Fit.
    </h1>
    <p class="text-base md:text-lg text-body max-w-2xl mx-auto leading-relaxed">
      Enter your measurements below. Our calculator instantly determines your size across international standards.
    </p>
  </div>

  <!-- Calculator Focal Card -->
  <div class="bg-surface border border-hairline rounded-2xl shadow-sm p-6 md:p-10 mb-12 transition-colors duration-300">
    <!-- Header & Unit Toggle -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-8 pb-4 border-b border-hairline">
      <h2 class="text-2xl font-bold text-ink">Measurements</h2>
      <div class="flex bg-canvas-soft-2 rounded-xl p-1 border border-hairline w-full sm:w-auto">
        <button id="unit-in" class="unit-btn active flex-1 sm:flex-none px-4 py-2 text-sm font-semibold rounded-lg bg-primary text-on-primary shadow-xs transition-all duration-200 cursor-pointer">
          Inches (in)
        </button>
        <button id="unit-cm" class="unit-btn flex-1 sm:flex-none px-4 py-2 text-sm font-semibold rounded-lg text-body hover:text-ink transition-all duration-200 cursor-pointer">
          Centimeters (cm)
        </button>
      </div>
    </div>

    <!-- Inputs -->
    <div class="grid md:grid-cols-2 gap-8 mb-8">
      <div>
        <label for="overbust" class="block text-sm font-semibold text-ink mb-1.5">
          1. Bust Size
        </label>
        <p class="text-xs text-mute mb-3">Measure loosely around the fullest part of your bust.</p>
        <div class="relative">
          <input 
            type="number" 
            id="overbust" 
            placeholder="e.g. 35" 
            class="w-full bg-surface border border-hairline rounded-xl h-13 px-4 pr-12 text-base text-ink placeholder:text-mute/60 focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/20 transition-all duration-200" 
          />
          <span class="absolute right-4 top-1/2 -translate-y-1/2 text-mute text-sm font-medium unit-label pointer-events-none">
            in
          </span>
        </div>
      </div>

      <div>
        <label for="underbust" class="block text-sm font-semibold text-ink mb-1.5">
          2. Band Size
        </label>
        <p class="text-xs text-mute mb-3">Measure snugly right under your breasts.</p>
        <div class="relative">
          <input 
            type="number" 
            id="underbust" 
            placeholder="e.g. 32" 
            class="w-full bg-surface border border-hairline rounded-xl h-13 px-4 pr-12 text-base text-ink placeholder:text-mute/60 focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/20 transition-all duration-200" 
          />
          <span class="absolute right-4 top-1/2 -translate-y-1/2 text-mute text-sm font-medium unit-label pointer-events-none">
            in
          </span>
        </div>
      </div>
    </div>

    <!-- Dynamic Result Area -->
    <div id="result-area" class="hidden bg-canvas-soft-2 border border-hairline rounded-xl p-6 md:p-8 transition-all duration-300">
      <div class="text-center mb-8">
        <p class="text-xs text-primary font-bold uppercase tracking-widest mb-2">Your Recommended Size (US/CA)</p>
        <div id="main-size" class="text-5xl md:text-6xl lg:text-7xl font-bold text-ink tracking-tight mb-2">34C</div>
        <p class="text-xs text-body">Based on standard sizing metrics</p>
      </div>

      <!-- Sister Sizes -->
      <div class="grid grid-cols-2 gap-4 mb-8 text-left">
        <div class="bg-surface border border-hairline rounded-xl p-4 text-center shadow-xs">
          <p class="text-xs text-mute uppercase font-medium mb-1">Tighter Band</p>
          <div class="flex items-end justify-center gap-2">
            <span id="sister-tight" class="text-2xl font-bold text-ink">32D</span>
          </div>
        </div>
        <div class="bg-surface border border-hairline rounded-xl p-4 text-center shadow-xs">
          <p class="text-xs text-mute uppercase font-medium mb-1">Looser Band</p>
          <div class="flex items-end justify-center gap-2">
            <span id="sister-loose" class="text-2xl font-bold text-ink">36B</span>
          </div>
        </div>
      </div>

      <!-- International Sizes Table -->
      <h3 class="text-base font-bold text-ink mb-4 border-b border-hairline pb-2">International Sizes</h3>
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse text-sm text-body">
          <thead>
            <tr class="border-b border-hairline text-ink">
              <th class="py-2.5 font-semibold">Location</th>
              <th class="py-2.5 font-semibold">Band</th>
              <th class="py-2.5 font-semibold">Cup</th>
            </tr>
          </thead>
          <tbody id="intl-table-body">
            <!-- Populated dynamically via JS -->
          </tbody>
        </table>
      </div>
      <p class="text-xs text-mute mt-4">
        * Calculation results serve as a starting point. Fit may vary depending on brand fabric, wire shape, and style.
      </p>
    </div>
  </div>

  <!-- Bra Size Converter Chart Card -->
  <div class="bg-surface border border-hairline rounded-2xl shadow-sm p-6 md:p-10 transition-colors duration-300">
    <h2 class="text-2xl font-bold text-ink mb-6 border-b border-hairline pb-4">Bra Size Converter Chart</h2>
    
    <h3 class="text-sm font-bold text-primary uppercase tracking-wider mb-3">Band Conversion Matrix</h3>
    <div class="overflow-x-auto mb-8">
      <table class="w-full text-left text-sm text-body min-w-[600px] border-collapse">
        <thead>
          <tr class="bg-canvas-soft-2 text-ink border-b border-hairline">
            <th class="py-3 px-3 font-semibold rounded-tl-lg">US/CA</th>
            <th class="py-3 px-3 font-semibold">UK</th>
            <th class="py-3 px-3 font-semibold">EU</th>
            <th class="py-3 px-3 font-semibold">FR/BE/ES</th>
            <th class="py-3 px-3 font-semibold rounded-tr-lg">AU/NZ</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-hairline">
          <tr class="hover:bg-canvas-soft-2/50 transition-colors"><td class="py-2.5 px-3 font-semibold text-ink">30</td><td class="py-2.5 px-3">30</td><td class="py-2.5 px-3">65</td><td class="py-2.5 px-3">80</td><td class="py-2.5 px-3">8</td></tr>
          <tr class="hover:bg-canvas-soft-2/50 transition-colors"><td class="py-2.5 px-3 font-semibold text-ink">32</td><td class="py-2.5 px-3">32</td><td class="py-2.5 px-3">70</td><td class="py-2.5 px-3">85</td><td class="py-2.5 px-3">10</td></tr>
          <tr class="hover:bg-canvas-soft-2/50 transition-colors"><td class="py-2.5 px-3 font-semibold text-ink">34</td><td class="py-2.5 px-3">34</td><td class="py-2.5 px-3">75</td><td class="py-2.5 px-3">90</td><td class="py-2.5 px-3">12</td></tr>
          <tr class="hover:bg-canvas-soft-2/50 transition-colors"><td class="py-2.5 px-3 font-semibold text-ink">36</td><td class="py-2.5 px-3">36</td><td class="py-2.5 px-3">80</td><td class="py-2.5 px-3">95</td><td class="py-2.5 px-3">14</td></tr>
          <tr class="hover:bg-canvas-soft-2/50 transition-colors"><td class="py-2.5 px-3 font-semibold text-ink">38</td><td class="py-2.5 px-3">38</td><td class="py-2.5 px-3">85</td><td class="py-2.5 px-3">100</td><td class="py-2.5 px-3">16</td></tr>
          <tr class="hover:bg-canvas-soft-2/50 transition-colors"><td class="py-2.5 px-3 font-semibold text-ink">40</td><td class="py-2.5 px-3">40</td><td class="py-2.5 px-3">90</td><td class="py-2.5 px-3">105</td><td class="py-2.5 px-3">18</td></tr>
        </tbody>
      </table>
    </div>

    <h3 class="text-sm font-bold text-primary uppercase tracking-wider mb-3">Cup Size Matrix</h3>
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm text-body min-w-[600px] border-collapse">
        <thead>
          <tr class="bg-canvas-soft-2 text-ink border-b border-hairline">
            <th class="py-3 px-3 font-semibold rounded-tl-lg">US/CA</th>
            <th class="py-3 px-3 font-semibold">UK</th>
            <th class="py-3 px-3 font-semibold">EU</th>
            <th class="py-3 px-3 font-semibold rounded-tr-lg">AU/NZ</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-hairline">
          <tr class="hover:bg-canvas-soft-2/50 transition-colors"><td class="py-2.5 px-3 font-semibold text-ink">A</td><td class="py-2.5 px-3">A</td><td class="py-2.5 px-3">A</td><td class="py-2.5 px-3">A</td></tr>
          <tr class="hover:bg-canvas-soft-2/50 transition-colors"><td class="py-2.5 px-3 font-semibold text-ink">B</td><td class="py-2.5 px-3">B</td><td class="py-2.5 px-3">B</td><td class="py-2.5 px-3">B</td></tr>
          <tr class="hover:bg-canvas-soft-2/50 transition-colors"><td class="py-2.5 px-3 font-semibold text-ink">C</td><td class="py-2.5 px-3">C</td><td class="py-2.5 px-3">C</td><td class="py-2.5 px-3">C</td></tr>
          <tr class="hover:bg-canvas-soft-2/50 transition-colors"><td class="py-2.5 px-3 font-semibold text-ink">D</td><td class="py-2.5 px-3">D</td><td class="py-2.5 px-3">D</td><td class="py-2.5 px-3">D</td></tr>
          <tr class="hover:bg-canvas-soft-2/50 transition-colors"><td class="py-2.5 px-3 font-semibold text-ink">DD / E</td><td class="py-2.5 px-3">DD</td><td class="py-2.5 px-3">E</td><td class="py-2.5 px-3">DD</td></tr>
          <tr class="hover:bg-canvas-soft-2/50 transition-colors"><td class="py-2.5 px-3 font-semibold text-ink">DDD / F</td><td class="py-2.5 px-3">E</td><td class="py-2.5 px-3">F</td><td class="py-2.5 px-3">E</td></tr>
          <tr class="hover:bg-canvas-soft-2/50 transition-colors"><td class="py-2.5 px-3 font-semibold text-ink">G</td><td class="py-2.5 px-3">F</td><td class="py-2.5 px-3">G</td><td class="py-2.5 px-3">F</td></tr>
          <tr class="hover:bg-canvas-soft-2/50 transition-colors"><td class="py-2.5 px-3 font-semibold text-ink">H</td><td class="py-2.5 px-3">FF</td><td class="py-2.5 px-3">H</td><td class="py-2.5 px-3">FF</td></tr>
          <tr class="hover:bg-canvas-soft-2/50 transition-colors"><td class="py-2.5 px-3 font-semibold text-ink">I</td><td class="py-2.5 px-3">G</td><td class="py-2.5 px-3">I</td><td class="py-2.5 px-3">G</td></tr>
          <tr class="hover:bg-canvas-soft-2/50 transition-colors"><td class="py-2.5 px-3 font-semibold text-ink">J</td><td class="py-2.5 px-3">GG</td><td class="py-2.5 px-3">J</td><td class="py-2.5 px-3">GG</td></tr>
        </tbody>
      </table>
    </div>
  </div>
</section>

<script>
  // DOM Elements
  const unitInBtn = document.getElementById('unit-in');
  const unitCmBtn = document.getElementById('unit-cm');
  const unitLabels = document.querySelectorAll('.unit-label');
  const underbustInput = document.getElementById('underbust') as HTMLInputElement;
  const overbustInput = document.getElementById('overbust') as HTMLInputElement;
  const resultArea = document.getElementById('result-area');
  const mainSizeEl = document.getElementById('main-size');
  const sisterTightEl = document.getElementById('sister-tight');
  const sisterLooseEl = document.getElementById('sister-loose');
  const intlTableBody = document.getElementById('intl-table-body');

  let currentUnit = 'in';

  // Toggle Units
  const setUnit = (unit) => {
    if (unit === currentUnit) return;
    
    // Convert values if present
    if (underbustInput.value) {
      underbustInput.value = unit === 'cm' 
        ? (parseFloat(underbustInput.value) * 2.54).toFixed(1)
        : (parseFloat(underbustInput.value) / 2.54).toFixed(1);
    }
    if (overbustInput.value) {
      overbustInput.value = unit === 'cm' 
        ? (parseFloat(overbustInput.value) * 2.54).toFixed(1)
        : (parseFloat(overbustInput.value) / 2.54).toFixed(1);
    }

    currentUnit = unit;
    
    if (unit === 'in') {
      unitInBtn.classList.add('bg-primary', 'text-on-primary', 'shadow-xs');
      unitInBtn.classList.remove('text-body', 'hover:text-ink');
      unitCmBtn.classList.remove('bg-primary', 'text-on-primary', 'shadow-xs');
      unitCmBtn.classList.add('text-body', 'hover:text-ink');
      unitLabels.forEach(el => el.textContent = 'in');
      underbustInput.placeholder = 'e.g. 32';
      overbustInput.placeholder = 'e.g. 35';
    } else {
      unitCmBtn.classList.add('bg-primary', 'text-on-primary', 'shadow-xs');
      unitCmBtn.classList.remove('text-body', 'hover:text-ink');
      unitInBtn.classList.remove('bg-primary', 'text-on-primary', 'shadow-xs');
      unitInBtn.classList.add('text-body', 'hover:text-ink');
      unitLabels.forEach(el => el.textContent = 'cm');
      underbustInput.placeholder = 'e.g. 80';
      overbustInput.placeholder = 'e.g. 90';
    }
    calculateSize();
  };

  unitInBtn?.addEventListener('click', () => setUnit('in'));
  unitCmBtn?.addEventListener('click', () => setUnit('cm'));

  // Cup arrays
  const usCups = ['AA', 'A', 'B', 'C', 'D', 'DD', 'DDD', 'G', 'H', 'I', 'J', 'K', 'L'];
  const ukCups = ['AA', 'A', 'B', 'C', 'D', 'DD', 'E', 'F', 'FF', 'G', 'GG', 'H', 'HH', 'J'];
  const euCups = ['AA', 'A', 'B', 'C', 'D', 'E', 'F', 'G', 'H', 'I', 'J', 'K', 'L'];
  
  const calculateSize = () => {
    if (!underbustInput.value || !overbustInput.value) {
      resultArea?.classList.add('hidden');
      return;
    }

    let u_in = parseFloat(underbustInput.value);
    let o_in = parseFloat(overbustInput.value);

    if (isNaN(u_in) || isNaN(o_in)) {
      resultArea?.classList.add('hidden');
      return;
    }

    // Normalize to inches for standard US/UK math
    if (currentUnit === 'cm') {
      u_in = u_in / 2.54;
      o_in = o_in / 2.54;
    }
    
    let u_cm = u_in * 2.54;
    let o_cm = o_in * 2.54;

    // --- US/CA & UK (Modern Standard) ---
    let usBand = Math.round(u_in);
    if (usBand % 2 !== 0) usBand += 1;
    
    let usDiff = Math.round(o_in - usBand);
    if (usDiff < 0) usDiff = 0;
    
    const usCupIndex = Math.min(usDiff, usCups.length - 1);
    const ukCupIndex = Math.min(usDiff, ukCups.length - 1);

    const usSize = `${usBand}`;
    const usCup = usCups[usCupIndex];
    
    const ukSize = `${usBand}`;
    const ukCup = ukCups[ukCupIndex];

    // --- US/CA & UK (Underbust +4) ---
    let u_round = Math.round(u_in);
    let plus4Band = (u_round % 2 === 0) ? u_round + 4 : u_round + 5;
    let plus4Diff = Math.round(o_in - plus4Band);
    if (plus4Diff < 0) plus4Diff = 0;
    
    const plus4UsCup = usCups[Math.min(plus4Diff, usCups.length - 1)];
    const plus4UkCup = ukCups[Math.min(plus4Diff, ukCups.length - 1)];

    // --- EU (EN 13402) ---
    let euBand = Math.round(u_cm / 5) * 5;
    let euDiff = o_cm - u_cm;
    let euCupIndex = Math.floor((euDiff - 10) / 2);
    if (euCupIndex < 0) euCupIndex = 0;
    const euCup = euCups[Math.min(euCupIndex, euCups.length - 1)];

    // --- FR/BE/ES ---
    let frBand = euBand + 15;

    // --- Australia/NZ ---
    let auBand = usBand - 22;
    if (auBand < 4) auBand = 4;
    const auCup = ukCup; // AU cups are very close to UK for standard range

    // Sister Sizes (US)
    const tightBand = usBand - 2;
    const tightCupIndex = Math.min(usDiff + 1, usCups.length - 1);
    const tightSize = `${tightBand}${usCups[tightCupIndex]}`;

    const looseBand = usBand + 2;
    const looseCupIndex = Math.max(usDiff - 1, 0);
    const looseSize = `${looseBand}${usCups[looseCupIndex]}`;

    // Update DOM
    if (mainSizeEl) mainSizeEl.textContent = `${usSize}${usCup}`;
    if (sisterTightEl) sisterTightEl.textContent = tightSize;
    if (sisterLooseEl) sisterLooseEl.textContent = looseSize;

    // Build Table
    if (intlTableBody) {
      intlTableBody.innerHTML = `
        <tr class="border-b border-hairline hover:bg-surface/70 transition-colors">
          <td class="py-2.5 font-medium text-ink">US / CA</td>
          <td class="py-2.5 font-semibold text-ink">${usSize}</td>
          <td class="py-2.5 font-semibold text-primary">${usCup}</td>
        </tr>
        <tr class="border-b border-hairline hover:bg-surface/70 transition-colors">
          <td class="py-2.5 font-medium text-ink">UK</td>
          <td class="py-2.5 font-semibold text-ink">${ukSize}</td>
          <td class="py-2.5 font-semibold text-primary">${ukCup}</td>
        </tr>
        <tr class="border-b border-hairline hover:bg-surface/70 transition-colors">
          <td class="py-2.5 text-mute">US/CA (Underbust +4)*</td>
          <td class="py-2.5 font-medium text-mute">${plus4Band}</td>
          <td class="py-2.5 font-medium text-mute">${plus4UsCup}</td>
        </tr>
        <tr class="border-b border-hairline hover:bg-surface/70 transition-colors">
          <td class="py-2.5 text-mute">UK (Underbust +4)*</td>
          <td class="py-2.5 font-medium text-mute">${plus4Band}</td>
          <td class="py-2.5 font-medium text-mute">${plus4UkCup}</td>
        </tr>
        <tr class="border-b border-hairline hover:bg-surface/70 transition-colors">
          <td class="py-2.5 font-medium text-ink">EU (EN 13402)</td>
          <td class="py-2.5 font-semibold text-ink">${euBand} cm</td>
          <td class="py-2.5 font-semibold text-primary">${euCup}</td>
        </tr>
        <tr class="border-b border-hairline hover:bg-surface/70 transition-colors">
          <td class="py-2.5 font-medium text-ink">FR / BE / ES</td>
          <td class="py-2.5 font-semibold text-ink">${frBand} cm</td>
          <td class="py-2.5 font-semibold text-primary">${euCup}</td>
        </tr>
        <tr class="hover:bg-surface/70 transition-colors">
          <td class="py-2.5 font-medium text-ink">Australia / New Zealand</td>
          <td class="py-2.5 font-semibold text-ink">${auBand}</td>
          <td class="py-2.5 font-semibold text-primary">${auCup}</td>
        </tr>
      `;
    }

    resultArea?.classList.remove('hidden');
  };

  underbustInput?.addEventListener('input', calculateSize);
  overbustInput?.addEventListener('input', calculateSize);
</script>
