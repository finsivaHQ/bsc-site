---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { CUP_CONVERSION_MATRIX, BAND_CONVERSION_MATRIX } from '../utils/braSizing';
---

<Layout 
  title="UK Bra Size Guide — UK Cup Progression & US Conversion | BraSizeChecker"
  description="Complete UK bra size guide. Learn how UK cup sizing works (DD, E, F, FF, G, GG, H, HH), UK band measurements, and convert UK bra sizes to US, EU, and AU."
  canonical="https://brasizechecker.com/uk-bra-size-guide"
>
  <Header />
  <main class="flex-1 w-full max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 md:py-16">
    <Breadcrumbs items={[{ label: 'UK Bra Size Guide' }]} />

    <!-- Page Header / Intro -->
    <header class="mb-10 text-center sm:text-left">
      <span class="inline-block py-1 px-3 rounded-full bg-canvas-soft-2 border border-hairline text-xs font-semibold uppercase tracking-widest text-primary mb-3">
        Regional Sizing Guide
      </span>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-ink tracking-tight mb-4">
        UK Bra Size Guide & International Conversion
      </h1>
      <p class="text-base sm:text-lg text-body leading-relaxed max-w-3xl">
        UK bra sizing is recognized worldwide for its precision in full-bust lingerie. Renowned brands like Panache, Freya, Elomi, and Curvy Kate use British sizing conventions. Learn how UK band and cup progressions work and how to convert your size.
      </p>
    </header>

    <!-- Content Sections -->
    <div class="space-y-10 text-body leading-relaxed text-sm sm:text-base">
      <!-- Section 1: How UK Sizing Works -->
      <section class="bg-surface border border-hairline rounded-2xl p-6 sm:p-8">
        <h2 class="text-xl sm:text-2xl font-bold text-ink mb-4">How UK Bra Sizing Works</h2>
        <p class="mb-4">
          Like US sizing, UK bra band numbers use direct underbust measurements in inches (30, 32, 34, 36, 38, 40). However, <strong>UK cup sizing diverges significantly from US sizing after D cups</strong> by utilizing double-letter progressions (`DD`, `FF`, `GG`, `HH`, `JJ`).
        </p>
        
        <div class="p-4 bg-canvas-soft-2 border border-hairline rounded-xl mb-6">
          <span class="text-xs font-bold text-primary uppercase tracking-wider block mb-1">UK CUP PROGRESSION ORDER</span>
          <p class="text-sm font-bold text-ink tracking-wide">
            AA &rarr; A &rarr; B &rarr; C &rarr; D &rarr; <span class="text-primary">DD</span> &rarr; E &rarr; <span class="text-primary">F</span> &rarr; <span class="text-primary">FF</span> &rarr; G &rarr; <span class="text-primary">GG</span> &rarr; H &rarr; <span class="text-primary">HH</span> &rarr; J
          </p>
        </div>
      </section>

      <!-- Section 2: UK vs US Cup Comparison Table -->
      <section class="bg-surface border border-hairline rounded-2xl p-6 sm:p-8">
        <h2 class="text-xl sm:text-2xl font-bold text-ink mb-4">UK vs US Cup Size Comparison</h2>
        <p class="mb-4">
          Because US sizing uses `DDD/F`, `G`, `H`, `I`, `J` while UK sizing uses `DD`, `E`, `F`, `FF`, `G`, `GG`, a 34G in UK sizing is two cup volumes larger than a 34G in US sizing!
        </p>

        <div class="overflow-x-auto -mx-2 px-2 mb-6">
          <table class="w-full text-left text-xs sm:text-sm text-body border-collapse min-w-[440px]">
            <thead>
              <tr class="border-b border-hairline bg-canvas-soft-2 text-ink">
                <th scope="col" class="py-2.5 px-3 font-semibold">Bust-Band Diff</th>
                <th scope="col" class="py-2.5 px-3 font-semibold">UK Cup Label</th>
                <th scope="col" class="py-2.5 px-3 font-semibold">US / CA Equivalent</th>
                <th scope="col" class="py-2.5 px-3 font-semibold">EU / JP Equivalent</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-hairline">
              {CUP_CONVERSION_MATRIX.map(row => (
                <tr>
                  <td class="py-2 px-3 font-medium">{row.uk} cup volume</td>
                  <td class="py-2 px-3 font-semibold text-primary">{row.uk}</td>
                  <td class="py-2 px-3 font-semibold text-ink">{row.us}</td>
                  <td class="py-2 px-3 font-semibold text-ink">{row.eu}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <!-- Section 3: Converting Your UK Size -->
      <section class="bg-surface border border-hairline rounded-2xl p-6 sm:p-8">
        <h2 class="text-xl sm:text-2xl font-bold text-ink mb-4">How to Convert UK Sizes to Other Regions</h2>
        <p class="mb-4">
          When buying British lingerie brands from outside the UK, use these conversion guidelines:
        </p>
        <ul class="list-disc pl-5 space-y-2 text-xs sm:text-sm mb-6">
          <li><strong>UK to US:</strong> Keep the same band number (e.g. 34 stays 34). Cup letters match up to D cup. For E cup and above, check our conversion matrix.</li>
          <li><strong>UK to EU:</strong> Multiply your UK band in inches by 2.54 and round to nearest 5 cm (e.g. 34 UK = 75 EU).</li>
          <li><strong>UK to AU/NZ:</strong> UK band 30 = AU 8, 32 = AU 10, 34 = AU 12, 36 = AU 14, 38 = AU 16. Cup letters remain identical.</li>
        </ul>

        <div class="flex flex-wrap gap-3">
          <a href="/bra-size-converter" class="px-5 py-2.5 bg-primary text-white font-bold text-xs rounded-xl hover:bg-primary-hover transition-colors shadow-2xs">
            Open Interactive Converter &rarr;
          </a>
          <a href="/bra-size-chart" class="px-5 py-2.5 bg-surface border border-hairline text-ink font-semibold text-xs rounded-xl hover:bg-canvas-soft-2 transition-colors shadow-2xs">
            Full Size Chart &rarr;
          </a>
        </div>
      </section>

      <!-- Section 4: How to Measure for UK Bras -->
      <section class="bg-surface border border-hairline rounded-2xl p-6 sm:p-8">
        <h2 class="text-xl sm:text-2xl font-bold text-ink mb-4">How to Measure for UK Bras</h2>
        <p class="mb-4">
          UK sizing works best with <strong>Modern Direct Underbust Measurement</strong> (no adding 4 inches):
        </p>
        <ol class="list-decimal pl-5 space-y-2 text-xs sm:text-sm mb-6">
          <li>Measure your underbust snugly in inches. Round to nearest even number for your band size.</li>
          <li>Measure your bust loosely across the fullest point in inches.</li>
          <li>Subtract underbust from bust. Each 1-inch difference represents one UK cup letter (1" = A, 2" = B, 3" = C, 4" = D, 5" = DD, 6" = E, 7" = F, 8" = FF, 9" = G).</li>
        </ol>

        <a href="/how-to-measure" class="text-primary font-semibold hover:underline text-xs sm:text-sm">Read full illustrated measurement instructions &rarr;</a>
      </section>
    </div>
  </main>
  <Footer />
</Layout>
