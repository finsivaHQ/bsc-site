---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { BAND_CONVERSION_MATRIX, CUP_CONVERSION_MATRIX } from '../utils/braSizing';

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How do I read an international bra size chart?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Locate your snug underbust measurement in either inches or centimeters on the band matrix row. This reveals your equivalent band size across regions (e.g. 34 in US/UK = 75 in EU = 90 in FR = 12 in AU). Next, locate your bust-to-band delta in the cup matrix to find your regional cup letter. Combine the two for your final converted size."
      }
    },
    {
      "@type": "Question",
      "name": "Why do Asian bra sizes (Japan, Hong Kong, Korea, Singapore) use metric band numbers?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Asian bra sizing systems (such as Japan JIS L 4006 and South Korea KS K 9404) follow metric EN 13402 specifications. They use your literal underbust measurement in centimeters for band numbers (such as 65, 70, 75, 80) and calculate cups using 2.5 cm delta increments, making it one of the most logically consistent systems."
      }
    },
    {
      "@type": "Question",
      "name": "Are UK and US bra sizes the same?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Up to a DD cup, UK and US bra sizes are identical. However, after a DD cup, the sizing systems diverge significantly and cause a lot of confusion. The UK system uses double letters consistently (DD, E, F, FF, G, GG), while the US system often uses multiple Ds (DDD) and skips double letters (G, H, I). Always check the brand's country of origin."
      }
    },
    {
      "@type": "Question",
      "name": "Why does the same size fit differently depending on the brand?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Beyond regional sizing differences, brands use unique design blocks, specific fit models, and varying fabric stretch levels. A stretchy lace band feels different from a rigid mesh one, even if cut exactly the same. Manufacturing tolerances and dye shrinkage (like with black dyes) also cause variations. Your size is a starting point, not a guarantee."
      }
    },
    {
      "@type": "Question",
      "name": "How can I tell if my bra cup is too small?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Signs of a too-small cup include breast tissue spilling over the top edge (causing a \"quad-boob\" effect), tissue escaping at the underarms, or the underwire resting on breast tissue instead of sitting flat against your ribcage. If you experience these, try going up one or two cup volumes."
      }
    },
    {
      "@type": "Question",
      "name": "What exactly is sister sizing?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sister sizes hold the exact same cup volume, but are attached to different band sizes. For example, the cup of a 34C holds the same volume as a 36B or a 32D. If a band is too tight but the cup volume fits perfectly, you go up a band size and down a cup size (e.g., 34C to 36B) to maintain the exact same volume."
      }
    },
    {
      "@type": "Question",
      "name": "Is a D cup the same size on every band?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Absolutely not. Cup sizes are not static volumes; they represent a ratio or difference between your bust and underbust measurements. A 32D is significantly smaller in overall volume than a 40D. The letter only tells you the relative proportion to the band, not the absolute size of the cup."
      }
    },
    {
      "@type": "Question",
      "name": "How often should I measure my bra size?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We recommend checking your measurements every six months, or whenever you experience significant life changes. Weight fluctuations, pregnancy, nursing, hormonal shifts, and starting new fitness routines can all alter your breast shape and ribcage size. Your body naturally evolves over time, and your bras should keep up."
      }
    }
  ]
};
---

<Layout 
  title="Bra Size Chart — US, UK, EU, AU, JP, IN, HK, South Korea, SG & International Conversion Guide | BraSizeChecker"
  description="Comprehensive international bra size chart. Compare US, UK, EU, FR, AU, JP, IN, HK, South Korea, and Singapore band and cup sizes."
  canonical="https://brasizechecker.com/bra-size-chart"
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <Header />
  <main class="flex-1 w-full max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 md:py-16">
    <Breadcrumbs items={[{ label: 'Bra Size Chart' }]} />

    <!-- Page Header / Intro -->
    <header class="mb-10 text-center sm:text-left">
      <span class="inline-block py-1 px-3 rounded-full bg-canvas-soft-2 border border-hairline text-xs font-semibold uppercase tracking-widest text-primary mb-3">
        Master Reference Guide
      </span>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-ink tracking-tight mb-4">
        Master Bra Size Chart: US, UK, EU, AU, JP, IN & International Matrix
      </h1>
      <div class="flex items-center gap-3 text-xs text-mute mb-4 justify-center sm:justify-start">
        <span>By BraSizeChecker Editorial Guide</span>
        <span>&bull;</span>
        <time datetime="2026-09-04">Updated September 2026</time>
      </div>
      <p class="text-base sm:text-lg text-body leading-relaxed max-w-3xl mb-5">
        Let's be incredibly honest for a moment: navigating the tangled web of international bra sizes is utterly exhausting. You finally find a bra that makes you feel supported, confident, and comfortable, only to realize it's from a UK brand while you live in the US, or it's a European label that uses a completely different numbering system. Suddenly, the size that fits you perfectly in one store is entirely wrong in another. It’s enough to make anyone want to give up and live in sports bras forever.
      </p>
      <p class="text-base sm:text-lg text-body leading-relaxed max-w-3xl mb-5">
        If you’ve ever felt like you need a mathematics degree just to decode a bra tag, you are not alone. Millions of women and bra-wearers experience this exact same frustration every single day. The sizing systems across the world evolved independently, leading to a chaotic overlap of inches, centimeters, and mismatched cup letters. It's not your body that is the problem—it is a deeply flawed, historically disjointed apparel industry. But we believe that finding a bra that fits your unique body shouldn't feel like a punishment. 
      </p>
      <p class="text-base sm:text-lg text-body leading-relaxed max-w-3xl">
        Every bra size consists of two crucial elements: a <strong>band number</strong> (representing the circumference of your ribcage, the true foundation of support) and a <strong>cup letter</strong> (representing the volume displacement of your breast tissue). To take the guesswork out of your shopping experience, we’ve developed the ultimate Master Bra Size Chart below. You can seamlessly cross-reference sizes across 10 major global regions, ensuring you find your perfect fit no matter where your favorite lingerie originates.
      </p>
    </header>

    <!-- Interactive Conversion Chart Tool -->
    <section class="bg-surface border border-hairline rounded-2xl shadow-sm p-4 sm:p-6 md:p-8 mb-12" aria-labelledby="chart-heading">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6 pb-4 border-b border-hairline">
        <div>
          <h2 id="chart-heading" class="text-xl sm:text-2xl font-bold text-ink">International Size Conversion Matrices</h2>
          <p class="text-xs sm:text-sm text-body mt-1">Search or filter below to highlight equivalent band and cup sizes across regions.</p>
        </div>

        <!-- Filter Input -->
        <div class="w-full md:w-64 flex-shrink-0">
          <label for="page-matrix-search" class="sr-only">Search size</label>
          <div class="relative">
            <input 
              type="text" 
              id="page-matrix-search" 
              placeholder="Search size (e.g. 34, DD, 75)..." 
              class="w-full h-10 px-3.5 pl-9 bg-canvas border border-hairline rounded-xl text-xs text-ink placeholder:text-mute/60 focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/20 transition-all duration-200"
            />
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-mute absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
          </div>
        </div>
      </div>

      <!-- Band Matrix Table -->
      <div class="mb-8">
        <h3 class="text-xs sm:text-sm font-bold text-primary uppercase tracking-wider mb-3 flex items-center justify-between">
          <span>Band Size Conversion Matrix</span>
          <span class="text-[11px] text-mute font-normal">US / UK / EU / FR / AU / JP / IN / HK / KR / SG</span>
        </h3>
        <div class="overflow-x-auto -mx-2 px-2 max-h-[380px] rounded-xl border border-hairline">
          <table class="w-full text-left text-xs sm:text-sm text-body min-w-[720px] border-collapse relative">
            <thead class="sticky top-0 bg-canvas-soft-2 text-ink shadow-2xs z-10">
              <tr class="border-b border-hairline">
                <th scope="col" class="py-3 px-3.5 font-semibold">US / CA</th>
                <th scope="col" class="py-3 px-3.5 font-semibold">UK</th>
                <th scope="col" class="py-3 px-3.5 font-semibold">EU</th>
                <th scope="col" class="py-3 px-3.5 font-semibold">FR / BE / ES</th>
                <th scope="col" class="py-3 px-3.5 font-semibold">AU / NZ</th>
                <th scope="col" class="py-3 px-3.5 font-semibold">JP</th>
                <th scope="col" class="py-3 px-3.5 font-semibold">India (IN)</th>
                <th scope="col" class="py-3 px-3.5 font-semibold">Hong Kong (HK)</th>
                <th scope="col" class="py-3 px-3.5 font-semibold">South Korea (KR)</th>
                <th scope="col" class="py-3 px-3.5 font-semibold">Singapore (SG)</th>
              </tr>
            </thead>
            <tbody id="page-band-matrix-body" class="divide-y divide-hairline bg-surface">
              {BAND_CONVERSION_MATRIX.map(row => (
                <tr class="transition-colors hover:bg-canvas-soft-2/50">
                  <th scope="row" class="py-3 px-3.5 font-semibold text-ink">{row.us}</th>
                  <td class="py-3 px-3.5">{row.uk}</td>
                  <td class="py-3 px-3.5">{row.eu}</td>
                  <td class="py-3 px-3.5">{row.fr}</td>
                  <td class="py-3 px-3.5">{row.au}</td>
                  <td class="py-3 px-3.5">{row.jp}</td>
                  <td class="py-3 px-3.5">{row.in}</td>
                  <td class="py-3 px-3.5">{row.hk}</td>
                  <td class="py-3 px-3.5">{row.kr}</td>
                  <td class="py-3 px-3.5">{row.sg}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <!-- Cup Matrix Table -->
      <div>
        <h3 class="text-xs sm:text-sm font-bold text-primary uppercase tracking-wider mb-3 flex items-center justify-between">
          <span>Cup Size Conversion Matrix</span>
          <span class="text-[11px] text-mute font-normal">US / UK / EU / AU / JP / IN / HK / KR / SG</span>
        </h3>
        <div class="overflow-x-auto -mx-2 px-2 max-h-[440px] rounded-xl border border-hairline">
          <table class="w-full text-left text-xs sm:text-sm text-body min-w-[720px] border-collapse relative">
            <thead class="sticky top-0 bg-canvas-soft-2 text-ink shadow-2xs z-10">
              <tr class="border-b border-hairline">
                <th scope="col" class="py-3 px-3.5 font-semibold">US / CA</th>
                <th scope="col" class="py-3 px-3.5 font-semibold">UK</th>
                <th scope="col" class="py-3 px-3.5 font-semibold">EU</th>
                <th scope="col" class="py-3 px-3.5 font-semibold">AU / NZ</th>
                <th scope="col" class="py-3 px-3.5 font-semibold">JP</th>
                <th scope="col" class="py-3 px-3.5 font-semibold">India (IN)</th>
                <th scope="col" class="py-3 px-3.5 font-semibold">Hong Kong (HK)</th>
                <th scope="col" class="py-3 px-3.5 font-semibold">South Korea (KR)</th>
                <th scope="col" class="py-3 px-3.5 font-semibold">Singapore (SG)</th>
              </tr>
            </thead>
            <tbody id="page-cup-matrix-body" class="divide-y divide-hairline bg-surface">
              {CUP_CONVERSION_MATRIX.map(row => (
                <tr class="transition-colors hover:bg-canvas-soft-2/50">
                  <th scope="row" class="py-3 px-3.5 font-semibold text-ink">{row.us}</th>
                  <td class="py-3 px-3.5">{row.uk}</td>
                  <td class="py-3 px-3.5">{row.eu}</td>
                  <td class="py-3 px-3.5">{row.au}</td>
                  <td class="py-3 px-3.5">{row.jp}</td>
                  <td class="py-3 px-3.5">{row.in}</td>
                  <td class="py-3 px-3.5">{row.hk}</td>
                  <td class="py-3 px-3.5">{row.kr}</td>
                  <td class="py-3 px-3.5">{row.sg}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Educational Sections (Expanded Content) -->
    <div class="space-y-10 text-body leading-relaxed text-sm sm:text-base">
      
      <!-- Section 1: How to Measure & Read Chart -->
      <section class="bg-surface border border-hairline rounded-2xl p-6 sm:p-8">
        <h2 class="text-xl sm:text-2xl font-bold text-ink mb-4">1. How to Read & Use This Master Chart</h2>
        <p class="mb-5">
          Looking at a grid full of numbers and letters can feel overwhelming. Take a deep breath. You are completely capable of figuring this out, and we are here to hold your hand through the process. The chart above acts as a decoder ring for the entire bra industry. Once you have your baseline measurements, using this matrix becomes second nature. Follow these simple steps to confidently locate your size:
        </p>
        <ol class="list-decimal pl-5 space-y-4 text-xs sm:text-sm mb-6">
          <li>
            <strong>Find Your Band Row:</strong> Think of the band as the foundation of a house; if it's unstable, nothing else will work correctly. Up to 80% of your bra's support should come from the band around your ribcage, not the shoulder straps. Locate your snug underbust measurement in either inches or centimeters on the Band Size Conversion Matrix above. For instance, if you measure 34 inches, you would look across that row to see that your European size is 75, your French size is 90, and your Australian size is 12.
          </li>
          <li>
            <strong>Find Your Cup Column:</strong> Your cup size isn't a static bowl; it's a dynamic ratio. It represents the difference between your full bust measurement and your underbust measurement. Locate your calculated bust-to-band delta in the Cup Size Conversion Matrix to identify your regional letter. This is where sizes often diverge wildly—a DD in the US is very different from an E in Europe.
          </li>
          <li>
            <strong>Cross-Reference Your Destination Region:</strong> Now that you have both your converted band and cup, simply combine them. Read horizontally across the row to find your target country's equivalent size tag. So, a US 34DD might become a UK 34DD, but in France, it would be labeled a 90E.
          </li>
        </ol>
        <p class="mb-2">
          <strong>A quick pro-tip:</strong> When in doubt, always look at the brand's country of origin. A bra designed by a British brand will be manufactured using UK sizing standards, even if you are buying it in a boutique in New York, Tokyo, or Sydney.
        </p>
      </section>

      <!-- Section 1.5: The Psychology & Reality of Sizing (New E-E-A-T Section) -->
      <section class="bg-surface border border-hairline rounded-2xl p-6 sm:p-8">
        <h2 class="text-xl sm:text-2xl font-bold text-ink mb-4">The Truth About Bra Sizing Variations</h2>
        <p class="mb-5">
          It is completely normal to feel frustrated when a 36D fits perfectly in one brand, but you can barely hook a 36D in another. We want to validate that experience: you aren't doing anything wrong, and your body isn't "weird." The lingerie industry is notoriously inconsistent. Brands use entirely different fit models to create their base patterns (known in the industry as blocks). If a brand's fit model has wider-set breasts or a broader ribcage, their cups will be constructed differently than a brand using a model with close-set, high-profile breasts.
        </p>
        <p class="mb-5">
          Additionally, fabrics play a massive role in how a garment performs on your body. A stretchy lace band will feel entirely different from a rigid satin or strong powermesh one, even if they are cut to the exact same measurements. Did you know that darker dyes (like black, navy, or deep reds) can sometimes shrink fabrics slightly during the manufacturing process? This is a little-known secret that explains why a black bra often feels tighter than the exact same bra in a beige or pastel color. 
        </p>
        <p>
          Always remember that the size on the tag is merely a starting point—a helpful suggestion from the manufacturer. Your ultimate goal is comfort, support, and feeling great in your clothes. If you need to size up or down to achieve that feeling, do it without a second thought. The tag doesn't define your body; your comfort dictates the fit.
        </p>
      </section>

      <!-- Section 1.8: Common Fit Issues & Troubleshooting (New E-E-A-T Section) -->
      <section class="bg-surface border border-hairline rounded-2xl p-6 sm:p-8">
        <h2 class="text-xl sm:text-2xl font-bold text-ink mb-4">Troubleshooting Common Fit Issues</h2>
        <p class="mb-5">
          Finding your size on a chart is just the beginning of the journey. Once you actually put the bra on, your body will tell you the real story. Let's talk about some of the most common fit issues and how you can troubleshoot them effectively. Remember, it is the garment's job to fit you, not your job to squeeze into the garment.
        </p>
        
        <h3 class="font-bold text-lg text-ink mt-6 mb-2">The Band Rides Up Your Back</h3>
        <p class="mb-5">
          If the back band of your bra is forming an inverted "U" shape and riding up toward your shoulder blades, the band is too loose. A loose band forces the shoulder straps to carry the heavy weight of your breasts, which leads to painful shoulder indentations, tension headaches, and neck strain. Try going down one band size. Because you are decreasing the band size, remember to use the Sister Size principle and go up one cup size to maintain the same breast volume (e.g., switch from a 36C to a 34D).
        </p>

        <h3 class="font-bold text-lg text-ink mt-6 mb-2">The Center Gore Doesn't Sit Flat</h3>
        <p class="mb-5">
          The center gore is the small piece of fabric and underwire that sits right between your breasts. In a well-fitting underwired bra, this gore should tack completely flat against your sternum. If it is floating away from your chest, or sitting on top of your breast tissue, it is a glaring indicator that the cups are too small. Your breasts are actively pushing the cups outward, pulling the gore away from your body. You will likely need to go up at least one cup size, and sometimes two, to give your tissue enough room to settle.
        </p>

        <h3 class="font-bold text-lg text-ink mt-6 mb-2">Straps Are Constantly Slipping</h3>
        <p class="mb-5">
          Slipping straps can be absolutely infuriating, especially if you have narrow or sloping shoulders. However, they are also a key sign of a band that is too large. When the band is too loose, the straps are positioned wider apart on your back, making them far more likely to slide off. Sizing down in the band often brings the straps closer together. If you've corrected your band size and still experience slipping, look for "racerback" styles, or bras with fully adjustable straps, as well as styles designed with "leotard" (U-shaped) backs.
        </p>

        <h3 class="font-bold text-lg text-ink mt-6 mb-2">The Cups Are Wrinkling or Gaping</h3>
        <p class="mb-4">
          When you notice empty space, wrinkling, or gaping at the top or sides of your cups, the instinct is usually to assume the cup is too large. Often, this is correct—you simply need to drop down a cup volume. But occasionally, gaping happens when the cup is actually too small or the wrong shape! If a cup is too shallow for your breast shape (often the case with molded seamless "T-shirt" bras), your breast will push the bra away from your chest, creating a gap at the top. If sizing down doesn't fix the issue, you may need to try a seamed, unlined bra that accommodates more natural projection.
        </p>
      </section>

      <!-- Section 2: Related Tools -->
      <section class="bg-surface border border-hairline rounded-2xl p-6 sm:p-8">
        <h2 class="text-xl sm:text-2xl font-bold text-ink mb-4">Interactive Tools & Calculators</h2>
        <p class="mb-6">
          Still feeling unsure? You don't have to do the complex math in your head. We've built an entire suite of intuitive tools designed to take the mental load off your shoulders. Whether you need to calculate your size from scratch or figure out your sister sizes for a tricky brand, our main Hub pages have you covered. Use these resources to verify your fit.
        </p>
        <div class="flex flex-wrap gap-3">
          <a href="/#calculator" class="px-5 py-2.5 bg-primary text-white font-bold text-xs rounded-xl hover:bg-primary-hover transition-colors shadow-2xs">
            Primary Calculator Tool &rarr;
          </a>
          <a href="/bra-size-converter/" class="px-5 py-2.5 bg-surface border border-hairline text-ink font-semibold text-xs rounded-xl hover:bg-canvas-soft-2 transition-colors shadow-2xs">
            Bra Size Converter &rarr;
          </a>
          <a href="/sister-size-calculator/" class="px-5 py-2.5 bg-surface border border-hairline text-ink font-semibold text-xs rounded-xl hover:bg-canvas-soft-2 transition-colors shadow-2xs">
            Sister Size Matrix &rarr;
          </a>
        </div>
      </section>

      <!-- Section 3: FAQ Section -->
      <section class="bg-surface border border-hairline rounded-2xl p-6 sm:p-8">
        <h2 class="text-xl sm:text-2xl font-bold text-ink mb-6">Frequently Asked Questions</h2>
        <p class="mb-6 text-sm text-body">
          We hear these questions all the time from people just like you who are trying to make sense of the chaos. Here are our most honest, straightforward answers to help you navigate the complexities of bra fitting.
        </p>
        <div class="space-y-4">
          {faqSchema.mainEntity.map(item => (
            <details class="bg-canvas border border-hairline rounded-xl p-5 cursor-pointer group">
              <summary class="font-bold text-ink flex justify-between items-center list-none">
                <span>{item.name}</span>
                <span class="text-primary group-open:rotate-180 transition-transform">&darr;</span>
              </summary>
              <p class="mt-4 text-body text-xs sm:text-sm leading-relaxed">{item.acceptedAnswer.text}</p>
            </details>
          ))}
        </div>
      </section>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener('astro:page-load', () => {
    const searchInput = document.getElementById('page-matrix-search') as HTMLInputElement;
    const bandRows = document.querySelectorAll('#page-band-matrix-body tr');
    const cupRows = document.querySelectorAll('#page-cup-matrix-body tr');

    if (searchInput) {
      searchInput.addEventListener('input', () => {
        const query = searchInput.value.trim().toLowerCase();

        function filterRows(rows: NodeListOf<Element>) {
          rows.forEach(row => {
            const text = row.textContent?.toLowerCase() || '';
            if (!query || text.includes(query)) {
              (row as HTMLElement).style.display = '';
              if (query && text.includes(query)) {
                (row as HTMLElement).classList.add('bg-accent/15');
              } else {
                (row as HTMLElement).classList.remove('bg-accent/15');
              }
            } else {
              (row as HTMLElement).style.display = 'none';
            }
          });
        }

        filterRows(bandRows);
        filterRows(cupRows);
      });
    }
  });
</script>
