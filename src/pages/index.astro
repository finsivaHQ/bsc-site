---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Calculator from '../components/Calculator.astro';
import HowToMeasure from '../components/HowToMeasure.astro';
import FitGuide from '../components/FitGuide.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Bra Size Calculator | Precision Fit in Minutes">
  <Header />
  
  <div class="w-full text-center py-2 bg-canvas-soft border-b border-hairline text-xs font-mono text-mute">
    hello bro
  </div>
  
  <main class="flex-1 w-full flex flex-col items-center">
    <!-- Hero / Calculator Section -->
    <div class="relative w-full flex flex-col items-center pt-8 pb-16 overflow-hidden">
      <!-- Vercel-style mesh gradient background (subtle) -->
      <div class="absolute inset-0 -z-10 opacity-30 blur-[100px] pointer-events-none flex justify-center">
        <div class="w-1/3 h-64 bg-cyan/40 rounded-full mix-blend-multiply translate-x-1/2"></div>
        <div class="w-1/3 h-64 bg-highlight-pink/40 rounded-full mix-blend-multiply -translate-x-1/2"></div>
        <div class="w-1/3 h-64 bg-warning/40 rounded-full mix-blend-multiply translate-y-1/2"></div>
      </div>
      
      <Calculator />
    </div>

    <!-- How To Measure -->
    <div class="w-full bg-canvas-soft-2">
      <HowToMeasure />
    </div>

    <!-- Fit Diagnostic -->
    <div class="w-full bg-canvas-soft">
      <FitGuide />
    </div>

    <!-- FAQ -->
    <div class="w-full bg-canvas-soft-2">
      <FAQ />
    </div>
  </main>

  <Footer />
</Layout>
