              <td class="py-2.5 px-3.5">34B</td>
            </tr>
            <tr>
              <th scope="row" class="py-2.5 px-3.5 font-semibold text-ink">Tier 2 (~710cc)</th>
              <td class="py-2.5 px-3.5">28G</td>
              <td class="py-2.5 px-3.5">32E (UK)</td>
              <td class="py-2.5 px-3.5">36D</td>
