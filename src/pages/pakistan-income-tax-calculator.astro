---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="Pakistan Income Tax Calculator (FBR Tax Year 2024-2025 / 2025-2026) | Free Tax Tool"
  description="Calculate your FBR Pakistan income tax online for free. Interactive tax calculator for salaried and non-salaried individuals with monthly and annual tax breakdown."
>
  <Header />

  <main class="w-full max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">
    <!-- Hero Header -->
    <div class="text-center mb-12">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-primary/10 text-primary mb-4">
        Official FBR Slabs Updated
      </span>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-ink leading-tight tracking-tight mb-4">
        Pakistan Income Tax Calculator
      </h1>
      <p class="text-body text-base md:text-lg max-w-2xl mx-auto">
        Calculate your annual and monthly income tax under official Federal Board of Revenue (FBR) tax rates for salaried and business individuals.
      </p>
    </div>

    <!-- Calculator Card -->
    <div class="bg-surface border border-hairline rounded-3xl p-6 sm:p-8 md:p-10 shadow-sm mb-16">
      <form id="tax-calc-form" class="space-y-6" onsubmit="event.preventDefault();">
        <!-- Employment Type Switch -->
        <div>
          <label class="block text-sm font-bold text-ink mb-2">Category / Status</label>
          <div class="grid grid-cols-2 gap-3">
            <button type="button" id="type-salaried" class="type-btn active py-3 px-4 rounded-xl border border-primary bg-primary text-white font-semibold text-sm transition-colors cursor-pointer">
              💼 Salaried Individual
            </button>
            <button type="button" id="type-nonsalaried" class="type-btn py-3 px-4 rounded-xl border border-hairline bg-surface text-body font-semibold text-sm hover:border-primary/50 transition-colors cursor-pointer">
              🏢 Non-Salaried / Business
            </button>
          </div>
          <input type="hidden" id="emp-type" value="salaried" />
        </div>

        <!-- Income Period Switch & Amount Input -->
        <div class="grid sm:grid-cols-3 gap-4">
          <div class="sm:col-span-1">
            <label for="income-period" class="block text-sm font-bold text-ink mb-2">Income Period</label>
            <select id="income-period" class="w-full bg-canvas border border-hairline rounded-xl px-4 py-3 text-ink text-sm font-medium focus:outline-none focus:border-primary">
              <option value="monthly" selected>Monthly (PKR)</option>
              <option value="annual">Annual (PKR)</option>
            </select>
          </div>
          <div class="sm:col-span-2">
            <label for="income-amount" class="block text-sm font-bold text-ink mb-2">Income Amount (PKR)</label>
            <div class="relative">
              <span class="absolute left-4 top-1/2 -translate-y-1/2 text-mute font-medium text-sm">Rs.</span>
              <input 
                type="number" 
                id="income-amount" 
                placeholder="e.g. 150000" 
                min="0" 
                step="1000"
                class="w-full bg-canvas border border-hairline rounded-xl pl-12 pr-4 py-3 text-ink text-base font-semibold focus:outline-none focus:border-primary"
              />
            </div>
          </div>
        </div>

        <button 
          type="button" 
          id="btn-calculate" 
          class="w-full bg-primary text-white font-bold py-4 rounded-xl hover:bg-primary-hover transition-colors shadow-md text-base cursor-pointer"
        >
          Calculate Tax Liability
        </button>
      </form>

      <!-- Results Card -->
      <div id="results-box" class="hidden mt-10 pt-8 border-t border-hairline space-y-6">
        <h3 class="text-xl font-bold text-ink mb-4">Calculation Summary</h3>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
          <div class="bg-canvas p-4 rounded-2xl border border-hairline">
            <span class="text-xs font-semibold text-mute uppercase tracking-wider block mb-1">Gross Annual</span>
            <span id="res-annual-gross" class="text-lg font-bold text-ink">Rs. 0</span>
          </div>
          <div class="bg-canvas p-4 rounded-2xl border border-hairline">
            <span class="text-xs font-semibold text-mute uppercase tracking-wider block mb-1">Annual Tax</span>
            <span id="res-annual-tax" class="text-lg font-bold text-primary">Rs. 0</span>
          </div>
          <div class="bg-canvas p-4 rounded-2xl border border-hairline">
            <span class="text-xs font-semibold text-mute uppercase tracking-wider block mb-1">Monthly Tax</span>
            <span id="res-monthly-tax" class="text-lg font-bold text-primary">Rs. 0</span>
          </div>
          <div class="bg-canvas p-4 rounded-2xl border border-hairline">
            <span class="text-xs font-semibold text-mute uppercase tracking-wider block mb-1">Monthly Take-Home</span>
            <span id="res-monthly-net" class="text-lg font-bold text-green-600 dark:text-green-400">Rs. 0</span>
          </div>
        </div>

        <div class="bg-canvas-soft-2 p-5 rounded-2xl border border-hairline text-sm text-body leading-relaxed">
          <p id="res-detail-text">Input your income above to calculate official FBR tax deductions.</p>
        </div>
      </div>
    </div>

    <!-- Official FBR Tax Slabs Reference -->
    <div class="space-y-8 mb-16">
      <h2 class="text-2xl font-bold text-ink">FBR Income Tax Slabs Overview</h2>
      
      <div class="grid md:grid-cols-2 gap-6">
        <!-- Salaried Slabs Table -->
        <div class="bg-surface border border-hairline rounded-2xl p-5">
          <h3 class="font-bold text-ink text-lg mb-3">Salaried Slabs (Salary >= 75% of Income)</h3>
          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs text-body border-collapse">
              <thead>
                <tr class="border-b border-hairline text-ink font-semibold">
                  <th class="py-2">Annual Income (PKR)</th>
                  <th class="py-2">Tax Rate / Fixed Amount</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-hairline">
                <tr><td class="py-2">0 to 600,000</td><td class="py-2 font-bold text-green-600">0% (Tax Free)</td></tr>
                <tr><td class="py-2">600,001 to 1,200,000</td><td class="py-2">5% of amount > 600k</td></tr>
                <tr><td class="py-2">1,200,001 to 2,200,000</td><td class="py-2">Rs. 30,000 + 15% > 1.2M</td></tr>
                <tr><td class="py-2">2,200,001 to 3,200,000</td><td class="py-2">Rs. 180,000 + 25% > 2.2M</td></tr>
                <tr><td class="py-2">3,200,001 to 4,100,000</td><td class="py-2">Rs. 430,000 + 30% > 3.2M</td></tr>
                <tr><td class="py-2">Above 4,100,000</td><td class="py-2">Rs. 700,000 + 35% > 4.1M</td></tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Non-Salaried Slabs Table -->
        <div class="bg-surface border border-hairline rounded-2xl p-5">
          <h3 class="font-bold text-ink text-lg mb-3">Non-Salaried / Business Slabs</h3>
          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs text-body border-collapse">
              <thead>
                <tr class="border-b border-hairline text-ink font-semibold">
                  <th class="py-2">Annual Income (PKR)</th>
                  <th class="py-2">Tax Rate / Fixed Amount</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-hairline">
                <tr><td class="py-2">0 to 600,000</td><td class="py-2 font-bold text-green-600">0% (Tax Free)</td></tr>
                <tr><td class="py-2">600,001 to 1,200,000</td><td class="py-2">15% of amount > 600k</td></tr>
                <tr><td class="py-2">1,200,001 to 1,600,000</td><td class="py-2">Rs. 90,000 + 20% > 1.2M</td></tr>
                <tr><td class="py-2">1,600,001 to 3,200,000</td><td class="py-2">Rs. 170,000 + 30% > 1.6M</td></tr>
                <tr><td class="py-2">3,200,001 to 5,600,000</td><td class="py-2">Rs. 650,000 + 40% > 3.2M</td></tr>
                <tr><td class="py-2">Above 5,600,000</td><td class="py-2">Rs. 1,610,000 + 45% > 5.6M</td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <!-- Related Articles Grid -->
    <div class="border-t border-hairline pt-12">
      <h3 class="text-2xl font-bold text-ink mb-6">Learn More About Pakistan Income Tax</h3>
      <div class="grid sm:grid-cols-2 gap-6">
        <a href="/blog/pakistan-income-tax-rates-slabs-guide" class="group block bg-surface border border-hairline rounded-2xl p-5 hover:border-primary/50 transition-colors">
          <span class="text-xs font-bold text-primary uppercase tracking-wider mb-2 block">Tax Rates Guide</span>
          <h4 class="font-bold text-ink text-lg group-hover:text-primary transition-colors mb-2">What Is Pakistan Income Tax? Complete Rates & Slabs Guide</h4>
          <p class="text-sm text-body line-clamp-2">Detailed breakdown of FBR tax bands, tax-free thresholds, and income tax calculations in Pakistan.</p>
        </a>
        <a href="/blog/overseas-pakistani-tax-exemption-guide" class="group block bg-surface border border-hairline rounded-2xl p-5 hover:border-primary/50 transition-colors">
          <span class="text-xs font-bold text-primary uppercase tracking-wider mb-2 block">Overseas Tax Rules</span>
          <h4 class="font-bold text-ink text-lg group-hover:text-primary transition-colors mb-2">Are Overseas Pakistanis Exempt From Income Tax?</h4>
          <p class="text-sm text-body line-clamp-2">Learn Section 82 tax residency rules, foreign remittance tax exemptions, and Roshan Digital Account benefits.</p>
        </a>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  document.addEventListener('astro:page-load', () => {
    const btnSalaried = document.getElementById('type-salaried');
    const btnNonSalaried = document.getElementById('type-nonsalaried');
    const empTypeInput = document.getElementById('emp-type') as HTMLInputElement;
    const btnCalc = document.getElementById('btn-calculate');
    const incomeAmountInput = document.getElementById('income-amount') as HTMLInputElement;
    const incomePeriodSelect = document.getElementById('income-period') as HTMLSelectElement;
    
    const resultsBox = document.getElementById('results-box');
    const resAnnualGross = document.getElementById('res-annual-gross');
    const resAnnualTax = document.getElementById('res-annual-tax');
    const resMonthlyTax = document.getElementById('res-monthly-tax');
    const resMonthlyNet = document.getElementById('res-monthly-net');
    const resDetailText = document.getElementById('res-detail-text');

    if (btnSalaried && btnNonSalaried && empTypeInput) {
      btnSalaried.addEventListener('click', () => {
        empTypeInput.value = 'salaried';
        btnSalaried.className = 'type-btn active py-3 px-4 rounded-xl border border-primary bg-primary text-white font-semibold text-sm transition-colors cursor-pointer';
        btnNonSalaried.className = 'type-btn py-3 px-4 rounded-xl border border-hairline bg-surface text-body font-semibold text-sm hover:border-primary/50 transition-colors cursor-pointer';
      });

      btnNonSalaried.addEventListener('click', () => {
        empTypeInput.value = 'nonsalaried';
        btnNonSalaried.className = 'type-btn active py-3 px-4 rounded-xl border border-primary bg-primary text-white font-semibold text-sm transition-colors cursor-pointer';
        btnSalaried.className = 'type-btn py-3 px-4 rounded-xl border border-hairline bg-surface text-body font-semibold text-sm hover:border-primary/50 transition-colors cursor-pointer';
      });
    }

    function calculateTax() {
      if (!incomeAmountInput || !incomePeriodSelect || !empTypeInput) return;
      const amount = parseFloat(incomeAmountInput.value) || 0;
      if (amount <= 0) return;

      const isMonthly = incomePeriodSelect.value === 'monthly';
      const annualGross = isMonthly ? amount * 12 : amount;
      const empType = empTypeInput.value;

      let annualTax = 0;
      let breakdownNote = '';

      if (empType === 'salaried') {
        if (annualGross <= 600000) {
          annualTax = 0;
          breakdownNote = 'Your annual income of Rs. ' + annualGross.toLocaleString() + ' falls below the basic tax-free threshold of Rs. 600,000. You owe 0% income tax.';
        } else if (annualGross <= 1200000) {
          annualTax = (annualGross - 600000) * 0.05;
          breakdownNote = 'Tax calculated at 5% on the amount exceeding Rs. 600,000.';
        } else if (annualGross <= 2200000) {
          annualTax = 30000 + (annualGross - 1200000) * 0.15;
          breakdownNote = 'Fixed tax of Rs. 30,000 plus 15% on the amount exceeding Rs. 1,200,000.';
        } else if (annualGross <= 3200000) {
          annualTax = 180000 + (annualGross - 2200000) * 0.25;
          breakdownNote = 'Fixed tax of Rs. 180,000 plus 25% on the amount exceeding Rs. 2,200,000.';
        } else if (annualGross <= 4100000) {
          annualTax = 430000 + (annualGross - 3200000) * 0.30;
          breakdownNote = 'Fixed tax of Rs. 430,000 plus 30% on the amount exceeding Rs. 3,200,000.';
        } else {
          annualTax = 700000 + (annualGross - 4100000) * 0.35;
          breakdownNote = 'Fixed tax of Rs. 700,000 plus 35% on the amount exceeding Rs. 4,100,000.';
        }
      } else {
        // Non-Salaried / Business Slabs
        if (annualGross <= 600000) {
          annualTax = 0;
          breakdownNote = 'Your annual business/non-salaried income falls within the tax-free limit of Rs. 600,000.';
        } else if (annualGross <= 1200000) {
          annualTax = (annualGross - 600000) * 0.15;
          breakdownNote = 'Tax calculated at 15% on the amount exceeding Rs. 600,000.';
        } else if (annualGross <= 1600000) {
          annualTax = 90000 + (annualGross - 1200000) * 0.20;
          breakdownNote = 'Fixed tax of Rs. 90,000 plus 20% on the amount exceeding Rs. 1,200,000.';
        } else if (annualGross <= 3200000) {
          annualTax = 170000 + (annualGross - 1600000) * 0.30;
          breakdownNote = 'Fixed tax of Rs. 170,000 plus 30% on the amount exceeding Rs. 1,600,000.';
        } else if (annualGross <= 5600000) {
          annualTax = 650000 + (annualGross - 3200000) * 0.40;
          breakdownNote = 'Fixed tax of Rs. 650,000 plus 40% on the amount exceeding Rs. 3,200,000.';
        } else {
          annualTax = 1610000 + (annualGross - 5600000) * 0.45;
          breakdownNote = 'Fixed tax of Rs. 1,610,000 plus 45% on the amount exceeding Rs. 5,600,000.';
        }
      }

      const monthlyTax = annualTax / 12;
      const monthlyGross = annualGross / 12;
      const monthlyNet = monthlyGross - monthlyTax;

      if (resultsBox && resAnnualGross && resAnnualTax && resMonthlyTax && resMonthlyNet && resDetailText) {
        resAnnualGross.textContent = 'Rs. ' + Math.round(annualGross).toLocaleString();
        resAnnualTax.textContent = 'Rs. ' + Math.round(annualTax).toLocaleString();
        resMonthlyTax.textContent = 'Rs. ' + Math.round(monthlyTax).toLocaleString();
        resMonthlyNet.textContent = 'Rs. ' + Math.round(monthlyNet).toLocaleString();
        resDetailText.textContent = breakdownNote + ' Effective income tax rate: ' + ((annualTax / annualGross) * 100).toFixed(2) + '%.';
        resultsBox.classList.remove('hidden');
      }
    }

    if (btnCalc) {
      btnCalc.addEventListener('click', calculateTax);
    }
  });
</script>
