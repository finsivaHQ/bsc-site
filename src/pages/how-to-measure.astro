---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Should I wear a bra while taking my measurements?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "For the most accurate results, measure bare-chested or while wearing a thin, unlined non-padded bra. Do NOT measure over a padded push-up bra or thick clothing, as foam padding will add 1 to 2 artificial inches to your true bust measurement."
      }
    },
    {
      "@type": "Question",
      "name": "What is the leaning bust measurement method and when should I use it?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The leaning bust method involves bending forward at a 90-degree angle from your waist so gravity allows soft or pendulous breast tissue to hang naturally. Taking a second overbust measurement while leaning forward helps capture true total volume for softer breast tissue."
      }
    }
  ]
};
---

<Layout 
  title="How to Measure Your Bra Size at Home — Step-by-Step Guide | BraSizeChecker"
  description="Learn how to measure your bra size at home accurately in 4 simple steps. Clear underbust and bust measurement instructions, visual diagrams, and mistake fixes."
  canonical="https://brasizechecker.com/how-to-measure"
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <Header />
  <main class="flex-1 w-full max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 md:py-16">
    <Breadcrumbs items={[{ label: 'How to Measure' }]} />

    <!-- Page Header / Intro -->
    <header class="mb-10 text-center sm:text-left">
      <span class="inline-block py-1 px-3 rounded-full bg-canvas-soft-2 border border-hairline text-xs font-semibold uppercase tracking-widest text-primary mb-3">
        Illustrated Anthropometric Guide
      </span>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-ink tracking-tight mb-4">
        How to Measure Your Bra Size at Home: Master 4-Step Guide
      </h1>
      <div class="flex items-center gap-3 text-xs text-mute mb-4">
        <span>By BraSizeChecker Anthropometric Fitting Board</span>
        <span>&bull;</span>
        <time datetime="2026-09-04">Updated September 2026</time>
      </div>
      <p class="text-base sm:text-lg text-body leading-relaxed max-w-3xl">
        Establishing your true bra size takes less than three minutes using a soft fabric measuring tape. Using modern direct underbust principles, follow these four illustrated steps to determine your exact starting size without outdated +4 retail additions.
      </p>
    </header>

    <!-- Step-by-Step Guide Grid -->
    <div class="space-y-8 mb-12">
      <!-- Step 1: Measure Your Underbust -->
      <section class="bg-surface border border-hairline rounded-2xl p-5 sm:p-8 shadow-xs relative overflow-hidden" aria-labelledby="step-1-title">
        <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
          <div class="flex-1">
            <div class="flex items-center gap-3 mb-3">
              <span class="w-9 h-9 rounded-xl bg-canvas-soft-2 border border-hairline flex items-center justify-center text-primary font-bold text-sm">
                01
              </span>
              <h2 id="step-1-title" class="text-xl sm:text-2xl font-bold text-ink">Step 1: Measure Your Underbust (Band Size)</h2>
            </div>
            <p class="text-sm sm:text-base text-body leading-relaxed mb-4">
              Stand upright in front of a mirror with your shoulders relaxed. Wrap the soft measuring tape <strong>snugly</strong> around your ribcage wall, directly beneath your breast fold (the inframammary fold).
            </p>
            <ul class="list-disc pl-5 space-y-1.5 text-xs sm:text-sm text-body">
              <li><strong>Tape position:</strong> Keep the measuring tape strictly level across your back, parallel to the floor.</li>
              <li><strong>Tension:</strong> Pull the tape snug against your ribcage wall. The tape should feel firm without compressing lungs.</li>
              <li><strong>Exhalation:</strong> Exhale normally to read your neutral ribcage circumference in inches or centimeters.</li>
            </ul>
          </div>

          <!-- Visual SVG Diagram 1 -->
          <div class="w-full md:w-80 flex-shrink-0 bg-canvas border border-hairline rounded-xl p-3 text-center">
            <img 
              src="/img/measure-underbust-correct.svg" 
              alt="Vector diagram demonstrating correct level underbust tape placement snug around ribcage" 
              width="400" 
              height="240" 
              class="w-full h-auto rounded-lg" 
              loading="lazy"
            />
            <span class="text-[11px] text-mute mt-2 block font-medium">Figure 1: Correct level underbust placement</span>
          </div>
        </div>
      </section>

      <!-- Step 2: Measure Your Bust -->
      <section class="bg-surface border border-hairline rounded-2xl p-5 sm:p-8 shadow-xs relative overflow-hidden" aria-labelledby="step-2-title">
        <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
          <div class="flex-1">
            <div class="flex items-center gap-3 mb-3">
              <span class="w-9 h-9 rounded-xl bg-canvas-soft-2 border border-hairline flex items-center justify-center text-primary font-bold text-sm">
                02
              </span>
              <h2 id="step-2-title" class="text-xl sm:text-2xl font-bold text-ink">Step 2: Measure Your Full Bust (Standing & Leaning)</h2>
            </div>
            <p class="text-sm sm:text-base text-body leading-relaxed mb-4">
              Wrap the measuring tape <strong>loosely</strong> around the fullest part of your chest (across nipple apex).
            </p>
            <ul class="list-disc pl-5 space-y-1.5 text-xs sm:text-sm text-body">
              <li><strong>Tape position:</strong> Ensure the tape remains horizontal across your back without drooping downward.</li>
              <li><strong>Standing Measure:</strong> Record your standing fullest bust measurement.</li>
              <li><strong>Leaning Measure:</strong> Bend 90 degrees forward at the waist. Record a second bust measurement to capture full pendulous volume. Average the standing and leaning values if they differ by over 1 inch.</li>
            </ul>
          </div>

          <!-- Visual SVG Diagram 2 -->
          <div class="w-full md:w-80 flex-shrink-0 bg-canvas border border-hairline rounded-xl p-3 text-center">
            <img 
              src="/img/measure-bust-correct.svg" 
              alt="Vector diagram demonstrating correct loose bust tape placement across fullest point" 
              width="400" 
              height="240" 
              class="w-full h-auto rounded-lg" 
              loading="lazy"
            />
            <span class="text-[11px] text-mute mt-2 block font-medium">Figure 2: Correct loose bust placement</span>
          </div>
        </div>
      </section>

      <!-- Step 3: Enter Your Measurements CTA Card -->
      <section class="bg-canvas-soft-2 border-2 border-primary/30 rounded-2xl p-6 sm:p-8 text-center sm:text-left flex flex-col sm:flex-row items-center justify-between gap-6" aria-labelledby="step-3-title">
        <div>
          <span class="text-xs font-bold text-primary uppercase tracking-widest block mb-1">STEP 3</span>
          <h2 id="step-3-title" class="text-xl sm:text-2xl font-bold text-ink mb-1">Enter Measurements into the Calculator</h2>
          <p class="text-xs sm:text-sm text-body">Input your underbust and bust numbers into our free calculator for an instant baseline size.</p>
        </div>
        <a 
          href="/#calculator" 
          class="flex-shrink-0 h-12 px-6 bg-primary hover:bg-primary-hover text-white font-bold text-sm rounded-xl shadow-xs transition-colors flex items-center gap-2"
        >
          <span>Calculate My Size</span>
          <span>&rarr;</span>
        </a>
      </section>

      <!-- Step 4: Understand Your Results -->
      <section class="bg-surface border border-hairline rounded-2xl p-5 sm:p-8 shadow-xs" aria-labelledby="step-4-title">
        <div class="flex items-center gap-3 mb-4">
          <span class="w-9 h-9 rounded-xl bg-canvas-soft-2 border border-hairline flex items-center justify-center text-primary font-bold text-sm">
            04
          </span>
          <h2 id="step-4-title" class="text-xl sm:text-2xl font-bold text-ink">Step 4: Review Baseline & Sister Sizes</h2>
        </div>
        <p class="text-sm sm:text-base text-body leading-relaxed mb-6">
          Your calculation results display your primary baseline size alongside regional equivalents and sister sizes:
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="p-4 bg-canvas-soft-2/70 border border-hairline rounded-xl">
            <h3 class="font-bold text-ink mb-1 text-sm">1. Baseline Band & Cup</h3>
            <p class="text-xs text-body">Your primary size (e.g. 34C in US/CA sizing).</p>
          </div>

          <div class="p-4 bg-canvas-soft-2/70 border border-hairline rounded-xl">
            <h3 class="font-bold text-ink mb-1 text-sm">2. Sister Sizes Matrix</h3>
            <p class="text-xs text-body">Equivalent cup volume options for tighter or looser bands (<a href="/sister-size-calculator" class="text-primary font-semibold hover:underline">Sister Size Tool</a>).</p>
          </div>

          <div class="p-4 bg-canvas-soft-2/70 border border-hairline rounded-xl">
            <h3 class="font-bold text-ink mb-1 text-sm">3. International Equivalents</h3>
            <p class="text-xs text-body">Regional conversions for UK, EU, FR, AU, and JP (<a href="/bra-size-converter" class="text-primary font-semibold hover:underline">Converter Tool</a>).</p>
          </div>

          <div class="p-4 bg-canvas-soft-2/70 border border-hairline rounded-xl">
            <h3 class="font-bold text-ink mb-1 text-sm">4. Diagnostic Fit Guide</h3>
            <p class="text-xs text-body">Troubleshoot riding-up bands or cup gaping (<a href="/fit-guide" class="text-primary font-semibold hover:underline">Fit Guide</a>).</p>
          </div>
        </div>
      </section>
    </div>

    <!-- Common Measurement Mistakes -->
    <section class="bg-surface border border-hairline rounded-2xl p-6 sm:p-8 mb-12">
      <h2 class="text-xl sm:text-2xl font-bold text-ink mb-4">7 Common Measurement Mistakes to Avoid</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs sm:text-sm text-body">
        <div class="p-4 bg-canvas-soft-2/50 border border-hairline rounded-xl">
          <h3 class="font-bold text-ink mb-1">1. Measuring over thick clothing</h3>
          <p>Always measure bare-chested or over a thin unlined non-padded bra to avoid adding false inches.</p>
        </div>

        <div class="p-4 bg-canvas-soft-2/50 border border-hairline rounded-xl">
          <h3 class="font-bold text-ink mb-1">2. Tape sagging across the back</h3>
          <p>Check in a mirror to ensure the tape remains strictly level and parallel to the floor all around.</p>
        </div>

        <div class="p-4 bg-canvas-soft-2/50 border border-hairline rounded-xl">
          <h3 class="font-bold text-ink mb-1">3. Pulling the bust tape too tight</h3>
          <p>The bust tape should rest lightly on nipple apexes without indenting breast tissue.</p>
        </div>

        <div class="p-4 bg-canvas-soft-2/50 border border-hairline rounded-xl">
          <h3 class="font-bold text-ink mb-1">4. Holding breath during measurement</h3>
          <p>Exhale normally so your ribcage is at its natural baseline when recording the underbust number.</p>
        </div>

        <div class="p-4 bg-canvas-soft-2/50 border border-hairline rounded-xl">
          <h3 class="font-bold text-ink mb-1">5. Confusing inches and centimeters</h3>
          <p>Double-check your tape units (`in` vs `cm`) before selecting unit toggles in the calculator.</p>
        </div>

        <div class="p-4 bg-canvas-soft-2/50 border border-hairline rounded-xl md:col-span-2">
          <h3 class="font-bold text-ink mb-1">6. Swapping underbust and overbust inputs</h3>
          <p>Make sure your smaller underbust number goes into the Underbust input and larger bust number into Bust input.</p>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="bg-surface border border-hairline rounded-2xl p-6 sm:p-8">
      <h2 class="text-xl sm:text-2xl font-bold text-ink mb-6">Frequently Asked Questions</h2>
      <div class="space-y-4">
        {faqSchema.mainEntity.map(item => (
          <details class="bg-canvas border border-hairline rounded-xl p-5 cursor-pointer group">
            <summary class="font-bold text-ink flex justify-between items-center list-none">
              <span>{item.name}</span>
              <span class="text-primary group-open:rotate-180 transition-transform">&darr;</span>
            </summary>
            <p class="mt-4 text-body text-xs sm:text-sm leading-relaxed">{item.acceptedAnswer.text}</p>
          </details>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</Layout>
