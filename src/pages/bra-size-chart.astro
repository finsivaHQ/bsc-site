---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { BAND_CONVERSION_MATRIX, CUP_CONVERSION_MATRIX } from '../utils/braSizing';
---

<Layout 
  title="Bra Size Chart — US, UK, EU, AU, JP, IN, HK, South Korea, SG & International Conversion Guide | BraSizeChecker"
  description="Comprehensive international bra size chart. Compare US, UK, EU, FR, AU, JP, IN, HK, South Korea, and Singapore band and cup sizes."
  canonical="https://brasizechecker.com/bra-size-chart"
>
  <Header />
  <main class="flex-1 w-full max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 md:py-16">
    <Breadcrumbs items={[{ label: 'Bra Size Chart' }]} />

    <!-- Page Header / Intro -->
    <header class="mb-10 text-center sm:text-left">
      <span class="inline-block py-1 px-3 rounded-full bg-canvas-soft-2 border border-hairline text-xs font-semibold uppercase tracking-widest text-primary mb-3">
        Reference Guide
      </span>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-ink tracking-tight mb-4">
        Bra Size Chart — US, UK, EU, AU, JP, IN, HK, KR, SG & International Conversions
      </h1>
      <p class="text-base sm:text-lg text-body leading-relaxed max-w-3xl">
        Navigating bra sizing across different brands and countries can be confusing. Every bra size consists of a <strong>band number</strong> (the ribcage measurement) and a <strong>cup letter</strong> (the volume difference between bust and underbust). Use this reference chart to compare sizes across verified international sizing systems including US, UK, EU, France, Australia, Japan, India, Hong Kong, South Korea, and Singapore.
      </p>
    </header>

    <!-- Interactive Conversion Chart Tool -->
    <section class="bg-surface border border-hairline rounded-2xl shadow-sm p-4 sm:p-6 md:p-8 mb-12" aria-labelledby="chart-heading">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6 pb-4 border-b border-hairline">
        <div>
          <h2 id="chart-heading" class="text-xl sm:text-2xl font-bold text-ink">International Size Conversion Matrices</h2>
          <p class="text-xs sm:text-sm text-body mt-1">Search or filter below to highlight equivalent band and cup sizes across regions.</p>
        </div>

        <!-- Filter Input -->
        <div class="w-full md:w-64 flex-shrink-0">
          <label for="page-matrix-search" class="sr-only">Search size</label>
          <div class="relative">
            <input 
              type="text" 
              id="page-matrix-search" 
              placeholder="Search size (e.g. 34, DD, 75)..." 
              class="w-full h-10 px-3.5 pl-9 bg-canvas border border-hairline rounded-xl text-xs text-ink placeholder:text-mute/60 focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/20 transition-all duration-200"
            />
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-mute absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
          </div>
        </div>
      </div>

      <!-- Band Matrix Table -->
      <div class="mb-8">
        <h3 class="text-xs sm:text-sm font-bold text-primary uppercase tracking-wider mb-3 flex items-center justify-between">
          <span>Band Size Conversion Matrix</span>
          <span class="text-[11px] text-mute font-normal">US / UK / EU / FR / AU / JP / IN / HK / KR / SG</span>
        </h3>
        <div class="overflow-x-auto -mx-2 px-2 max-h-[380px] rounded-xl border border-hairline">
          <table class="w-full text-left text-xs sm:text-sm text-body min-w-[720px] border-collapse relative">
            <thead class="sticky top-0 bg-canvas-soft-2 text-ink shadow-2xs z-10">
              <tr class="border-b border-hairline">
                <th scope="col" class="py-3 px-3.5 font-semibold">US / CA</th>
                <th scope="col" class="py-3 px-3.5 font-semibold">UK</th>
                <th scope="col" class="py-3 px-3.5 font-semibold">EU</th>
                <th scope="col" class="py-3 px-3.5 font-semibold">FR / BE / ES</th>
                <th scope="col" class="py-3 px-3.5 font-semibold">AU / NZ</th>
                <th scope="col" class="py-3 px-3.5 font-semibold">JP</th>
                <th scope="col" class="py-3 px-3.5 font-semibold">India (IN)</th>
                <th scope="col" class="py-3 px-3.5 font-semibold">Hong Kong (HK)</th>
                <th scope="col" class="py-3 px-3.5 font-semibold">South Korea (KR)</th>
                <th scope="col" class="py-3 px-3.5 font-semibold">Singapore (SG)</th>
              </tr>
            </thead>
            <tbody id="page-band-matrix-body" class="divide-y divide-hairline bg-surface">
              {BAND_CONVERSION_MATRIX.map(row => (
                <tr class="transition-colors hover:bg-canvas-soft-2/50">
                  <th scope="row" class="py-3 px-3.5 font-semibold text-ink">{row.us}</th>
                  <td class="py-3 px-3.5">{row.uk}</td>
                  <td class="py-3 px-3.5">{row.eu}</td>
                  <td class="py-3 px-3.5">{row.fr}</td>
                  <td class="py-3 px-3.5">{row.au}</td>
                  <td class="py-3 px-3.5">{row.jp}</td>
                  <td class="py-3 px-3.5">{row.in}</td>
                  <td class="py-3 px-3.5">{row.hk}</td>
                  <td class="py-3 px-3.5">{row.kr}</td>
                  <td class="py-3 px-3.5">{row.sg}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <!-- Cup Matrix Table -->
      <div>
        <h3 class="text-xs sm:text-sm font-bold text-primary uppercase tracking-wider mb-3 flex items-center justify-between">
          <span>Cup Size Conversion Matrix</span>
          <span class="text-[11px] text-mute font-normal">US / UK / EU / AU / JP / IN / HK / KR / SG</span>
        </h3>
        <div class="overflow-x-auto -mx-2 px-2 max-h-[440px] rounded-xl border border-hairline">
          <table class="w-full text-left text-xs sm:text-sm text-body min-w-[720px] border-collapse relative">
            <thead class="sticky top-0 bg-canvas-soft-2 text-ink shadow-2xs z-10">
              <tr class="border-b border-hairline">
                <th scope="col" class="py-3 px-3.5 font-semibold">US / CA</th>
                <th scope="col" class="py-3 px-3.5 font-semibold">UK</th>
                <th scope="col" class="py-3 px-3.5 font-semibold">EU</th>
                <th scope="col" class="py-3 px-3.5 font-semibold">AU / NZ</th>
                <th scope="col" class="py-3 px-3.5 font-semibold">JP</th>
                <th scope="col" class="py-3 px-3.5 font-semibold">India (IN)</th>
                <th scope="col" class="py-3 px-3.5 font-semibold">Hong Kong (HK)</th>
                <th scope="col" class="py-3 px-3.5 font-semibold">South Korea (KR)</th>
                <th scope="col" class="py-3 px-3.5 font-semibold">Singapore (SG)</th>
              </tr>
            </thead>
            <tbody id="page-cup-matrix-body" class="divide-y divide-hairline bg-surface">
              {CUP_CONVERSION_MATRIX.map(row => (
                <tr class="transition-colors hover:bg-canvas-soft-2/50">
                  <th scope="row" class="py-3 px-3.5 font-semibold text-ink">{row.us}</th>
                  <td class="py-3 px-3.5">{row.uk}</td>
                  <td class="py-3 px-3.5">{row.eu}</td>
                  <td class="py-3 px-3.5">{row.au}</td>
                  <td class="py-3 px-3.5">{row.jp}</td>
                  <td class="py-3 px-3.5">{row.in}</td>
                  <td class="py-3 px-3.5">{row.hk}</td>
                  <td class="py-3 px-3.5">{row.kr}</td>
                  <td class="py-3 px-3.5">{row.sg}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Educational Sections -->
    <div class="space-y-10 text-body leading-relaxed text-sm sm:text-base">
      <!-- Section: How to Read a Bra Size -->
      <section class="bg-surface border border-hairline rounded-2xl p-6 sm:p-8">
        <h2 class="text-xl sm:text-2xl font-bold text-ink mb-4">How to Read a Bra Size</h2>
        <p class="mb-4">
          A standard bra size consists of two parts: the <strong>Band Size</strong> (a number such as 34 or 75) and the <strong>Cup Size</strong> (a letter such as C, D, or DD).
        </p>
        <div class="grid md:grid-cols-2 gap-4 my-6">
          <div class="p-4 bg-canvas-soft-2 rounded-xl border border-hairline">
            <h3 class="font-bold text-ink mb-1 text-sm uppercase tracking-wider text-primary">1. Band Size (Number)</h3>
            <p class="text-xs sm:text-sm">Represents your snug ribcage measurement directly beneath your bust. In US/UK sizing, bands run in even numbers (30, 32, 34, 36). In EU sizing, bands are measured in centimeters (65, 70, 75, 80).</p>
          </div>
          <div class="p-4 bg-canvas-soft-2 rounded-xl border border-hairline">
            <h3 class="font-bold text-ink mb-1 text-sm uppercase tracking-wider text-primary">2. Cup Size (Letter)</h3>
            <p class="text-xs sm:text-sm">Represents the volume difference between your full bust measurement and your underbust band measurement. Each letter step generally corresponds to 1 inch (or 2.5 cm) of bust volume difference.</p>
          </div>
        </div>
        <p class="text-xs sm:text-sm text-mute italic bg-canvas p-3 rounded-lg border border-hairline">
          💡 <strong>Key Concept:</strong> Cup letters do not represent fixed volumes on their own. A 32D cup holds less volume than a 38D cup. Cup letter size is always relative to band size.
        </p>
      </section>

      <!-- Section: Understanding Sister Sizes -->
      <section class="bg-surface border border-hairline rounded-2xl p-6 sm:p-8">
        <h2 class="text-xl sm:text-2xl font-bold text-ink mb-4">Understanding Sister Sizes</h2>
        <p class="mb-4">
          Sister sizes have equivalent cup volumes despite different band sizes. If your band is uncomfortable but the cup volume feels right, move up a band size and down a cup letter (or vice versa).
        </p>
        <div class="p-4 bg-canvas-soft-2 rounded-xl border border-hairline mb-4">
          <p class="font-bold text-ink mb-2">Sister Size Example for 34C:</p>
          <ul class="list-disc pl-5 space-y-1 text-xs sm:text-sm">
            <li><strong>32D</strong> (Smaller Band, Larger Cup Letter &rarr; Tight Band, Same Volume)</li>
            <li><strong>34C</strong> (Your Baseline Starting Size)</li>
            <li><strong>36B</strong> (Larger Band, Smaller Cup Letter &rarr; Loose Band, Same Volume)</li>
          </ul>
        </div>
        <p>
          To calculate your exact baseline size and see your 3-card sister size breakdown automatically, use our free <a href="/#calculator" class="text-primary font-semibold hover:underline">Bra Size Calculator</a>.
        </p>
      </section>

      <!-- Section: How to Find Your Size -->
      <section class="bg-surface border border-hairline rounded-2xl p-6 sm:p-8">
        <h2 class="text-xl sm:text-2xl font-bold text-ink mb-4">How to Find Your Recommended Bra Size</h2>
        <p class="mb-4">
          Establishing your baseline bra size takes less than two minutes using a soft measuring tape:
        </p>
        <ol class="list-decimal pl-5 space-y-2 mb-6">
          <li>Measure your <strong>underbust</strong> snugly around your ribcage directly beneath your bust.</li>
          <li>Measure your <strong>bust</strong> loosely around the fullest part of your chest.</li>
          <li>Enter your measurements into our <a href="/#calculator" class="text-primary font-semibold hover:underline">Bra Size Calculator</a>.</li>
          <li>Review our step-by-step <a href="/#how-to-measure" class="text-primary font-semibold hover:underline">How to Measure Guide</a> for measuring tips.</li>
        </ol>
      </section>

      <!-- Section: Important Fit Note -->
      <section class="bg-canvas-soft-2 border-2 border-primary/30 rounded-2xl p-6 sm:p-8">
        <h2 class="text-xl sm:text-2xl font-bold text-ink mb-2">Important Fit Note</h2>
        <p class="text-sm sm:text-base leading-relaxed">
          Your calculated bra size is a recommended starting point. Because sizing conventions, band elasticity, cup cuts, and wire shapes vary between manufacturers and styles, you may find that your best-fitting size shifts slightly between different brands. Use our <a href="/#fit-guide" class="text-primary font-semibold hover:underline">Fit Guide</a> to diagnose common fit issues such as band riding up, gaping cups, or digging wires.
        </p>
      </section>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  import { BAND_CONVERSION_MATRIX, CUP_CONVERSION_MATRIX } from '../utils/braSizing';

  const searchInput = document.getElementById('page-matrix-search') as HTMLInputElement;
  const bandBody = document.getElementById('page-band-matrix-body');
  const cupBody = document.getElementById('page-cup-matrix-body');

  const renderTables = (query: string) => {
    const q = query.toLowerCase().trim();

    if (bandBody) {
      bandBody.innerHTML = BAND_CONVERSION_MATRIX.map(row => {
        const isMatch = q && (
          String(row.us).includes(q) || 
          String(row.uk).includes(q) || 
          String(row.eu).includes(q) || 
          String(row.fr).includes(q) || 
          String(row.au).includes(q) || 
          String(row.jp).includes(q) || 
          String(row.in).includes(q) || 
          String(row.hk).includes(q) || 
          String(row.kr).includes(q) || 
          String(row.sg).includes(q)
        );
        const isFiltered = q && !isMatch;
        if (isFiltered) return '';

        return `
          <tr class="transition-colors ${isMatch ? 'bg-canvas-soft-2 font-bold text-ink border-l-4 border-primary' : 'hover:bg-canvas-soft-2/50'}">
            <th scope="row" class="py-3 px-3.5 font-semibold text-ink">${row.us}</th>
            <td class="py-3 px-3.5">${row.uk}</td>
            <td class="py-3 px-3.5">${row.eu}</td>
            <td class="py-3 px-3.5">${row.fr}</td>
            <td class="py-3 px-3.5">${row.au}</td>
            <td class="py-3 px-3.5">${row.jp}</td>
            <td class="py-3 px-3.5">${row.in}</td>
            <td class="py-3 px-3.5">${row.hk}</td>
            <td class="py-3 px-3.5">${row.kr}</td>
            <td class="py-3 px-3.5">${row.sg}</td>
          </tr>
        `;
      }).join('');
    }

    if (cupBody) {
      cupBody.innerHTML = CUP_CONVERSION_MATRIX.map(row => {
        const isMatch = q && (
          row.us.toLowerCase().includes(q) || 
          row.uk.toLowerCase().includes(q) || 
          row.eu.toLowerCase().includes(q) || 
          row.au.toLowerCase().includes(q) || 
          row.jp.toLowerCase().includes(q) || 
          row.in.toLowerCase().includes(q) || 
          row.hk.toLowerCase().includes(q) || 
          row.kr.toLowerCase().includes(q) || 
          row.sg.toLowerCase().includes(q)
        );
        const isFiltered = q && !isMatch;
        if (isFiltered) return '';

        return `
          <tr class="transition-colors ${isMatch ? 'bg-canvas-soft-2 font-bold text-ink border-l-4 border-primary' : 'hover:bg-canvas-soft-2/50'}">
            <th scope="row" class="py-3 px-3.5 font-semibold text-ink">${row.us}</th>
            <td class="py-3 px-3.5">${row.uk}</td>
            <td class="py-3 px-3.5">${row.eu}</td>
            <td class="py-3 px-3.5">${row.au}</td>
            <td class="py-3 px-3.5">${row.jp}</td>
            <td class="py-3 px-3.5">${row.in}</td>
            <td class="py-3 px-3.5">${row.hk}</td>
            <td class="py-3 px-3.5">${row.kr}</td>
            <td class="py-3 px-3.5">${row.sg}</td>
          </tr>
        `;
      }).join('');
    }
  };

  searchInput?.addEventListener('input', (e) => {
    renderTables((e.target as HTMLInputElement).value);
  });
</script>
