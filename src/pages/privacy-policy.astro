---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Privacy Policy | Bra Size Calculator">
  <Header />
  <main class="flex-1 w-full max-w-3xl mx-auto px-6 py-12">
    <h1 class="text-3xl font-bold text-ink mb-6">Privacy Policy</h1>
    <div class="prose prose-slate max-w-none text-body space-y-6">
      <p>Last updated: August 2026</p>
      
      <section>
        <h2 class="text-xl font-bold text-ink mb-3">1. Introduction</h2>
        <p>Welcome to Bra Size Calculator. We value your privacy and are committed to protecting your personal information. This Privacy Policy explains how we collect, use, and share information when you visit our website.</p>
      </section>

      <section>
        <h2 class="text-xl font-bold text-ink mb-3">2. Information We Collect</h2>
        <p>We may collect information you provide directly to us when you use our contact form, such as your email address and any message contents. Our calculator runs on your device, and we do not store your body measurements on our servers.</p>
      </section>

      <section>
        <h2 class="text-xl font-bold text-ink mb-3">3. How We Use Information</h2>
        <p>We use the information you provide to respond to your inquiries and improve our services.</p>
      </section>

      <section>
        <h2 class="text-xl font-bold text-ink mb-3">4. Contact Us</h2>
        <p>If you have questions about this Privacy Policy, please contact us at <a href="mailto:ornacasa11@gmail.com" class="text-primary hover:underline">ornacasa11@gmail.com</a>.</p>
      </section>
    </div>
  </main>
  <Footer />
</Layout>
