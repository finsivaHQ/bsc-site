---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="About Us | Bra Size Calculator">
  <Header />
  <main class="flex-1 w-full max-w-3xl mx-auto px-6 py-12">
    <h1 class="text-3xl font-bold text-ink mb-6">About Us</h1>
    <div class="prose prose-slate max-w-none text-body">
      <p class="mb-4">
        Welcome to Bra Size Calculator! We are dedicated to helping people find their perfect bra size quickly and accurately from the comfort of their homes.
      </p>
      <p class="mb-4">
        We understand that bra sizing can be confusing and inconsistent across different brands. That's why we've built a precision fit tool that simplifies the process and provides reliable recommendations based on your measurements.
      </p>
      <p class="mb-4">
        If you have any questions or suggestions, please feel free to reach out to us at <a href="mailto:ornacasa11@gmail.com" class="text-primary hover:underline">ornacasa11@gmail.com</a> or via our <a href="/contact" class="text-primary hover:underline">Contact Us</a> page.
      </p>
    </div>
  </main>
  <Footer />
</Layout>
