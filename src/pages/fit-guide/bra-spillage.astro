---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What causes 'quad-boob' or double-bust ridges under t-shirts?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Quad-boobing occurs when bra cup volume is 1 to 2 sizes too small for your breast tissue. The upper elastic binding of the cup cuts directly across the fullest crest of your mammary tissue, cleaving it into two distinct upper and lower bulges that show conspicuously under tight or thin knitwear."
      }
    },
    {
      "@type": "Question",
      "name": "What is the difference between top spillage and side armpit spillage?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Top spillage indicates insufficient vertical cup depth, forcing breast tissue over the neckline. Side spillage (underarm bulging) indicates underwires that are too narrow or underbust bands that are too loose, allowing breast tissue to escape around the wire tips and pool into the axillary region."
      }
    },
    {
      "@type": "Question",
      "name": "What is the 'Scoop and Swoop' and why does it reveal cup spillage?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The Scoop and Swoop is a standard fitting maneuver where you lean forward and use your opposite hand to gently gather all breast tissue from your underarm and side ribcage into the center of the cup. If doing this causes immediate spillage or quad-boobing, your current cups were artificially accommodating you only because your breast tissue was sitting outside the bra."
      }
    },
    {
      "@type": "Question",
      "name": "Is underarm fat always breast tissue?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "In many cases, what women assume is 'stubborn armpit fat' is actually the Axillary Tail of Spence (a normal extension of mammary glandular tissue toward the armpit) or migratory breast tissue pushed backward by years of wearing narrow, undersized bra cups."
      }
    },
    {
      "@type": "Question",
      "name": "How many cup sizes should I go up if I have slight spillage?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "If you have subtle spillage (a faint line under clothing), move up 1 cup size (e.g. from 34C to 34D). If you have severe quad-boobing with tissue spilling over both the top and center bridge, move up 2 to 3 cup sizes (e.g. from 34C to 34DD or 34DDD)."
      }
    }
  ]
};
---

<Layout 
  title="Why Are My Breasts Spilling Out of My Bra? ('Quad-Boob') Fixes | BraSizeChecker"
  description="Fix breast spillage over top or side bra cups. Master quad-boob diagnostics, side spillage migration, cup volume expansion tables, and t-shirt fit checks."
  canonical="https://brasizechecker.com/fit-guide/bra-spillage/"
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <Header />
  <main class="flex-1 w-full max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 md:py-16">
    <Breadcrumbs items={[
      { label: 'Fit Guide', url: '/fit-guide/' },
      { label: 'Breast Spillage' }
    ]} />

    <header class="mb-10 text-center sm:text-left">
      <span class="inline-block py-1 px-3 rounded-full bg-canvas-soft-2 border border-hairline text-xs font-semibold uppercase tracking-widest text-primary mb-3">
        Fit Diagnostic Guide
      </span>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-ink tracking-tight mb-4">
        Why Are My Breasts Spilling Out of My Bra? Quad-Boob & Side Spillage Guide
      </h1>
      <p class="text-base sm:text-lg text-body leading-relaxed max-w-3xl">
        Breast tissue bulging over the top neckline, bubbling out of the sides, or popping over the center gore—commonly creating the unflattering double-bust silhouette known as **"quad-boobing"**—is definitive proof that your bra cups lack the volumetric capacity to encapsulate your breasts.
      </p>
    </header>

    <div class="space-y-10 text-body leading-relaxed text-sm sm:text-base">
      <!-- Section 1: Vector Diagram & Spillage Anatomy -->
      <section class="bg-surface border border-hairline rounded-2xl p-6 sm:p-8">
        <h2 class="text-xl sm:text-2xl font-bold text-ink mb-4">1. The Fluid Dynamics of Cup Overflow & "Quad-Boobing"</h2>
        <p class="mb-4">
          Human breast tissue is soft, semi-viscous glandular and adipose tissue that displaces under pressure. When you attempt to compress 650 cubic centimeters (cc) of breast volume inside an undersized cup engineered to hold only 480 cc, the excess tissue behaves like fluid in an overfilled vessel: it escapes past whichever boundary offers the least resistance.
        </p>

        <!-- Diagram -->
        <div class="max-w-md mx-auto my-6 text-center">
          <img 
            src="/img/fit-cup-spillage.svg" 
            alt="Vector diagram demonstrating breast spillage and quad-boob overflow over top bra cup boundary" 
            width="400" 
            height="240" 
            class="w-full h-auto rounded-xl border border-hairline shadow-2xs mx-auto" 
            loading="lazy"
            decoding="async"
          />
          <span class="text-center text-xs text-mute mt-2 block font-medium">
            Figure 1: Quad-boob tissue overflow caused by a cup volume that is 1 to 2 sizes too small.
          </span>
        </div>

        <p class="mb-4">
          When you wear a t-shirt or fine-gauge sweater over an overflowing cup, the taut fabric of the garment presses down on the bulging tissue. This creates a visible, horizontal crease across the mid-bust, giving the optical appearance of four breasts instead of two.
        </p>
      </section>

      <!-- Section 2: Top vs Side Spillage Diagnostic Matrix -->
      <section class="bg-surface border border-hairline rounded-2xl p-6 sm:p-8">
        <h2 class="text-xl sm:text-2xl font-bold text-ink mb-4">2. Top Spillage vs. Side Spillage: Diagnostic Matrix</h2>
        <p class="mb-4">
          Not all spillage manifests in the same direction. Identifying whether your tissue is escaping vertically, laterally, or centrally pinpoints the exact engineering flaw:
        </p>

        <!-- Data Table 1: Spillage Matrix -->
        <div class="overflow-x-auto -mx-2 px-2 mb-6">
          <table class="w-full text-left text-xs sm:text-sm text-body border-collapse min-w-[550px]">
            <thead>
              <tr class="border-b border-hairline bg-canvas-soft-2 text-ink">
                <th scope="col" class="py-2.5 px-3 font-semibold">Spillage Category</th>
                <th scope="col" class="py-2.5 px-3 font-semibold">Visual Presentation</th>
                <th scope="col" class="py-2.5 px-3 font-semibold">Mechanical Root Cause</th>
                <th scope="col" class="py-2.5 px-3 font-semibold">Architectural Fix</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-hairline">
              <tr>
                <td class="py-2.5 px-3 font-semibold text-primary">Top Neckline ("Quad-Boob")</td>
                <td class="py-2.5 px-3">Bulging horizontal ridge above top cup seam.</td>
                <td class="py-2.5 px-3">Cup volume is 1 to 2 steps too small; apex is too shallow.</td>
                <td class="py-2.5 px-3">Increase cup letter by 1-2 sizes (e.g. 34C &rarr; 34DD).</td>
              </tr>
              <tr>
                <td class="py-2.5 px-3 font-semibold text-ink">Side Underarm Bulging</td>
                <td class="py-2.5 px-3">Flesh rolls spilling over wire tips near armpits.</td>
                <td class="py-2.5 px-3">Underwire arch is too narrow; wire rests directly on breast root.</td>
                <td class="py-2.5 px-3">Switch to wider wire arc (balconette) with tall side smoothing wings.</td>
              </tr>
              <tr>
                <td class="py-2.5 px-3 font-semibold text-ink">Center Gore Spillage</td>
                <td class="py-2.5 px-3">Breasts colliding and popping over center wire bridge.</td>
                <td class="py-2.5 px-3">Plunge cut with low gore worn on close-set or full-on-center tissue.</td>
                <td class="py-2.5 px-3">Switch to higher-gore balconette or full-cup with separation.</td>
              </tr>
              <tr>
                <td class="py-2.5 px-3 font-semibold text-ink">Bottom Fold Slippage</td>
                <td class="py-2.5 px-3">Underwire slides down onto ribs; tissue escapes beneath.</td>
                <td class="py-2.5 px-3">Band is too loose (e.g., 36 instead of 32); cups lack immediate projection.</td>
                <td class="py-2.5 px-3">Downsize band for firm grip; select cut-and-sewn seamed cups.</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- Section 3: The Scoop and Swoop Protocol -->
      <section class="bg-surface border border-hairline rounded-2xl p-6 sm:p-8">
        <h2 class="text-xl sm:text-2xl font-bold text-ink mb-4">3. The 4-Step "Scoop and Swoop" Protocol</h2>
        <p class="mb-4">
          Many women believe their bras fit perfectly simply because they put them on incorrectly. When you fasten a bra while standing upright without positioning your tissue, up to 30% of your breast volume remains trapped under the underwires or pushed back toward your armpits.
        </p>

        <div class="bg-canvas-soft-2 p-5 rounded-xl border border-hairline my-6 text-xs sm:text-sm">
          <h3 class="font-bold text-ink mb-2">📐 How to Properly Put on a Bra</h3>
          <ol class="list-decimal pl-5 space-y-2 text-body">
            <li><strong>Fasten on the loosest hook:</strong> Fasten your bra with the underwires positioned directly in your inframammary fold (the crease beneath your breasts).</li>
            <li><strong>Bend forward 45 degrees:</strong> Lean forward so gravity allows your breast tissue to fall naturally forward into the cup domes.</li>
            <li><strong>Scoop from the armpit:</strong> Reach your left hand into your right cup. Gently sweep all soft tissue from underneath your armpit and side ribcage forward and up into the cup. Repeat on the opposite side.</li>
            <li><strong>Settle the underwires:</strong> Stand tall, shake gently, and adjust shoulder straps. Now evaluate: does tissue overflow over the rim? If yes, your true cup size is at least 1 to 2 sizes larger than the tag indicates!</li>
          </ol>
        </div>
      </section>

      <!-- Section 4: Tissue Migration & Volumetric Recovery -->
      <section class="bg-surface border border-hairline rounded-2xl p-6 sm:p-8">
        <h2 class="text-xl sm:text-2xl font-bold text-ink mb-4">4. Tissue Migration: What Happens When You Upgrade</h2>
        <p class="mb-4">
          Wearing undersized cups for years exerts chronic mechanical pressure on glandular tissue. Over months and years, this constant compression displaces soft tissue backward, causing it to settle along the lateral ribs and underarm zone—a phenomenon known as **migratory breast tissue**.
        </p>
        <p class="mb-4">
          When you transition into a correctly fitted bra with sufficiently wide underwires and deep cups:
        </p>
        <ul class="list-disc pl-5 space-y-2 text-xs sm:text-sm mb-4">
          <li><strong>Weeks 1–3:</strong> The wider underwire comfortably encapsulates the entire breast base without pinching lateral nerves.</li>
          <li><strong>Weeks 4–8:</strong> Daily Scooping and Swooping encourages displaced tissue to migrate back into the primary breast mound.</li>
          <li><strong>Long-Term Result:</strong> Many women discover that after two months of wearing their true size, their underarm fullness smooths out, and their cup volume actually increases by half a cup size as natural breast anatomy is restored!</li>
        </ul>
      </section>

      <!-- Section 5: Interactive Sizing Tools -->
      <section class="bg-surface border border-hairline rounded-2xl p-6 sm:p-8">
        <h2 class="text-xl sm:text-2xl font-bold text-ink mb-4">5. Re-Calculate Your Correct Cup Size Baseline</h2>
        <p class="text-sm text-body mb-6">
          Eliminate quad-boobing and painful underwire pinching today. Input your measurements into our precision tools:
        </p>
        <div class="flex flex-wrap gap-3">
          <a href="/#calculator" class="px-5 py-2.5 bg-primary text-on-primary font-bold text-xs rounded-xl hover:bg-primary-hover transition-colors shadow-2xs">
            Calculate Size Baseline &rarr;
          </a>
          <a href="/sister-size-calculator/" class="px-5 py-2.5 bg-surface border border-hairline text-ink font-semibold text-xs rounded-xl hover:bg-canvas-soft-2 transition-colors shadow-2xs">
            Sister Size Matrix &rarr;
          </a>
          <a href="/fit-guide/" class="px-5 py-2.5 bg-surface border border-hairline text-ink font-semibold text-xs rounded-xl hover:bg-canvas-soft-2 transition-colors shadow-2xs">
            Return to Fit Diagnostic Hub &rarr;
          </a>
        </div>
      </section>

      <!-- Section 6: FAQ Section -->
      <section class="bg-surface border border-hairline rounded-2xl p-6 sm:p-8">
        <h2 class="text-xl sm:text-2xl font-bold text-ink mb-6">Frequently Asked Questions</h2>
        <div class="space-y-4">
          {faqSchema.mainEntity.map(item => (
            <details class="bg-canvas border border-hairline rounded-xl p-5 cursor-pointer group">
              <summary class="font-bold text-ink flex justify-between items-center list-none">
                <span>{item.name}</span>
                <span class="text-primary group-open:rotate-180 transition-transform">&darr;</span>
              </summary>
              <p class="mt-4 text-body text-xs sm:text-sm leading-relaxed">{item.acceptedAnswer.text}</p>
            </details>
          ))}
        </div>
      </section>
    </div>
  </main>
  <Footer />
</Layout>
