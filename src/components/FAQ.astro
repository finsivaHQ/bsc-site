const schemaList = faqs.map(faq => ({
  "@type": "Question",
  "name": faq.question,
  "acceptedAnswer": {
    "@type": "Answer",
    "text": faq.answer
  }
}));

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": schemaList
};
---

<section id="faq" class="py-10 sm:py-16 md:py-24 px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto border-t border-hairline">
  <div class="mb-8 sm:mb-12 text-center md:text-left">
    <span class="inline-block py-1 px-3 rounded-full bg-canvas-soft-2 border border-hairline text-xs font-semibold uppercase tracking-widest text-primary mb-3">
      FAQ
    </span>
    <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-ink mb-4 font-sans tracking-tight">Frequently Asked Questions</h2>
    <p class="text-sm sm:text-base md:text-lg text-body max-w-2xl font-sans">
      Everything you need to know about measuring, bra sizing, and finding your most comfortable fit.
    </p>
  </div>

  <div class="space-y-4">
    {faqs.map((faq) => (
      <details class="group bg-canvas-soft border border-hairline rounded-[2rem] p-5 sm:p-6 md:p-8 cursor-pointer hover:border-primary/50 transition-all duration-300 shadow-sm hover:shadow-md">
        <summary class="flex justify-between items-center font-bold text-base sm:text-lg md:text-xl text-ink list-none font-sans">
          <span class="pr-4 sm:pr-6">{faq.question}</span>
          <span class="transition-transform duration-300 group-open:rotate-180 text-primary bg-canvas border border-hairline p-2 rounded-full shadow-sm flex-shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"/>
            </svg>
          </span>
        </summary>
        <div class="mt-4 text-body text-sm sm:text-base md:text-lg pt-4 border-t border-hairline leading-relaxed font-sans">
          <p>{faq.answer}</p>
        </div>
      </details>
    ))}
  </div>
</section>

<!-- Inject FAQ JSON-LD for SEO -->
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<style>
  /* Remove default Safari/Chrome disclosure triangle */
  details > summary::-webkit-details-marker {
    display: none;
  }
  
  /* Smooth Squircle/Bubble effect */
  details {
    border-radius: 2rem; /* creates a soft, squircle-like bubble */
  }
</style>
