---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Terms & Conditions | Bra Size Calculator">
  <Header />
  <main class="flex-1 w-full max-w-3xl mx-auto px-6 py-12">
    <h1 class="text-3xl font-bold text-ink mb-6">Terms & Conditions</h1>
    <div class="prose prose-slate max-w-none text-body space-y-6">
      <p>Last updated: August 2026</p>
      
      <section>
        <h2 class="text-xl font-bold text-ink mb-3">1. Agreement to Terms</h2>
        <p>By using the Bra Size Calculator website, you agree to be bound by these Terms and Conditions.</p>
      </section>

      <section>
        <h2 class="text-xl font-bold text-ink mb-3">2. Use of Service</h2>
        <p>Our sizing recommendations are intended for guidance purposes only. Fit can vary by brand, style, and individual preference. We do not guarantee a perfect fit from our recommendations.</p>
      </section>

      <section>
        <h2 class="text-xl font-bold text-ink mb-3">3. Changes to Terms</h2>
        <p>We reserve the right to modify these terms at any time. Your continued use of the site after any changes indicates your acceptance of the new terms.</p>
      </section>

      <section>
        <h2 class="text-xl font-bold text-ink mb-3">4. Contact Information</h2>
        <p>If you have any questions about these Terms, please contact us at <a href="mailto:ornacasa11@gmail.com" class="text-primary hover:underline">ornacasa11@gmail.com</a>.</p>
      </section>
    </div>
  </main>
  <Footer />
</Layout>
