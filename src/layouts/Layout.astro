---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
	canonical?: string;
	noindex?: boolean;
	image?: string;
	type?: string;
}

const { 
	title, 
	description = "Calculate your recommended bra size in seconds with our free, private calculator. Includes sister sizes, US/UK/EU international size conversion charts, and fit guidance.",
	canonical,
	noindex = false,
	image = "https://brasizechecker.com/og-image.svg",
	type = "website"
} = Astro.props;

// Generate canonical URL dynamically based on current path if not explicitly overridden
const defaultCanonical = new URL(Astro.url.pathname, 'https://brasizechecker.com').toString().replace(/\/$/, '');
const canonicalURL = canonical || defaultCanonical || 'https://brasizechecker.com';

const isHomepage = Astro.url.pathname === '/' || Astro.url.pathname === '';

// Structured Data (JSON-LD Graph)
const schemaGraph: any[] = [
	{
		"@type": "WebSite",
		"@id": "https://brasizechecker.com/#website",
		"url": "https://brasizechecker.com",
		"name": "BraSizeChecker",
		"description": "An independent tool for finding and understanding your recommended bra size.",
		"publisher": {
			"@id": "https://brasizechecker.com/#organization"
		}
	},
	{
		"@type": "Organization",
		"@id": "https://brasizechecker.com/#organization",
		"name": "BraSizeChecker",
		"url": "https://brasizechecker.com",
		"logo": {
			"@type": "ImageObject",
			"url": "https://brasizechecker.com/logo.png",
			"width": 1024,
			"height": 1024
		}
	},
	{
		"@type": "WebPage",
		"@id": `${canonicalURL}#webpage`,
		"url": canonicalURL,
		"name": title,
		"description": description,
		"isPartOf": {
			"@id": "https://brasizechecker.com/#website"
		}
	}
];

// Add WebApplication schema on homepage
if (isHomepage) {
	schemaGraph.push({
		"@type": "WebApplication",
		"@id": "https://brasizechecker.com/#calculator-app",
		"name": "Bra Size Calculator",
		"url": "https://brasizechecker.com",
		"applicationCategory": "HealthApplication",
		"operatingSystem": "All",
		"offers": {
			"@type": "Offer",
			"price": "0",
			"priceCurrency": "USD"
		},
		"description": "Free, private bra size calculator that calculates baseline bra sizes, sister sizes, and international conversions."
	});
}

// Add BreadcrumbList schema on indexable subpages
if (!isHomepage && !noindex) {
	const pageName = title.split('—')[0].split('|')[0].trim();
	schemaGraph.push({
		"@type": "BreadcrumbList",
		"@id": `${canonicalURL}#breadcrumb`,
		"itemListElement": [
			{
				"@type": "ListItem",
				"position": 1,
				"name": "Home",
				"item": "https://brasizechecker.com"
			},
			{
				"@type": "ListItem",
				"position": 2,
				"name": pageName,
				"item": canonicalURL
			}
		]
	});
}

const jsonLdData = {
	"@context": "https://schema.org",
	"@graph": schemaGraph
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="theme-color" content="#FAF7F4" />
		<!-- Favicon & Touch Icons for Google Search and all Browsers -->
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
		<link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
		<link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png" />
		<link rel="icon" type="image/png" sizes="512x512" href="/favicon-512x512.png" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="generator" content={Astro.generator} />
		<meta name="msvalidate.01" content="1F7EB46675900FDE533DDDA7125754E4" />
		<link rel="canonical" href={canonicalURL} />
		<link rel="dns-prefetch" href="https://unpkg.com" />
		<ClientRouter />
		<title>{title}</title>

		<!-- Open Graph / Facebook / WhatsApp Metadata -->
		<meta property="og:site_name" content="BraSizeChecker" />
		<meta property="og:type" content={type} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={image} />

		<!-- Twitter Card Metadata -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={image} />

		<slot name="head" />

		<script type="application/ld+json" set:html={JSON.stringify(jsonLdData)} />
		<script is:inline>
			const theme = (() => {
				if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
					return localStorage.getItem('theme');
				}
				if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
					return 'dark';
				}
				return 'light';
			})();
			
			if (theme === 'dark') {
				document.documentElement.classList.add('dark');
			} else {
				document.documentElement.classList.remove('dark');
			}
		</script>
	</head>
	<body class="antialiased min-h-screen flex flex-col selection:bg-primary selection:text-on-primary">
		<slot />
	</body>
</html>
