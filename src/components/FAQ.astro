const schemaList = faqs.map(faq => ({
  "@type": "Question",
  "name": faq.question,
  "acceptedAnswer": {
    "@type": "Answer",
    "text": faq.answer
  }
}));

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": schemaList
};
---

<section id="faq" class="py-8 sm:py-12 md:py-16 px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto border-t border-hairline">
  <div class="mb-6 sm:mb-8 text-center md:text-left">
    <span class="inline-block py-0.5 px-2.5 rounded-full bg-canvas-soft-2 border border-hairline text-[11px] font-semibold uppercase tracking-widest text-primary mb-2">
      FAQ
    </span>
    <h2 class="text-xl sm:text-2xl md:text-3xl font-bold text-ink mb-2 font-sans tracking-tight">Frequently Asked Questions</h2>
    <p class="text-xs sm:text-sm text-body max-w-xl font-sans">
      Everything you need to know about measuring, bra sizing, and finding your most comfortable fit.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-4 items-start">
    {faqs.map((faq, index) => (
      <details 
        class={`group bg-canvas-soft border border-hairline rounded-2xl p-3.5 sm:p-4 cursor-pointer hover:border-primary/50 transition-all duration-200 shadow-xs hover:shadow-sm ${index >= 6 ? 'faq-extra hidden' : ''}`}
      >
        <summary class="flex justify-between items-center font-semibold text-xs sm:text-sm text-ink list-none font-sans leading-snug">
          <span class="pr-3">{faq.question}</span>
          <span class="transition-transform duration-200 group-open:rotate-180 text-primary bg-canvas border border-hairline p-1 rounded-full shadow-xs flex-shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"/>
            </svg>
          </span>
        </summary>
        <div class="mt-2.5 text-body text-xs sm:text-sm pt-2.5 border-t border-hairline leading-relaxed font-sans">
          <p>{faq.answer}</p>
        </div>
      </details>
    ))}
  </div>

  {faqs.length > 6 && (
    <div class="mt-6 text-center">
      <button 
        id="toggle-faq-btn" 
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-surface border border-hairline text-xs font-semibold text-ink hover:text-primary hover:border-primary/50 transition-all shadow-xs cursor-pointer"
      >
        <span id="toggle-faq-text">View All {faqs.length} Questions</span>
        <svg id="toggle-faq-icon" class="w-3.5 h-3.5 transition-transform duration-200" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="6 9 12 15 18 9"/>
        </svg>
      </button>
    </div>
  )}
</section>

<!-- Inject FAQ JSON-LD for SEO -->
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<script is:inline>
  function setupFaqToggle() {
    const btn = document.getElementById('toggle-faq-btn');
    if (!btn) return;
    
    let expanded = false;
    btn.onclick = () => {
      expanded = !expanded;
      const extras = document.querySelectorAll('.faq-extra');
      const textSpan = document.getElementById('toggle-faq-text');
      const iconSvg = document.getElementById('toggle-faq-icon');
      
      extras.forEach(el => {
        if (expanded) {
          el.classList.remove('hidden');
        } else {
          el.classList.add('hidden');
        }
      });
      
      if (textSpan) {
        textSpan.textContent = expanded ? 'Show Fewer Questions' : 'View All 21 Questions';
      }
      if (iconSvg) {
        iconSvg.style.transform = expanded ? 'rotate(180deg)' : 'rotate(0deg)';
      }
    };
  }

  document.addEventListener('astro:page-load', setupFaqToggle);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupFaqToggle);
  } else {
    setupFaqToggle();
  }
</script>

<style>
  /* Remove default Safari/Chrome disclosure triangle */
  details > summary::-webkit-details-marker {
    display: none;
  }
</style>
