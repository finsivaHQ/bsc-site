---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Contact Us | Bra Size Calculator">
  <Header />
  <main class="flex-1 w-full max-w-3xl mx-auto px-6 py-12">
    <h1 class="text-3xl font-bold text-ink mb-6">Contact Us</h1>
    <p class="text-body text-body-sm mb-8">
      Have a question or feedback? We'd love to hear from you. Please fill out the form below or email us directly at <a href="mailto:ornacasa11@gmail.com" class="text-primary hover:underline">ornacasa11@gmail.com</a>.
    </p>

    <div class="bg-canvas-soft p-8 rounded-xl border border-hairline">
      <div data-fs-success class="hidden mb-6 p-4 bg-success/20 text-success rounded-lg font-medium">
        Thanks for reaching out! We'll get back to you shortly.
      </div>
      <div data-fs-error class="hidden mb-6 p-4 bg-error/20 text-error rounded-lg font-medium">
        Oops! There was a problem with your submission.
      </div>

      <form id="contact-form" class="space-y-6">
        <div>
          <label for="email" class="block text-sm font-medium text-ink mb-2">Email Address</label>
          <input 
            type="email" 
            id="email" 
            name="email" 
            data-fs-field
            required 
            class="w-full px-4 py-3 bg-canvas border border-hairline rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent text-ink placeholder:text-mute"
            placeholder="you@example.com"
          />
          <span data-fs-error="email" class="text-error text-sm mt-1 block"></span>
        </div>

        <div>
          <label for="message" class="block text-sm font-medium text-ink mb-2">Message</label>
          <textarea 
            id="message" 
            name="message" 
            rows="5"
            data-fs-field
            required 
            class="w-full px-4 py-3 bg-canvas border border-hairline rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent text-ink placeholder:text-mute"
            placeholder="How can we help?"
          ></textarea>
          <span data-fs-error="message" class="text-error text-sm mt-1 block"></span>
        </div>

        <button 
          type="submit" 
          data-fs-submit-btn
          class="w-full sm:w-auto px-8 py-3 bg-primary text-on-primary font-medium rounded-full hover:bg-primary/90 transition-colors focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2"
        >
          Send Message
        </button>
      </form>
    </div>
  </main>
  <Footer />
</Layout>

<script is:inline>
  window.formspree = window.formspree || function () { (formspree.q = formspree.q || []).push(arguments); };
  formspree('initForm', { formElement: '#contact-form', formId: 'xvkpnbol' });
</script>
<script is:inline src="https://unpkg.com/@formspree/ajax@1" defer></script>

<style>
  /* Basic styles to handle Formspree classes if needed */
  div[data-fs-success="true"] { display: block !important; }
  div[data-fs-error="true"] { display: block !important; }
</style>
