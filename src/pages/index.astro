---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Calculator from '../components/Calculator.astro';
import HowToMeasure from '../components/HowToMeasure.astro';
import DoctorAdvice from '../components/DoctorAdvice.astro';
import FitGuide from '../components/FitGuide.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="Bra Size Calculator — Find Your Recommended Bra Size | BraSizeChecker"
  description="Calculate your recommended bra size in seconds with our free, private calculator. Includes sister sizes, US/UK/EU international size conversion charts, and fit guidance."
>
  <Header />
  
  <main class="flex-1 w-full flex flex-col items-center bg-canvas">
    <!-- Hero / Calculator Section -->
    <div class="relative w-full flex flex-col items-center pt-8 pb-8 overflow-hidden">
      <!-- Soft ambient rose background glow -->
      <div class="absolute inset-0 -z-10 opacity-40 blur-[120px] pointer-events-none flex justify-center">
        <div class="w-1/2 h-80 bg-accent/20 rounded-full translate-y-[-20%]"></div>
      </div>
      
      <Calculator />
    </div>

    <!-- How to Measure Guide -->
    <HowToMeasure />

    <!-- Fit & Health Advisory Card -->
    <DoctorAdvice />

    <!-- Comprehensive Fit Guide Accordion -->
    <FitGuide />

    <!-- Frequently Asked Questions -->
    <FAQ />
  </main>

  <Footer />
</Layout>
