---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Calculator from '../components/Calculator.astro';
import HowToMeasure from '../components/HowToMeasure.astro';
import DoctorAdvice from '../components/DoctorAdvice.astro';
import FitGuide from '../components/FitGuide.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Bra Size Calculator | Precision Fit in Minutes">
  <Header />
  
  <main class="flex-1 w-full flex flex-col items-center bg-canvas">
    <!-- Hero / Calculator Section -->
    <div class="relative w-full flex flex-col items-center pt-8 pb-8 overflow-hidden">
      <!-- Soft ambient rose background glow -->
      <div class="absolute inset-0 -z-10 opacity-40 blur-[120px] pointer-events-none flex justify-center">
        <div class="w-1/2 h-80 bg-accent/20 rounded-full translate-y-[-20%]"></div>
      </div>
      
      <Calculator />
    </div>

    <!-- Doctor Advice Feature -->
    <div class="w-full bg-canvas flex justify-center mb-8">
      <DoctorAdvice />
    </div>

    <!-- How To Measure -->
    <div class="w-full bg-canvas">
      <HowToMeasure />
    </div>

    <!-- Fit Diagnostic -->
    <div class="w-full bg-canvas">
      <FitGuide />
    </div>

    <!-- FAQ -->
    <div class="w-full bg-canvas">
      <FAQ />
    </div>
  </main>

  <Footer />
</Layout>
