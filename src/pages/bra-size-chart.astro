---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { BAND_CONVERSION_MATRIX, CUP_CONVERSION_MATRIX } from '../utils/braSizing';

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What does a visual bra size chart show?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A visual bra size chart demonstrates how breast tissue volume distributes across different band sizes. Because cup letters represent a ratio (bust circumference minus underbust circumference) rather than a fixed mass, a 30D appears much more compact than a 38D despite both sharing the same 'D' cup letter."
      }
    },
    {
      "@type": "Question",
      "name": "What do different cup sizes look like in real life?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "In reality, an A cup represents a 1-inch difference between underbust and bust (~100-180cc per breast), a B cup represents 2 inches (~200-320cc), a C cup represents 3 inches (~350-480cc), a D cup represents 4 inches (~500-680cc), and a DD/E represents 5 inches (~700-880cc). On a petite band (like 28 or 30), a D or DD looks moderate and compact rather than oversized."
      }
    },
    {
      "@type": "Question",
      "name": "Why does a 34D look smaller on some people and larger on others?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Breast appearance depends heavily on tissue projection, breast root width, and chest wall circumference. Projected breasts extend further forward from the chest and look larger, while shallow breasts spread tissue widely across the ribs and appear more subtle, even with identical 4-inch measurements."
      }
    },
    {
      "@type": "Question",
      "name": "How do sister sizes work visually?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sister sizes hold the exact same physical volume of breast tissue mounted on different ribcage circumferences. For example, a 30D, 32C, and 34B all contain approximately 390cc of tissue. The 30D concentrates this tissue on a narrow frame (looking fuller), whereas the 34B spreads it across a wider torso (looking shallower)."
      }
    },
    {
      "@type": "Question",
      "name": "How do I read the international conversion matrix?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Locate your snug underbust measurement on the Band Matrix row to see your equivalent band across US, UK, EU, FR, AU, JP, and IN. Next, find your bust-to-band difference on the Cup Matrix to determine your regional cup letter. Combine the two for your converted international size."
      }
    },
    {
      "@type": "Question",
      "name": "Are UK and US bra cup sizes the same?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "US and UK cup sizing are identical from A up to DD. Above DD, the systems diverge significantly. The UK uses double letters (DD, E, F, FF, G, GG, H), while US sizing skips double letters (DDD/F, G, H, I, J). A UK 32G equals a US 32I."
      }
    },
    {
      "@type": "Question",
      "name": "Why do Asian bra sizes use centimeter bands?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Asian sizing (Japan JIS L 4006 and South Korea KS K 9404) uses actual metric ribcage circumferences (65, 70, 75, 80cm) and 2.5cm cup steps, providing consistent and precise fit metrics compared to traditional imperial systems."
      }
    },
    {
      "@type": "Question",
      "name": "What are visual signs that my bra does not fit?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The four classic visual warning signs are: 1) The 'Quad-Boob' where tissue spills over cup rims; 2) The floating center gore that doesn't rest flat against the sternum; 3) The band riding upward toward shoulder blades; and 4) Underwires resting directly on breast tissue at the underarms."
      }
    },
    {
      "@type": "Question",
      "name": "How often should I re-measure my bra size?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We recommend checking your measurements every 6 months, or whenever you experience weight fluctuations, hormonal shifts, pregnancy, nursing, or changes in fitness routines. Ribcage dimensions and breast density naturally change over time."
      }
    },
    {
      "@type": "Question",
      "name": "Can breast shape make a bra cup gape even if the size is correct?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. If you have shallow or teardrop-shaped breasts and wear a stiff molded foam cup designed for projected tissue, empty space will appear at the top. Switching to an unlined, seamed balconette bra often solves gaping without changing size."
      }
    }
  ]
};
---

<Layout 
  title="Visual Bra Size Chart with Pictures & Real Cup Comparisons | BraSizeChecker"
  description="Comprehensive visual bra size chart with real cup comparisons, photo fit guides, sister size volume charts, and international conversion matrices (US, UK, EU, AU, JP)."
  canonical="https://brasizechecker.com/bra-size-chart/"
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <Header />
  <main class="flex-1 w-full max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 md:py-16">
    <Breadcrumbs items={[{ label: 'Bra Size Chart' }]} />

    <!-- Page Header / Intro -->
    <header class="mb-10 text-center sm:text-left">
      <span class="inline-block py-1 px-3 rounded-full bg-canvas-soft-2 border border-hairline text-xs font-semibold uppercase tracking-widest text-primary mb-3">
        Master Visual &amp; Conversion Matrix
      </span>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-ink tracking-tight mb-4">
        Visual Bra Size Chart with Pictures: Real Cup Size Comparisons &amp; International Matrix
      </h1>
      <div class="flex items-center gap-3 text-xs text-mute mb-4 justify-center sm:justify-start">
        <span>By BraSizeChecker Fit &amp; Research Team</span>
        <span>&bull;</span>
        <time datetime="2026-10-18">Updated October 2026</time>
        <span>&bull;</span>
        <span class="inline-flex items-center text-primary font-medium">
          <svg class="w-3.5 h-3.5 mr-1" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
          Medically &amp; Ergonomically Reviewed
        </span>
      </div>

      <p class="text-base sm:text-lg text-body leading-relaxed max-w-3xl mb-5">
        One of the most pervasive myths in intimate apparel is what specific bra sizes actually &ldquo;look&rdquo; like. Pop culture has conditioned society to believe that an A-cup is completely flat, a C-cup is average, and a DD-cup is enormous. In reality, human anatomy and garment engineering tell a completely different story.
      </p>
      <p class="text-base sm:text-lg text-body leading-relaxed max-w-3xl mb-5">
        Cup letters are <strong>dynamic ratios</strong>, not static volumes. A 28D and a 38D hold radically different amounts of breast tissue. Below, you will find our complete <strong>visual bra size chart with real cup comparisons</strong>, sister size volume physics, anatomical fit diagnostics, and the master international conversion matrix.
      </p>

      <!-- Primary Feature Hero Image -->
      <figure class="my-8 w-full rounded-2xl overflow-hidden border border-hairline shadow-sm bg-surface">
        <img 
          src="/img/bra-cup-fit-guide.jpg" 
          alt="Visual bra size chart with pictures showing realistic cup size comparisons and volume scaling" 
          class="w-full h-auto object-cover max-h-[460px]"
          loading="eager"
        />
        <figcaption class="p-3.5 bg-canvas-soft text-xs text-mute text-center border-t border-hairline">
          <strong>Figure 1.0:</strong> Visual representation of proportional cup volume distribution across standard band frames.
        </figcaption>
      </figure>

      <!-- Quick Jump Navigation Pill Bar -->
      <nav aria-label="Page sections" class="p-3.5 bg-canvas-soft rounded-2xl border border-hairline my-6">
        <p class="text-xs font-semibold text-ink uppercase tracking-wider mb-2">Jump to Section:</p>
        <div class="flex flex-wrap gap-2 text-xs">
          <a href="#visual-cup-guide" class="px-3 py-1.5 rounded-lg bg-surface border border-hairline text-ink hover:text-primary transition-colors font-medium">1. Real Cup Size Visuals</a>
          <a href="#cup-volume-matrix" class="px-3 py-1.5 rounded-lg bg-surface border border-hairline text-ink hover:text-primary transition-colors font-medium">2. Volume &amp; CC Chart</a>
          <a href="#interactive-matrix" class="px-3 py-1.5 rounded-lg bg-surface border border-hairline text-ink hover:text-primary transition-colors font-medium">3. International Matrices</a>
          <a href="#sister-size-volume" class="px-3 py-1.5 rounded-lg bg-surface border border-hairline text-ink hover:text-primary transition-colors font-medium">4. Sister Sizing Physics</a>
          <a href="#fit-diagnostics" class="px-3 py-1.5 rounded-lg bg-surface border border-hairline text-ink hover:text-primary transition-colors font-medium">5. Visual Fit Red Flags</a>
          <a href="#shape-guide" class="px-3 py-1.5 rounded-lg bg-surface border border-hairline text-ink hover:text-primary transition-colors font-medium">6. Breast Shape Guide</a>
          <a href="#faqs" class="px-3 py-1.5 rounded-lg bg-surface border border-hairline text-ink hover:text-primary transition-colors font-medium">7. FAQs</a>
        </div>
      </nav>
    </header>

    <!-- SECTION 1: Real Cup Size Visuals (A to K) -->
    <section id="visual-cup-guide" class="mb-12 space-y-6">
      <div class="border-b border-hairline pb-4">
        <h2 class="text-2xl sm:text-3xl font-bold text-ink tracking-tight">1. Real Cup Size Visuals: What Cups Actually Look Like</h2>
        <p class="text-sm sm:text-base text-body mt-2">
          Each cup letter simply represents an additional <strong>1-inch (2.54 cm) difference</strong> between your ribcage underbust and full bust circumference. Here is how that translates to real-world visual proportions:
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Petite to Moderate (AA - C) -->
        <div class="bg-surface border border-hairline rounded-2xl p-5 shadow-xs flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-bold uppercase tracking-wider text-primary px-2.5 py-1 rounded-md bg-primary/10">Tier 1</span>
              <span class="text-xs text-mute font-medium">1&quot; &ndash; 3&quot; Delta</span>
            </div>
            <h3 class="text-lg font-bold text-ink mb-2">Petite to Moderate: A, B &amp; C</h3>
            <p class="text-xs sm:text-sm text-body leading-relaxed mb-4">
              <strong>A Cup (~100-180cc):</strong> Subtle forward projection. On a 30A or 32A, breast tissue sits shallow against the pectoral wall. On a 38A, tissue spreads across a broader chest plate.<br/><br/>
              <strong>B Cup (~200-320cc):</strong> Moderate contour. A correctly fitted 30B is significantly smaller in overall mass than society imagines.<br/><br/>
              <strong>C Cup (~350-480cc):</strong> The classic 3-inch ratio. Often considered the baseline average, but looks completely different on a 30C vs a 36C.
            </p>
          </div>
          <div class="pt-3 border-t border-hairline text-[11px] text-mute">
            <strong>Key fit note:</strong> Many wearing 34B or 36A actually measure as 30D or 32C when properly fitted.
          </div>
        </div>

        <!-- Medium to Full (D - DDD/F) -->
        <div class="bg-surface border border-hairline rounded-2xl p-5 shadow-xs flex flex-col justify-between border-primary/30">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-bold uppercase tracking-wider text-primary px-2.5 py-1 rounded-md bg-primary/10">Tier 2</span>
              <span class="text-xs text-mute font-medium">4&quot; &ndash; 6&quot; Delta</span>
            </div>
            <h3 class="text-lg font-bold text-ink mb-2">Medium to Full: D, DD/E &amp; F</h3>
            <p class="text-xs sm:text-sm text-body leading-relaxed mb-4">
              <strong>D Cup (~500-680cc):</strong> Exactly a 4-inch bust difference. On a 28 or 30 band (28D, 30D), breasts appear compact, athletic, and perky. On a 38 band (38D), volume is visibly substantial.<br/><br/>
              <strong>DD / E Cup (~700-880cc):</strong> 5-inch projection. A 30DD is extremely common among slender women and does not look &ldquo;huge.&rdquo;<br/><br/>
              <strong>DDD / F Cup (~900-1,150cc):</strong> 6-inch projection. Often squeezed into 36DD due to mall store inventory limitations.
            </p>
          </div>
          <div class="pt-3 border-t border-hairline text-[11px] text-mute">
            <strong>Key fit note:</strong> DD is not an extreme size; it is simply a 5-inch projection from the ribcage.
          </div>
        </div>

        <!-- Fuller Bust & Extended Projection (FF, G, GG, H+) -->
        <div class="bg-surface border border-hairline rounded-2xl p-5 shadow-xs flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-bold uppercase tracking-wider text-primary px-2.5 py-1 rounded-md bg-primary/10">Tier 3</span>
              <span class="text-xs text-mute font-medium">7&quot; &ndash; 11&quot;+ Delta</span>
            </div>
            <h3 class="text-lg font-bold text-ink mb-2">Full Bust: FF, G, GG &amp; H+</h3>
            <p class="text-xs sm:text-sm text-body leading-relaxed mb-4">
              <strong>FF &amp; G Cups (~1,200-1,600cc):</strong> 8 to 9-inch projection. When supported by a firm, properly anchored band, tissue lifts cleanly off the ribcage, creating an hourglass silhouette.<br/><br/>
              <strong>GG &amp; H Cups (~1,700-2,100cc):</strong> 10 to 11-inch projection. Requires three-piece seamed cups and reinforced side support slings.<br/><br/>
              <strong>Beyond H (J, JJ, K+):</strong> High tissue mass requiring wide underwires to prevent side breast tissue pinching.
            </p>
          </div>
          <div class="pt-3 border-t border-hairline text-[11px] text-mute">
            <strong>Key fit note:</strong> In these sizes, 85%+ of breast weight MUST be borne by the band, not shoulder straps.
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 2: Cup Volume & CC Displacement Table -->
    <section id="cup-volume-matrix" class="mb-12 bg-surface border border-hairline rounded-2xl p-6 sm:p-8">
      <div class="mb-6">
        <h2 class="text-xl sm:text-2xl font-bold text-ink tracking-tight">2. Cup Volume &amp; Anatomical Displacement Matrix</h2>
        <p class="text-xs sm:text-sm text-body mt-1">
          Medical breast volume estimations in cubic centimeters (cc) and approximate tissue mass across standard band sizes:
        </p>
      </div>

      <div class="overflow-x-auto -mx-2 px-2 rounded-xl border border-hairline">
        <table class="w-full text-left text-xs sm:text-sm text-body border-collapse min-w-[640px]">
          <thead class="bg-canvas-soft-2 text-ink">
            <tr class="border-b border-hairline">
              <th scope="col" class="py-3 px-3.5 font-semibold">Cup Letter (US / UK)</th>
              <th scope="col" class="py-3 px-3.5 font-semibold">Bust Delta (Inches)</th>
              <th scope="col" class="py-3 px-3.5 font-semibold">Bust Delta (cm)</th>
              <th scope="col" class="py-3 px-3.5 font-semibold">Avg Volume per Breast (cc)</th>
              <th scope="col" class="py-3 px-3.5 font-semibold">Visual Profile</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-hairline bg-surface">
            <tr class="hover:bg-canvas-soft-2/50 transition-colors">
              <th scope="row" class="py-2.5 px-3.5 font-semibold text-ink">AA</th>
              <td class="py-2.5 px-3.5">&lt; 1&quot;</td>
              <td class="py-2.5 px-3.5">&lt; 2.5 cm</td>
              <td class="py-2.5 px-3.5">~50 &ndash; 90 cc</td>
              <td class="py-2.5 px-3.5">Very shallow, subtle contour</td>
            </tr>
            <tr class="hover:bg-canvas-soft-2/50 transition-colors">
              <th scope="row" class="py-2.5 px-3.5 font-semibold text-ink">A</th>
              <td class="py-2.5 px-3.5">1&quot;</td>
              <td class="py-2.5 px-3.5">2.5 cm</td>
              <td class="py-2.5 px-3.5">~100 &ndash; 180 cc</td>
              <td class="py-2.5 px-3.5">Shallow projection, broad root</td>
            </tr>
            <tr class="hover:bg-canvas-soft-2/50 transition-colors">
              <th scope="row" class="py-2.5 px-3.5 font-semibold text-ink">B</th>
              <td class="py-2.5 px-3.5">2&quot;</td>
              <td class="py-2.5 px-3.5">5.0 cm</td>
              <td class="py-2.5 px-3.5">~200 &ndash; 320 cc</td>
              <td class="py-2.5 px-3.5">Moderate natural curvature</td>
            </tr>
            <tr class="hover:bg-canvas-soft-2/50 transition-colors">
              <th scope="row" class="py-2.5 px-3.5 font-semibold text-ink">C</th>
              <td class="py-2.5 px-3.5">3&quot;</td>
              <td class="py-2.5 px-3.5">7.5 cm</td>
              <td class="py-2.5 px-3.5">~350 &ndash; 480 cc</td>
              <td class="py-2.5 px-3.5">Balanced forward projection</td>
            </tr>
            <tr class="hover:bg-canvas-soft-2/50 transition-colors">
              <th scope="row" class="py-2.5 px-3.5 font-semibold text-ink">D</th>
              <td class="py-2.5 px-3.5">4&quot;</td>
              <td class="py-2.5 px-3.5">10.0 cm</td>
              <td class="py-2.5 px-3.5">~500 &ndash; 680 cc</td>
              <td class="py-2.5 px-3.5">Clearly defined, projected</td>
            </tr>
            <tr class="hover:bg-canvas-soft-2/50 transition-colors">
              <th scope="row" class="py-2.5 px-3.5 font-semibold text-ink">DD / E</th>
              <td class="py-2.5 px-3.5">5&quot;</td>
              <td class="py-2.5 px-3.5">12.5 cm</td>
              <td class="py-2.5 px-3.5">~700 &ndash; 880 cc</td>
              <td class="py-2.5 px-3.5">Full silhouette, pronounced mass</td>
            </tr>
            <tr class="hover:bg-canvas-soft-2/50 transition-colors">
              <th scope="row" class="py-2.5 px-3.5 font-semibold text-ink">DDD / F (UK)</th>
              <td class="py-2.5 px-3.5">6&quot;</td>
              <td class="py-2.5 px-3.5">15.0 cm</td>
              <td class="py-2.5 px-3.5">~900 &ndash; 1,150 cc</td>
              <td class="py-2.5 px-3.5">Substantial projection, heavy root</td>
            </tr>
            <tr class="hover:bg-canvas-soft-2/50 transition-colors">
              <th scope="row" class="py-2.5 px-3.5 font-semibold text-ink">G / GG (UK)</th>
              <td class="py-2.5 px-3.5">8&quot; &ndash; 10&quot;</td>
              <td class="py-2.5 px-3.5">20.0 &ndash; 25.0 cm</td>
              <td class="py-2.5 px-3.5">~1,300 &ndash; 1,800 cc</td>
              <td class="py-2.5 px-3.5">Full figure, dense displacement</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- SECTION 3: Interactive International Conversion Matrices -->
    <section id="interactive-matrix" class="bg-surface border border-hairline rounded-2xl shadow-sm p-4 sm:p-6 md:p-8 mb-12" aria-labelledby="chart-heading">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6 pb-4 border-b border-hairline">
        <div>
          <h2 id="chart-heading" class="text-xl sm:text-2xl font-bold text-ink">3. International Size Conversion Matrices</h2>
          <p class="text-xs sm:text-sm text-body mt-1">Search or filter below to highlight equivalent band and cup sizes across 10 regions.</p>
        </div>

        <!-- Filter Input -->
        <div class="w-full md:w-64 flex-shrink-0">
          <label for="page-matrix-search" class="sr-only">Search size</label>
          <div class="relative">
            <input 
              type="text" 
              id="page-matrix-search" 
              placeholder="Search size (e.g. 34, DD, 75)..." 
              class="w-full h-10 px-3.5 pl-9 bg-canvas border border-hairline rounded-xl text-xs text-ink placeholder:text-mute/60 focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/20 transition-all duration-200"
            />
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-mute absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
          </div>
        </div>
      </div>

      <!-- Band Matrix Table -->
      <div class="mb-8">
        <h3 class="text-xs sm:text-sm font-bold text-primary uppercase tracking-wider mb-3 flex items-center justify-between">
          <span>Band Size Conversion Matrix</span>
          <span class="text-[11px] text-mute font-normal">US / UK / EU / FR / AU / JP / IN / HK / KR / SG</span>
        </h3>
        <div class="overflow-x-auto -mx-2 px-2 max-h-[380px] rounded-xl border border-hairline">
          <table class="w-full text-left text-xs sm:text-sm text-body min-w-[720px] border-collapse relative">
            <thead class="sticky top-0 bg-canvas-soft-2 text-ink shadow-2xs z-10">
              <tr class="border-b border-hairline">
                <th scope="col" class="py-3 px-3.5 font-semibold">US / CA</th>
                <th scope="col" class="py-3 px-3.5 font-semibold">UK</th>
                <th scope="col" class="py-3 px-3.5 font-semibold">EU</th>
                <th scope="col" class="py-3 px-3.5 font-semibold">FR / BE / ES</th>
                <th scope="col" class="py-3 px-3.5 font-semibold">AU / NZ</th>
                <th scope="col" class="py-3 px-3.5 font-semibold">JP</th>
                <th scope="col" class="py-3 px-3.5 font-semibold">India (IN)</th>
                <th scope="col" class="py-3 px-3.5 font-semibold">Hong Kong (HK)</th>
                <th scope="col" class="py-3 px-3.5 font-semibold">South Korea (KR)</th>
                <th scope="col" class="py-3 px-3.5 font-semibold">Singapore (SG)</th>
              </tr>
            </thead>
            <tbody id="page-band-matrix-body" class="divide-y divide-hairline bg-surface">
              {BAND_CONVERSION_MATRIX.map(row => (
                <tr class="transition-colors hover:bg-canvas-soft-2/50">
                  <th scope="row" class="py-3 px-3.5 font-semibold text-ink">{row.us}</th>
                  <td class="py-3 px-3.5">{row.uk}</td>
                  <td class="py-3 px-3.5">{row.eu}</td>
                  <td class="py-3 px-3.5">{row.fr}</td>
                  <td class="py-3 px-3.5">{row.au}</td>
                  <td class="py-3 px-3.5">{row.jp}</td>
                  <td class="py-3 px-3.5">{row.in}</td>
                  <td class="py-3 px-3.5">{row.hk}</td>
                  <td class="py-3 px-3.5">{row.kr}</td>
                  <td class="py-3 px-3.5">{row.sg}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <!-- Cup Matrix Table -->
      <div>
        <h3 class="text-xs sm:text-sm font-bold text-primary uppercase tracking-wider mb-3 flex items-center justify-between">
          <span>Cup Size Conversion Matrix</span>
          <span class="text-[11px] text-mute font-normal">US / UK / EU / AU / JP / IN / HK / KR / SG</span>
        </h3>
        <div class="overflow-x-auto -mx-2 px-2 max-h-[440px] rounded-xl border border-hairline">
