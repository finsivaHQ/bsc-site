---
---
<section id="calculator" class="py-8 sm:py-12 md:py-20 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto w-full">
  <!-- Hero / Header inside calculator area -->
  <div class="text-center mb-8 md:mb-12">
    <span class="inline-block py-1.5 px-4 rounded-full bg-canvas-soft-2 border border-hairline text-xs font-semibold uppercase tracking-widest text-primary mb-4 shadow-2xs">
      BRA SIZE CALCULATOR
    </span>
    <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold text-ink tracking-tight mb-4">
      Find Your Perfect Bra Size.
    </h1>
    <p class="text-sm sm:text-base md:text-lg text-body max-w-2xl mx-auto leading-relaxed mb-6">
      Enter your bust and underbust measurements to get your recommended starting size, sister sizes, and international equivalents.
    </p>

    <!-- Trust Row -->
    <div class="flex flex-wrap items-center justify-center gap-3 text-xs sm:text-sm font-medium text-mute">
      <span class="flex items-center gap-1.5">
        <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
        Free
      </span>
      <span class="text-hairline-strong">•</span>
      <span class="flex items-center gap-1.5">
        <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
        No signup
      </span>
      <span class="text-hairline-strong">•</span>
      <span class="flex items-center gap-1.5">
        <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
        Easy to use
      </span>
    </div>
  </div>

  <!-- Calculator Focal Card -->
  <div class="bg-surface border border-hairline rounded-2xl shadow-sm p-4 sm:p-6 md:p-10 mb-8 md:mb-12 transition-colors duration-300">
    <form id="calculator-form" action="#" onsubmit="event.preventDefault();">
      <!-- Header & Unit Toggle -->
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6 pb-4 border-b border-hairline">
        <h2 class="text-xl sm:text-2xl font-bold text-ink">Measurements</h2>
        <div class="flex bg-canvas-soft-2 rounded-xl p-1 border border-hairline w-full sm:w-auto">
          <button type="button" id="unit-in" class="unit-btn active flex-1 sm:flex-none h-11 px-4 py-2.5 text-sm font-semibold rounded-lg bg-primary text-on-primary shadow-xs transition-all duration-200 cursor-pointer">
            Inches (in)
          </button>
          <button type="button" id="unit-cm" class="unit-btn flex-1 sm:flex-none h-11 px-4 py-2.5 text-sm font-semibold rounded-lg text-body hover:text-ink transition-all duration-200 cursor-pointer">
            Centimeters (cm)
          </button>
        </div>
      </div>

      <!-- Privacy Trust Badge -->
      <div class="flex items-center gap-2 mb-6 bg-canvas-soft-2/80 border border-hairline py-2 px-3.5 rounded-xl w-full sm:w-fit text-xs text-body leading-snug">
        <span class="text-sm flex-shrink-0">🔒</span>
        <span><strong class="text-ink font-semibold">Your measurements stay private.</strong> Calculated locally in your browser and never stored.</span>
      </div>

      <!-- Accessible Inline Error Box -->
      <div id="calculator-error" class="hidden mb-6 p-4 rounded-xl bg-accent/15 border border-accent/40 text-ink text-sm font-medium flex items-center gap-3" role="alert" aria-live="polite">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-primary flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="8" x2="12" y2="12"></line>
          <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
        <span id="calculator-error-text">Please enter valid measurements.</span>
      </div>

      <!-- Inputs -->
      <div class="grid md:grid-cols-2 gap-6 sm:gap-8 mb-8">
        <div>
          <label for="overbust" class="block text-sm font-semibold text-ink mb-1.5">
            1. Bust Size
          </label>
          <p class="text-xs text-mute mb-3">Measure loosely around the fullest part of your bust.</p>
          <div class="relative">
            <input 
              type="number" 
              id="overbust" 
              inputmode="decimal"
              step="any"
              min="0"
              placeholder="e.g. 35" 
              class="w-full bg-surface border border-hairline rounded-xl h-13 px-4 pr-12 text-base text-ink placeholder:text-mute/60 focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/20 transition-all duration-200" 
            />
            <span class="absolute right-4 top-1/2 -translate-y-1/2 text-mute text-sm font-medium unit-label pointer-events-none">
              in
            </span>
          </div>
        </div>

        <div>
          <label for="underbust" class="block text-sm font-semibold text-ink mb-1.5">
            2. Band Size
          </label>
          <p class="text-xs text-mute mb-3">Measure snugly right under your breasts.</p>
          <div class="relative">
            <input 
              type="number" 
              id="underbust" 
              inputmode="decimal"
              step="any"
              min="0"
              placeholder="e.g. 32" 
              class="w-full bg-surface border border-hairline rounded-xl h-13 px-4 pr-12 text-base text-ink placeholder:text-mute/60 focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/20 transition-all duration-200" 
            />
            <span class="absolute right-4 top-1/2 -translate-y-1/2 text-mute text-sm font-medium unit-label pointer-events-none">
              in
            </span>
          </div>
        </div>
      </div>
    </form>

    <!-- Dynamic Result Area -->
    <div id="result-area" class="hidden bg-canvas-soft-2 border border-hairline rounded-xl p-4 sm:p-6 md:p-8 transition-all duration-300">
      <div class="text-center mb-8">
        <p class="text-xs text-primary font-bold uppercase tracking-widest mb-2">Your Recommended Size (US/CA)</p>
        <div id="main-size" class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold text-ink tracking-tight mb-2">34C</div>
        <p class="text-xs text-body">Based on standard sizing metrics</p>
      </div>

      <!-- Sister Sizes -->
      <div class="grid grid-cols-2 gap-3 sm:gap-4 mb-8 text-left">
        <div class="bg-surface border border-hairline rounded-xl p-3.5 sm:p-4 text-center shadow-xs">
          <p class="text-xs text-mute uppercase font-medium mb-1">Tighter Band</p>
          <div class="flex items-end justify-center gap-2">
            <span id="sister-tight" class="text-xl sm:text-2xl font-bold text-ink">32D</span>
          </div>
        </div>
        <div class="bg-surface border border-hairline rounded-xl p-3.5 sm:p-4 text-center shadow-xs">
          <p class="text-xs text-mute uppercase font-medium mb-1">Looser Band</p>
          <div class="flex items-end justify-center gap-2">
            <span id="sister-loose" class="text-xl sm:text-2xl font-bold text-ink">36B</span>
          </div>
        </div>
      </div>

      <!-- International Sizes Table -->
      <h3 class="text-base font-bold text-ink mb-4 border-b border-hairline pb-2">International Sizes</h3>
      <div class="overflow-x-auto -mx-2 px-2">
        <table class="w-full text-left border-collapse text-xs sm:text-sm text-body min-w-[280px]">
          <thead>
            <tr class="border-b border-hairline text-ink">
              <th class="py-2.5 font-semibold">Location</th>
              <th class="py-2.5 font-semibold">Band</th>
              <th class="py-2.5 font-semibold">Cup</th>
            </tr>
          </thead>
          <tbody id="intl-table-body">
            <!-- Populated dynamically via JS -->
          </tbody>
        </table>
      </div>
      <p class="text-xs text-mute mt-4 leading-relaxed">
        * Your recommended size is calculated from your underbust and bust measurements using standard international sizing matrices. Because bra sizing can vary between brands and styles, this result should be treated as a starting size.
      </p>
    </div>
  </div>

  <!-- Bra Size Converter Chart Card -->
  <div class="bg-surface border border-hairline rounded-2xl shadow-sm p-4 sm:p-6 md:p-10 transition-colors duration-300">
    <h2 class="text-xl sm:text-2xl font-bold text-ink mb-6 border-b border-hairline pb-4">Bra Size Converter Chart</h2>
    
    <h3 class="text-xs sm:text-sm font-bold text-primary uppercase tracking-wider mb-3">Band Conversion Matrix</h3>
    <div class="overflow-x-auto mb-8 -mx-2 px-2">
      <table class="w-full text-left text-xs sm:text-sm text-body min-w-[500px] border-collapse">
        <thead>
          <tr class="bg-canvas-soft-2 text-ink border-b border-hairline">
            <th class="py-3 px-3 font-semibold rounded-tl-lg">US/CA</th>
            <th class="py-3 px-3 font-semibold">UK</th>
            <th class="py-3 px-3 font-semibold">EU</th>
            <th class="py-3 px-3 font-semibold">FR/BE/ES</th>
            <th class="py-3 px-3 font-semibold">AU/NZ</th>
            <th class="py-3 px-3 font-semibold rounded-tr-lg">JP</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-hairline">
          <tr class="hover:bg-canvas-soft-2/50 transition-colors"><td class="py-2.5 px-3 font-semibold text-ink">30</td><td class="py-2.5 px-3">30</td><td class="py-2.5 px-3">65</td><td class="py-2.5 px-3">80</td><td class="py-2.5 px-3">8</td><td class="py-2.5 px-3">65</td></tr>
          <tr class="hover:bg-canvas-soft-2/50 transition-colors"><td class="py-2.5 px-3 font-semibold text-ink">32</td><td class="py-2.5 px-3">32</td><td class="py-2.5 px-3">70</td><td class="py-2.5 px-3">85</td><td class="py-2.5 px-3">10</td><td class="py-2.5 px-3">70</td></tr>
          <tr class="hover:bg-canvas-soft-2/50 transition-colors"><td class="py-2.5 px-3 font-semibold text-ink">34</td><td class="py-2.5 px-3">34</td><td class="py-2.5 px-3">75</td><td class="py-2.5 px-3">90</td><td class="py-2.5 px-3">12</td><td class="py-2.5 px-3">75</td></tr>
          <tr class="hover:bg-canvas-soft-2/50 transition-colors"><td class="py-2.5 px-3 font-semibold text-ink">36</td><td class="py-2.5 px-3">36</td><td class="py-2.5 px-3">80</td><td class="py-2.5 px-3">95</td><td class="py-2.5 px-3">14</td><td class="py-2.5 px-3">80</td></tr>
          <tr class="hover:bg-canvas-soft-2/50 transition-colors"><td class="py-2.5 px-3 font-semibold text-ink">38</td><td class="py-2.5 px-3">38</td><td class="py-2.5 px-3">85</td><td class="py-2.5 px-3">100</td><td class="py-2.5 px-3">16</td><td class="py-2.5 px-3">85</td></tr>
          <tr class="hover:bg-canvas-soft-2/50 transition-colors"><td class="py-2.5 px-3 font-semibold text-ink">40</td><td class="py-2.5 px-3">40</td><td class="py-2.5 px-3">90</td><td class="py-2.5 px-3">105</td><td class="py-2.5 px-3">18</td><td class="py-2.5 px-3">90</td></tr>
        </tbody>
      </table>
    </div>

    <h3 class="text-xs sm:text-sm font-bold text-primary uppercase tracking-wider mb-3">Cup Size Matrix</h3>
    <div class="overflow-x-auto -mx-2 px-2">
      <table class="w-full text-left text-xs sm:text-sm text-body min-w-[500px] border-collapse">
        <thead>
          <tr class="bg-canvas-soft-2 text-ink border-b border-hairline">
            <th class="py-3 px-3 font-semibold rounded-tl-lg">US/CA</th>
            <th class="py-3 px-3 font-semibold">UK</th>
            <th class="py-3 px-3 font-semibold">EU</th>
            <th class="py-3 px-3 font-semibold">AU/NZ</th>
            <th class="py-3 px-3 font-semibold rounded-tr-lg">JP</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-hairline">
          <tr class="hover:bg-canvas-soft-2/50 transition-colors"><td class="py-2.5 px-3 font-semibold text-ink">A</td><td class="py-2.5 px-3">A</td><td class="py-2.5 px-3">A</td><td class="py-2.5 px-3">A</td><td class="py-2.5 px-3">A</td></tr>
          <tr class="hover:bg-canvas-soft-2/50 transition-colors"><td class="py-2.5 px-3 font-semibold text-ink">B</td><td class="py-2.5 px-3">B</td><td class="py-2.5 px-3">B</td><td class="py-2.5 px-3">B</td><td class="py-2.5 px-3">B</td></tr>
          <tr class="hover:bg-canvas-soft-2/50 transition-colors"><td class="py-2.5 px-3 font-semibold text-ink">C</td><td class="py-2.5 px-3">C</td><td class="py-2.5 px-3">C</td><td class="py-2.5 px-3">C</td><td class="py-2.5 px-3">C</td></tr>
          <tr class="hover:bg-canvas-soft-2/50 transition-colors"><td class="py-2.5 px-3 font-semibold text-ink">D</td><td class="py-2.5 px-3">D</td><td class="py-2.5 px-3">D</td><td class="py-2.5 px-3">D</td><td class="py-2.5 px-3">D</td></tr>
          <tr class="hover:bg-canvas-soft-2/50 transition-colors"><td class="py-2.5 px-3 font-semibold text-ink">DD / E</td><td class="py-2.5 px-3">DD</td><td class="py-2.5 px-3">E</td><td class="py-2.5 px-3">DD</td><td class="py-2.5 px-3">E</td></tr>
          <tr class="hover:bg-canvas-soft-2/50 transition-colors"><td class="py-2.5 px-3 font-semibold text-ink">DDD / F</td><td class="py-2.5 px-3">E</td><td class="py-2.5 px-3">F</td><td class="py-2.5 px-3">E</td><td class="py-2.5 px-3">F</td></tr>
          <tr class="hover:bg-canvas-soft-2/50 transition-colors"><td class="py-2.5 px-3 font-semibold text-ink">G</td><td class="py-2.5 px-3">F</td><td class="py-2.5 px-3">G</td><td class="py-2.5 px-3">F</td><td class="py-2.5 px-3">G</td></tr>
          <tr class="hover:bg-canvas-soft-2/50 transition-colors"><td class="py-2.5 px-3 font-semibold text-ink">H</td><td class="py-2.5 px-3">FF</td><td class="py-2.5 px-3">H</td><td class="py-2.5 px-3">FF</td><td class="py-2.5 px-3">H</td></tr>
          <tr class="hover:bg-canvas-soft-2/50 transition-colors"><td class="py-2.5 px-3 font-semibold text-ink">I</td><td class="py-2.5 px-3">G</td><td class="py-2.5 px-3">I</td><td class="py-2.5 px-3">G</td><td class="py-2.5 px-3">I</td></tr>
          <tr class="hover:bg-canvas-soft-2/50 transition-colors"><td class="py-2.5 px-3 font-semibold text-ink">J</td><td class="py-2.5 px-3">GG</td><td class="py-2.5 px-3">J</td><td class="py-2.5 px-3">GG</td><td class="py-2.5 px-3">J</td></tr>
        </tbody>
      </table>
    </div>
    <p class="text-xs text-mute mt-4 leading-relaxed">
      * Bra sizing conventions vary between brands and regions. These conversions are intended as a general sizing reference.
    </p>
  </div>
</section>

<script>
  import { validateAndCalculateBraSize } from '../utils/braSizing';

  // DOM Elements
  const unitInBtn = document.getElementById('unit-in');
  const unitCmBtn = document.getElementById('unit-cm');
  const unitLabels = document.querySelectorAll('.unit-label');
  const underbustInput = document.getElementById('underbust') as HTMLInputElement;
  const overbustInput = document.getElementById('overbust') as HTMLInputElement;
  const resultArea = document.getElementById('result-area');
  const errorBox = document.getElementById('calculator-error');
  const errorText = document.getElementById('calculator-error-text');
  const mainSizeEl = document.getElementById('main-size');
  const sisterTightEl = document.getElementById('sister-tight');
  const sisterLooseEl = document.getElementById('sister-loose');
  const intlTableBody = document.getElementById('intl-table-body');

  let currentUnit: 'in' | 'cm' = 'in';

  const showError = (msg: string, field?: 'underbust' | 'overbust' | 'both') => {
    resultArea?.classList.add('hidden');
    if (errorBox && errorText) {
      errorText.textContent = msg;
      errorBox.classList.remove('hidden');
    }
    if (field === 'underbust' || field === 'both') {
      underbustInput?.setAttribute('aria-invalid', 'true');
    } else {
      underbustInput?.removeAttribute('aria-invalid');
    }
    if (field === 'overbust' || field === 'both') {
      overbustInput?.setAttribute('aria-invalid', 'true');
    } else {
      overbustInput?.removeAttribute('aria-invalid');
    }
  };

  const clearError = () => {
    if (errorBox) errorBox.classList.add('hidden');
    underbustInput?.removeAttribute('aria-invalid');
    overbustInput?.removeAttribute('aria-invalid');
  };

  // Toggle Units
  const setUnit = (unit: 'in' | 'cm') => {
    if (unit === currentUnit) return;
    
    // Convert values if present
    if (underbustInput.value) {
      const uVal = parseFloat(underbustInput.value);
      if (!isNaN(uVal) && uVal > 0) {
        underbustInput.value = unit === 'cm' 
          ? (uVal * 2.54).toFixed(1)
          : (uVal / 2.54).toFixed(1);
      }
    }
    if (overbustInput.value) {
      const oVal = parseFloat(overbustInput.value);
      if (!isNaN(oVal) && oVal > 0) {
        overbustInput.value = unit === 'cm' 
          ? (oVal * 2.54).toFixed(1)
          : (oVal / 2.54).toFixed(1);
      }
    }

    currentUnit = unit;
    
    if (unit === 'in') {
      unitInBtn?.classList.add('bg-primary', 'text-on-primary', 'shadow-xs');
      unitInBtn?.classList.remove('text-body', 'hover:text-ink');
      unitCmBtn?.classList.remove('bg-primary', 'text-on-primary', 'shadow-xs');
      unitCmBtn?.classList.add('text-body', 'hover:text-ink');
      unitLabels.forEach(el => el.textContent = 'in');
      underbustInput.placeholder = 'e.g. 32';
      overbustInput.placeholder = 'e.g. 35';
    } else {
      unitCmBtn?.classList.add('bg-primary', 'text-on-primary', 'shadow-xs');
      unitCmBtn?.classList.remove('text-body', 'hover:text-ink');
      unitInBtn?.classList.remove('bg-primary', 'text-on-primary', 'shadow-xs');
      unitInBtn?.classList.add('text-body', 'hover:text-ink');
      unitLabels.forEach(el => el.textContent = 'cm');
      underbustInput.placeholder = 'e.g. 80';
      overbustInput.placeholder = 'e.g. 90';
    }
    calculateSize();
  };

  unitInBtn?.addEventListener('click', () => setUnit('in'));
  unitCmBtn?.addEventListener('click', () => setUnit('cm'));
  
  const calculateSize = () => {
    const uRaw = underbustInput.value.trim();
    const oRaw = overbustInput.value.trim();

    if (!uRaw && !oRaw) {
      clearError();
      resultArea?.classList.add('hidden');
      return;
    }

    if (!oRaw) {
      showError('Please enter your bust measurement.', 'overbust');
      return;
    }

    if (!uRaw) {
      showError('Please enter your band measurement.', 'underbust');
      return;
    }

    const u = parseFloat(uRaw);
    const o = parseFloat(oRaw);

    const validation = validateAndCalculateBraSize({
      underbust: u,
      overbust: o,
      unit: currentUnit
    });

    if (!validation.isValid || !validation.result) {
      showError(validation.error || 'Please enter valid measurements.', validation.fieldWithError);
      return;
    }

    clearError();
    const result = validation.result;

    // Update DOM
    if (mainSizeEl) mainSizeEl.textContent = result.primarySize;
    if (sisterTightEl) sisterTightEl.textContent = result.sisterTight;
    if (sisterLooseEl) sisterLooseEl.textContent = result.sisterLoose;

    // Build Table
    if (intlTableBody) {
      intlTableBody.innerHTML = result.internationalSizes.map(item => `
        <tr class="border-b border-hairline hover:bg-surface/70 transition-colors">
          <td class="py-2.5 ${item.isSecondary ? 'text-mute font-normal' : 'font-medium text-ink'}">${item.location}</td>
          <td class="py-2.5 ${item.isSecondary ? 'text-mute font-medium' : 'font-semibold text-ink'}">${item.band}</td>
          <td class="py-2.5 ${item.isSecondary ? 'text-mute font-medium' : 'font-semibold text-primary'}">${item.cup}</td>
        </tr>
      `).join('');
    }

    resultArea?.classList.remove('hidden');
  };

  underbustInput?.addEventListener('input', calculateSize);
  overbustInput?.addEventListener('input', calculateSize);
</script>
