---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="500: Server Error | Bra Size Calculator">
  <Header />
  <main class="flex-1 w-full max-w-3xl mx-auto px-6 py-24 text-center">
    <h1 class="text-6xl font-bold text-ink mb-4">500</h1>
    <h2 class="text-2xl font-semibold text-ink mb-6">Internal Server Error</h2>
    <p class="text-body mb-8">
      Something went wrong on our end. We're looking into it.
    </p>
    <a href="/" class="inline-block px-8 py-3 bg-primary text-on-primary font-medium rounded-full hover:bg-primary/90 transition-colors">
      Return Home
    </a>
  </main>
  <Footer />
</Layout>
