---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Calculator from '../components/Calculator.astro';
import HowToMeasure from '../components/HowToMeasure.astro';
import DoctorAdvice from '../components/DoctorAdvice.astro';
import FitGuide from '../components/FitGuide.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Bra Size Calculator | Precision Fit in Minutes">
  <Header />
  
  <main class="flex-1 w-full flex flex-col items-center">
    <!-- Hero / Calculator Section -->
    <div class="relative w-full flex flex-col items-center pt-12 pb-8 overflow-hidden">
      <!-- Vercel-style mesh gradient background (subtle) -->
      <div class="absolute inset-0 -z-10 opacity-30 blur-[100px] pointer-events-none flex justify-center">
        <div class="w-1/3 h-64 bg-primary/40 rounded-full mix-blend-multiply translate-x-1/2"></div>
        <div class="w-1/3 h-64 bg-link/30 rounded-full mix-blend-multiply -translate-x-1/2"></div>
        <div class="w-1/3 h-64 bg-success/20 rounded-full mix-blend-multiply translate-y-1/2"></div>
      </div>
      
      <Calculator />
    </div>

    <!-- Doctor Advice Feature -->
    <div class="w-full bg-canvas-soft flex justify-center mb-16">
      <DoctorAdvice />
    </div>

    <!-- How To Measure -->
    <div class="w-full bg-canvas-soft-2">
      <HowToMeasure />
    </div>

    <!-- Fit Diagnostic -->
    <div class="w-full bg-canvas-soft">
      <FitGuide />
    </div>

    <!-- FAQ -->
    <div class="w-full bg-canvas-soft-2">
      <FAQ />
    </div>
  </main>

  <Footer />
</Layout>
