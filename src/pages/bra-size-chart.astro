---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { BAND_CONVERSION_MATRIX, CUP_CONVERSION_MATRIX } from '../utils/braSizing';

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How do I read an international bra size chart?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Locate your snug underbust measurement in either inches or centimeters on the band matrix row. This reveals your equivalent band size across regions (e.g. 34 in US/UK = 75 in EU = 90 in FR = 12 in AU). Next, locate your bust-to-band delta in the cup matrix to find your regional cup letter."
      }
    },
    {
      "@type": "Question",
      "name": "Why do Asian bra sizes (Japan, Hong Kong, Korea, Singapore) use metric band numbers?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Asian bra sizing systems (such as Japan JIS L 4006 and South Korea KS K 9404) follow metric EN 13402 specifications, using underbust centimeters for band numbers (65, 70, 75, 80) and 2.5 cm cup delta increments."
      }
    }
  ]
};
---

<Layout 
  title="Bra Size Chart — US, UK, EU, AU, JP, IN, HK, South Korea, SG & International Conversion Guide | BraSizeChecker"
  description="Comprehensive international bra size chart. Compare US, UK, EU, FR, AU, JP, IN, HK, South Korea, and Singapore band and cup sizes."
  canonical="https://brasizechecker.com/bra-size-chart"
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <Header />
  <main class="flex-1 w-full max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 md:py-16">
    <Breadcrumbs items={[{ label: 'Bra Size Chart' }]} />

    <!-- Page Header / Intro -->
    <header class="mb-10 text-center sm:text-left">
      <span class="inline-block py-1 px-3 rounded-full bg-canvas-soft-2 border border-hairline text-xs font-semibold uppercase tracking-widest text-primary mb-3">
        Master Reference Guide
      </span>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-ink tracking-tight mb-4">
        Master Bra Size Chart: US, UK, EU, AU, JP, IN & International Matrix
      </h1>
      <div class="flex items-center gap-3 text-xs text-mute mb-4">
        <span>By BraSizeChecker Anthropometric Lab</span>
        <span>&bull;</span>
        <time datetime="2026-09-04">Updated September 2026</time>
      </div>
      <p class="text-base sm:text-lg text-body leading-relaxed max-w-3xl">
        Navigating international bra sizing standards across different regions and manufacturers can be daunting. Every bra size consists of a <strong>band number</strong> (representing ribcage circumference) and a <strong>cup letter</strong> (representing cup volume displacement). Use our master chart below to cross-reference sizes across 10 global regions.
      </p>
    </header>

    <!-- Interactive Conversion Chart Tool -->
    <section class="bg-surface border border-hairline rounded-2xl shadow-sm p-4 sm:p-6 md:p-8 mb-12" aria-labelledby="chart-heading">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6 pb-4 border-b border-hairline">
        <div>
          <h2 id="chart-heading" class="text-xl sm:text-2xl font-bold text-ink">International Size Conversion Matrices</h2>
          <p class="text-xs sm:text-sm text-body mt-1">Search or filter below to highlight equivalent band and cup sizes across regions.</p>
        </div>

        <!-- Filter Input -->
        <div class="w-full md:w-64 flex-shrink-0">
          <label for="page-matrix-search" class="sr-only">Search size</label>
          <div class="relative">
            <input 
              type="text" 
              id="page-matrix-search" 
              placeholder="Search size (e.g. 34, DD, 75)..." 
              class="w-full h-10 px-3.5 pl-9 bg-canvas border border-hairline rounded-xl text-xs text-ink placeholder:text-mute/60 focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/20 transition-all duration-200"
            />
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-mute absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
          </div>
        </div>
      </div>

      <!-- Band Matrix Table -->
      <div class="mb-8">
        <h3 class="text-xs sm:text-sm font-bold text-primary uppercase tracking-wider mb-3 flex items-center justify-between">
          <span>Band Size Conversion Matrix</span>
          <span class="text-[11px] text-mute font-normal">US / UK / EU / FR / AU / JP / IN / HK / KR / SG</span>
        </h3>
        <div class="overflow-x-auto -mx-2 px-2 max-h-[380px] rounded-xl border border-hairline">
          <table class="w-full text-left text-xs sm:text-sm text-body min-w-[720px] border-collapse relative">
            <thead class="sticky top-0 bg-canvas-soft-2 text-ink shadow-2xs z-10">
              <tr class="border-b border-hairline">
                <th scope="col" class="py-3 px-3.5 font-semibold">US / CA</th>
                <th scope="col" class="py-3 px-3.5 font-semibold">UK</th>
                <th scope="col" class="py-3 px-3.5 font-semibold">EU</th>
                <th scope="col" class="py-3 px-3.5 font-semibold">FR / BE / ES</th>
                <th scope="col" class="py-3 px-3.5 font-semibold">AU / NZ</th>
                <th scope="col" class="py-3 px-3.5 font-semibold">JP</th>
                <th scope="col" class="py-3 px-3.5 font-semibold">India (IN)</th>
                <th scope="col" class="py-3 px-3.5 font-semibold">Hong Kong (HK)</th>
                <th scope="col" class="py-3 px-3.5 font-semibold">South Korea (KR)</th>
                <th scope="col" class="py-3 px-3.5 font-semibold">Singapore (SG)</th>
              </tr>
            </thead>
            <tbody id="page-band-matrix-body" class="divide-y divide-hairline bg-surface">
              {BAND_CONVERSION_MATRIX.map(row => (
                <tr class="transition-colors hover:bg-canvas-soft-2/50">
                  <th scope="row" class="py-3 px-3.5 font-semibold text-ink">{row.us}</th>
                  <td class="py-3 px-3.5">{row.uk}</td>
                  <td class="py-3 px-3.5">{row.eu}</td>
                  <td class="py-3 px-3.5">{row.fr}</td>
                  <td class="py-3 px-3.5">{row.au}</td>
                  <td class="py-3 px-3.5">{row.jp}</td>
                  <td class="py-3 px-3.5">{row.in}</td>
                  <td class="py-3 px-3.5">{row.hk}</td>
                  <td class="py-3 px-3.5">{row.kr}</td>
                  <td class="py-3 px-3.5">{row.sg}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <!-- Cup Matrix Table -->
      <div>
        <h3 class="text-xs sm:text-sm font-bold text-primary uppercase tracking-wider mb-3 flex items-center justify-between">
          <span>Cup Size Conversion Matrix</span>
          <span class="text-[11px] text-mute font-normal">US / UK / EU / AU / JP / IN / HK / KR / SG</span>
        </h3>
        <div class="overflow-x-auto -mx-2 px-2 max-h-[440px] rounded-xl border border-hairline">
          <table class="w-full text-left text-xs sm:text-sm text-body min-w-[720px] border-collapse relative">
            <thead class="sticky top-0 bg-canvas-soft-2 text-ink shadow-2xs z-10">
              <tr class="border-b border-hairline">
                <th scope="col" class="py-3 px-3.5 font-semibold">US / CA</th>
                <th scope="col" class="py-3 px-3.5 font-semibold">UK</th>
                <th scope="col" class="py-3 px-3.5 font-semibold">EU</th>
                <th scope="col" class="py-3 px-3.5 font-semibold">AU / NZ</th>
                <th scope="col" class="py-3 px-3.5 font-semibold">JP</th>
                <th scope="col" class="py-3 px-3.5 font-semibold">India (IN)</th>
                <th scope="col" class="py-3 px-3.5 font-semibold">Hong Kong (HK)</th>
                <th scope="col" class="py-3 px-3.5 font-semibold">South Korea (KR)</th>
                <th scope="col" class="py-3 px-3.5 font-semibold">Singapore (SG)</th>
              </tr>
            </thead>
            <tbody id="page-cup-matrix-body" class="divide-y divide-hairline bg-surface">
              {CUP_CONVERSION_MATRIX.map(row => (
                <tr class="transition-colors hover:bg-canvas-soft-2/50">
                  <th scope="row" class="py-3 px-3.5 font-semibold text-ink">{row.us}</th>
                  <td class="py-3 px-3.5">{row.uk}</td>
                  <td class="py-3 px-3.5">{row.eu}</td>
                  <td class="py-3 px-3.5">{row.au}</td>
                  <td class="py-3 px-3.5">{row.jp}</td>
                  <td class="py-3 px-3.5">{row.in}</td>
                  <td class="py-3 px-3.5">{row.hk}</td>
                  <td class="py-3 px-3.5">{row.kr}</td>
                  <td class="py-3 px-3.5">{row.sg}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Educational Sections -->
    <div class="space-y-10 text-body leading-relaxed text-sm sm:text-base">
      <!-- Section 1: How to Measure & Read Chart -->
      <section class="bg-surface border border-hairline rounded-2xl p-6 sm:p-8">
        <h2 class="text-xl sm:text-2xl font-bold text-ink mb-4">1. How to Read & Use This Master Chart</h2>
        <p class="mb-4">
          Follow these 3 simple steps to find your exact size in any international brand:
        </p>

        <ol class="list-decimal pl-5 space-y-2 text-xs sm:text-sm mb-6">
          <li><strong>Find Your Band Row:</strong> Locate your snug underbust measurement in either inches or centimeters on the Band Size Conversion Matrix above.</li>
          <li><strong>Find Your Cup Column:</strong> Locate your calculated bust-to-band delta in the Cup Size Conversion Matrix to identify your regional letter.</li>
          <li><strong>Cross-Reference Destination Region:</strong> Read horizontally across the row to find your target country's equivalent size tag.</li>
        </ol>
      </section>

      <!-- Section 2: Related Tools -->
      <section class="bg-surface border border-hairline rounded-2xl p-6 sm:p-8">
        <h2 class="text-xl sm:text-2xl font-bold text-ink mb-4">2. Interactive Tools & Calculators</h2>
        <div class="flex flex-wrap gap-3">
          <a href="/#calculator" class="px-5 py-2.5 bg-primary text-white font-bold text-xs rounded-xl hover:bg-primary-hover transition-colors shadow-2xs">
            Primary Calculator Tool &rarr;
          </a>
          <a href="/bra-size-converter" class="px-5 py-2.5 bg-surface border border-hairline text-ink font-semibold text-xs rounded-xl hover:bg-canvas-soft-2 transition-colors shadow-2xs">
            Bra Size Converter &rarr;
          </a>
          <a href="/sister-size-calculator" class="px-5 py-2.5 bg-surface border border-hairline text-ink font-semibold text-xs rounded-xl hover:bg-canvas-soft-2 transition-colors shadow-2xs">
            Sister Size Matrix &rarr;
          </a>
        </div>
      </section>

      <!-- Section 3: FAQ Section -->
      <section class="bg-surface border border-hairline rounded-2xl p-6 sm:p-8">
        <h2 class="text-xl sm:text-2xl font-bold text-ink mb-6">Frequently Asked Questions</h2>
        <div class="space-y-4">
          {faqSchema.mainEntity.map(item => (
            <details class="bg-canvas border border-hairline rounded-xl p-5 cursor-pointer group">
              <summary class="font-bold text-ink flex justify-between items-center list-none">
                <span>{item.name}</span>
                <span class="text-primary group-open:rotate-180 transition-transform">&darr;</span>
              </summary>
              <p class="mt-4 text-body text-xs sm:text-sm leading-relaxed">{item.acceptedAnswer.text}</p>
            </details>
          ))}
        </div>
      </section>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener('astro:page-load', () => {
    const searchInput = document.getElementById('page-matrix-search') as HTMLInputElement;
    const bandRows = document.querySelectorAll('#page-band-matrix-body tr');
    const cupRows = document.querySelectorAll('#page-cup-matrix-body tr');

    if (searchInput) {
      searchInput.addEventListener('input', () => {
        const query = searchInput.value.trim().toLowerCase();

        function filterRows(rows: NodeListOf<Element>) {
          rows.forEach(row => {
            const text = row.textContent?.toLowerCase() || '';
            if (!query || text.includes(query)) {
              (row as HTMLElement).style.display = '';
              if (query && text.includes(query)) {
                (row as HTMLElement).classList.add('bg-accent/15');
              } else {
                (row as HTMLElement).classList.remove('bg-accent/15');
              }
            } else {
              (row as HTMLElement).style.display = 'none';
            }
          });
        }

        filterRows(bandRows);
        filterRows(cupRows);
      });
    }
  });
</script>
