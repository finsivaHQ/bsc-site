---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="500: Server Error | Bra Size Calculator">
  <Header />
  <main class="flex-1 w-full max-w-3xl mx-auto px-6 py-24 text-center">
    <span class="inline-block py-1.5 px-4 rounded-full bg-canvas-soft-2 border border-hairline text-xs font-semibold uppercase tracking-widest text-primary mb-4">
      Error 500
    </span>
    <h1 class="text-6xl font-bold text-ink mb-4">Server Error</h1>
    <p class="text-body text-base max-w-md mx-auto mb-8 leading-relaxed">
      Something went wrong on our end. Please try again in a few moments.
    </p>
    <a href="/" class="inline-block px-8 py-3.5 bg-primary text-white font-semibold rounded-xl hover:bg-primary-hover transition-colors shadow-xs">
      Return Home
    </a>
  </main>
  <Footer />
</Layout>
