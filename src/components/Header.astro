---
---
<header class="sticky top-0 z-50 bg-canvas/80 backdrop-blur-md border-b border-hairline h-16 flex items-center justify-between px-6 lg:px-8">
  <div class="flex items-center gap-2">
    <a href="/" class="text-ink font-semibold text-lg tracking-tight hover:opacity-80 transition-opacity">
      BraSize<span class="text-mute">Checker</span>
    </a>
  </div>
  <nav class="hidden md:flex items-center gap-6">
    <a href="#calculator" class="text-sm text-body hover:text-ink transition-colors font-medium">Calculator</a>
    <a href="#how-to-measure" class="text-sm text-body hover:text-ink transition-colors font-medium">How to Measure</a>
    <a href="#fit-guide" class="text-sm text-body hover:text-ink transition-colors font-medium">Fit Guide</a>
  </nav>
  <div class="flex items-center gap-3">
    <button id="theme-toggle" class="w-8 h-8 rounded-full border border-hairline flex items-center justify-center text-ink hover:bg-canvas-soft transition-colors" aria-label="Toggle Theme">
      <!-- Sun icon for light mode (hidden in dark) -->
      <svg id="theme-icon-light" class="hidden dark:block" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M1 12h2M21 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4"/></svg>
      <!-- Moon icon for dark mode (hidden in light) -->
      <svg id="theme-icon-dark" class="block dark:hidden" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
    </button>
  </div>
</header>

<script is:inline>
  const themeToggleBtn = document.getElementById('theme-toggle');

  // We set the initial theme in Layout.astro to prevent Flash Of Unstyled Content
  // Here we just handle the toggle click
  themeToggleBtn?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.contains('dark');
    if (isDark) {
      document.documentElement.classList.remove('dark');
      localStorage.setItem('theme', 'light');
    } else {
      document.documentElement.classList.add('dark');
      localStorage.setItem('theme', 'dark');
    }
  });
</script>
